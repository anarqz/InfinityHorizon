<Window x:Class="Infinity.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Infinity.App"
        Title="Infinity Horizon · BETA" Width="1180" Height="780" MinWidth="960" MinHeight="640"
        Icon="pack://application:,,,/Assets/infinity.ico"
        WindowStartupLocation="CenterScreen" Background="{StaticResource InfinityBackground}"
        Foreground="{StaticResource InfinityText}" FontFamily="{StaticResource InfinityFont}" FontSize="14">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:InverseVisibility x:Key="Hidden" />
    <Style x:Key="ModCardButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource InfinitySurfaceHigh}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- SAVE_MANAGER_UX (OD-207, OD-214): the save manager's look, after the owner's prototype: dark cards, HARDCORE orange, NOOB green,
         Azimuth blue, plain chips, large choices. The accent of a button is its Background (bound per card). -->
    <SolidColorBrush x:Key="SmCardSurface" Color="#FF140A1E" />
    <SolidColorBrush x:Key="SmCardRaised" Color="#FF1E1029" />
    <SolidColorBrush x:Key="SmLine" Color="#24F9EAEE" />
    <SolidColorBrush x:Key="SmMenuSurface" Color="#FF241433" />
    <SolidColorBrush x:Key="SmWarn" Color="#FFFFC24B" />
    <SolidColorBrush x:Key="SmBad" Color="#FFFF5468" />
    <Style x:Key="SmCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SmCardSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource SmLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="22,20" />
    </Style>
    <Style x:Key="SmModeTag" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Black" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SmH1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="SmSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InfinityMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style x:Key="SmHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InfinityMuted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The one primary action of a card: filled with the slot's accent, dark text. -->
    <Style x:Key="SmPrimary" TargetType="Button">
      <Setter Property="Foreground" Value="#FF071018" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Box" CornerRadius="10" Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <Border x:Name="Shine" CornerRadius="10" Background="#00FFFFFF" IsHitTestVisible="False" BorderThickness="2" BorderBrush="Transparent" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Background" Value="#26FFFFFF" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shine" Property="BorderBrush" Value="#CCFFFFFF" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shine" Property="Background" Value="#33000000" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- Secondary: the panel surface, a thin line that lights on hover. -->
    <Style x:Key="SmButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
      <Setter Property="Background" Value="{StaticResource SmCardRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource SmLine}" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True">
              <!-- games-5: a long label (pt-BR) wraps inside a narrow column instead of being cut -->
              <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InfinityMuted}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SmDanger" TargetType="Button" BasedOn="{StaticResource SmButton}">
      <Setter Property="Foreground" Value="{StaticResource SmBad}" />
      <Setter Property="BorderBrush" Value="#66FF5468" />
    </Style>
    <!-- A large choice (Start options): left-aligned title and hint; the accent lights its border on hover (Tag = accent). -->
    <Style x:Key="SmChoice" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
      <Setter Property="Background" Value="{StaticResource SmCardSurface}" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{StaticResource SmLine}" BorderThickness="1">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SmMenuItem" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" CornerRadius="7" Background="{TemplateBinding Background}">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#14FFFFFF" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="Background" Value="#1FFFFFFF" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SmLink" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InfinityMuted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="6,4">
            <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}">
              <TextBlock.TextDecorations>
                <TextDecoration Location="Underline" PenOffset="3"><TextDecoration.Pen><Pen Brush="#80F9EAEE" Thickness="1" DashStyle="{x:Static DashStyles.Dot}" /></TextDecoration.Pen></TextDecoration>
              </TextBlock.TextDecorations>
            </TextBlock>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource InfinityText}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource InfinityPink}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SmPill" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SmNote" TargetType="Border">
      <Setter Property="Background" Value="#0AFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource SmLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <!-- A comparison card (Resolve, Copy): badge, title, key/value lines with ▲/▼. -->
    <DataTemplate x:Key="SmCompareLines">
      <ItemsControl ItemsSource="{Binding Lines}" Margin="0,10,0,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1" Padding="0,7">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
                  <TextBlock Text=" ▲" Foreground="{x:Static local:SlotBrushes.Good}" Visibility="{Binding Up, Converter={StaticResource Visible}}" />
                  <TextBlock Text=" ▼" Foreground="{StaticResource SmBad}" Visibility="{Binding Down, Converter={StaticResource Visible}}" />
                </StackPanel>
                <TextBlock Text="{Binding Key}" Foreground="{StaticResource InfinityMuted}" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
    <!-- OD-119: a news card (cover, title, date, summary, pinned, unread) of the NEWS page (owner 2026-11-08: news is never on PLAY). -->
    <DataTemplate x:Key="NewsCardTemplate">
      <Button Click="OnNewsCard" Margin="0,0,0,10" Background="{DynamicResource NewsCardSurface}" AutomationProperties.Name="{Binding Title}">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModCardButton}" /></Button.Style>
        <StackPanel>
          <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,0,10" MaxHeight="150" Visibility="{Binding HasCover, Converter={StaticResource Visible}}">
            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
          </Border>
          <DockPanel>
            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{StaticResource InfinityPink}" VerticalAlignment="Top" Margin="8,6,0,0"
                     Visibility="{Binding Unread, Converter={StaticResource Visible}}" />
            <TextBlock FontWeight="Bold" FontSize="15" TextWrapping="Wrap" local:EmojiText.Text="{Binding Title}" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
            <TextBlock Text="{Binding PinnedLabel, StringFormat='  ·  {0}'}" FontSize="11" Foreground="{StaticResource InfinityGold}"
                       Visibility="{Binding Pinned, Converter={StaticResource Visible}}" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="13" local:EmojiText.Text="{Binding Summary}" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,0"
                     MaxHeight="60" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid>
  <!-- owner 2026-11-10: the lock blocks clicks without greying (no IsEnabled toggle); the keyboard is kept off it (MainWindow.ScreenLock.cs) -->
  <Grid x:Name="ShellContent" IsHitTestVisible="{Binding ModContentEnabled}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar: the wordmark, HOME, AZIMUTH, MODS, NEWS, HELP ... ACCOUNT, DONATE, server, version.
         Players browse and join worlds only in the in-game overlay (OD-54): the launcher has no Servers
         page. The one exception is the admins' dedicated lobby (OD-109): the top bar's globe and its pane. -->
    <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource InfinitySidebar}" IsEnabled="{Binding Idle}"
          Visibility="{Binding InShell, Converter={StaticResource Visible}}">
      <Image Source="{StaticResource BrandLines}" Stretch="UniformToFill" VerticalAlignment="Bottom" Height="150"
             Opacity="0.18" IsHitTestVisible="False" />
      <Border BorderBrush="#3365184D" BorderThickness="0,0,1,0" />
      <!-- OD-118 T1d: short windows (952x606) scroll the sidebar instead of drawing the nav over its bottom group. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <DockPanel MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Image DockPanel.Dock="Top" Source="{StaticResource BrandLogo}" Width="172" Margin="22,22,22,12"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,12,14">
          <Button Content="{Binding S[nav.help]}" Style="{StaticResource NavButton}" IsEnabled="{Binding InShell}" />
          <Button Content="{Binding S[nav.bug]}" Style="{StaticResource NavButton}" Click="OnNavBugReport" Tag="{Binding ShowBugReport}" />
          <Button Style="{StaticResource NavButton}" Click="OnDiscord" AutomationProperties.Name="{Binding S[nav.discord]}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding S[nav.discord]}" VerticalAlignment="Center" /><Path Data="{StaticResource IconExternal}" Style="{StaticResource InlineIcon}" Margin="6,0,0,0" /></StackPanel></Button>
          <Border Height="1" Background="{StaticResource InfinityBorder}" Margin="20,8,8,8" />
          <Button Content="{Binding S[nav.account]}" Style="{StaticResource NavButton}" IsEnabled="{Binding CanChangeIdentity}" Click="OnNavAccount" Tag="{Binding ShowAccount}" />
          <Button Content="{Binding S[nav.donate]}" Style="{StaticResource NavButton}" IsEnabled="{Binding InShell}" />
          <TextBlock Text="{Binding ServerLabel}" Margin="20,14,0,0" FontSize="11" Foreground="{StaticResource InfinityFaint}" />
          <!-- CR-L40: the connected server's figures (online now, registered profiles in parentheses), read every 30 s -->
          <StackPanel Margin="20,4,0,0" Background="Transparent" ToolTip="{Binding ServerStatusTip}" ToolTipService.ShowOnDisabled="True"
                      Visibility="{Binding ShowShellStatus, Converter={StaticResource Visible}}" AutomationProperties.HelpText="{Binding ServerStatusTip}">
            <TextBlock Text="{Binding ShellStatusPrimary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InfinityMuted}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding ShellStatusSecondary}" FontSize="11" Foreground="{StaticResource InfinityFaint}" TextWrapping="Wrap"
                       Visibility="{Binding ShowShellStatusSecondary, Converter={StaticResource Visible}}" />
          </StackPanel>
          <!-- OD-149: the play session's Hardcore profile is isolated by the anti-cheat system (neutral words, a dispute link) -->
          <Border Margin="20,8,8,0" Padding="10,8" CornerRadius="6" Background="#33E41E28" BorderBrush="#E41E28" BorderThickness="1"
                  Visibility="{Binding ShowPoolNotice, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding PoolNotice}" FontSize="12" FontWeight="SemiBold" Foreground="#FF6B73" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Assertive" />
              <Button Style="{StaticResource NavButton}" Click="OnPoolDispute" Margin="-20,4,0,0" AutomationProperties.Name="{Binding S[worlds.pool_dispute]}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding S[worlds.pool_dispute]}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" /><Path Data="{StaticResource IconExternal}" Style="{StaticResource InlineIcon}" Margin="6,0,0,0" /></StackPanel></Button>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding VersionLabel}" Margin="20,2,0,0" FontSize="11" Foreground="{StaticResource InfinityFaint}" />
        </StackPanel>
        <StackPanel Margin="0,0,12,0">
          <Button Content="{Binding S[nav.play]}" Style="{StaticResource NavButton}" Click="OnNavHome" Tag="{Binding ShowHome}" />
          <!-- Owner 2026-11-08: profile management (create, rename, delete, the save tools of PLAY's game). -->
          <Button Content="{Binding S[nav.profiles]}" Style="{StaticResource NavButton}" Click="OnNavProfiles" Tag="{Binding ShowProfiles}" />
          <!-- All game configuration and validation live here. -->
          <Button Style="{StaticResource NavButton}" Click="OnNavSetup" Tag="{Binding ShowSetup}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding S[nav.configure]}" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="#E41E28" VerticalAlignment="Center"
                       ToolTip="{Binding S[play.setup_needed]}" AutomationProperties.Name="{Binding S[play.setup_needed]}"
                       Visibility="{Binding SetupNeeded, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Button>
          <!-- OD-45: Mods, with a small tag when there is news (an update, or a release not seen yet). -->
          <Button Style="{StaticResource NavButton}" IsEnabled="{Binding CanOpenMods}" Click="OnNavMods" Tag="{Binding ShowMods}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding S[nav.mods]}" VerticalAlignment="Center" />
              <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="8" Background="{StaticResource InfinitySunset}"
                      VerticalAlignment="Center" Visibility="{Binding ModsNews, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding ModsTag}" FontSize="10" FontWeight="Bold" Foreground="White" />
              </Border>
            </StackPanel>
          </Button>
          <!-- OD-119: News, with a dot while an item is unread. -->
          <Button Style="{StaticResource NavButton}" IsEnabled="{Binding InShell}" Click="OnNavNews" Tag="{Binding ShowNews}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding S[nav.news]}" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="{StaticResource InfinityPink}" VerticalAlignment="Center"
                       Visibility="{Binding NewsUnread, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
      </ScrollViewer>
    </Grid>

    <!-- The page area: Home's art behind everything, then the top bar, the page and the status line. -->
    <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
      <Grid IsHitTestVisible="False" Visibility="{Binding ShowHero, Converter={StaticResource Visible}}">
        <Image Source="{StaticResource BrandHero}" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9" />
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="#FF0E0616" Offset="0.05" />
              <GradientStop Color="#C00E0616" Offset="0.45" />
              <GradientStop Color="#300E0616" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="#CC0E0616" Offset="0" />
              <GradientStop Color="#000E0616" Offset="0.25" />
              <GradientStop Color="#000E0616" Offset="0.7" />
              <GradientStop Color="#FF0E0616" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
      <!-- Sign-in: the infinity mark, large and faint, anchored at the bottom-right corner (owner). -->
      <Image Source="{StaticResource BrandMark}" Width="1100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-40"
             Opacity="0.12" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"
             Visibility="{Binding ShowSignIn, Converter={StaticResource Visible}}" />
      <!-- Speed streaks, faint, on every page but Home. -->
      <Image Source="{StaticResource BrandStreaks}" Width="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,-120,0"
             Opacity="0.10" IsHitTestVisible="False" Visibility="{Binding ShowHome, Converter={StaticResource Hidden}}" />

      <DockPanel>
        <!-- Top bar: connection / GAME (change) / profile (change) ... e-mail (exit). -->
        <Border DockPanel.Dock="Top" Padding="22,14" BorderThickness="0,0,0,1" BorderBrush="#1FF9EAEE"
                Visibility="{Binding InShell, Converter={StaticResource Visible}}">
          <DockPanel LastChildFill="False">
            <Border DockPanel.Dock="Left" Padding="10,4" CornerRadius="12" Background="#26F9EAEE" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource InfinityFaint}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Online}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource InfinityAccent}" />
                          <Setter Property="Effect" Value="{StaticResource InfinityGlow}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Connection}" Margin="8,0,0,0" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource InfinityMuted}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <!-- Owner 2026-11-08: no game or profile picker in the header (the game is PLAY's tiles, the profile PLAY's two buttons). -->
            <!-- Owner 2026-11-08: the FRIENDS sidebar's toggle, right of (exit): "{icon} online/total", a green dot for a pending request or invite. -->
            <Button x:Name="FriendsToggle" DockPanel.Dock="Right" Style="{StaticResource SmButton}" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center"
                    Click="OnToggleFriends" AutomationProperties.Name="{Binding FriendsButtonName}" ToolTip="{Binding FriendsButtonName}"
                    Visibility="{Binding ShowFriendsButton, Converter={StaticResource Visible}}">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <Path Data="M9,11 A3.2,3.2 0 1 0 9,4.6 A3.2,3.2 0 1 0 9,11 M2.5,19 C2.5,15 5.5,13 9,13 C12.5,13 15.5,15 15.5,19 M16,11 A2.6,2.6 0 1 0 16,5.8 M17.5,13.3 C19.8,13.9 21.5,15.6 21.5,18.5"
                        Stroke="{StaticResource InfinityText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="20"
                        Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding FriendsCounts}" Margin="7,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <Ellipse Width="9" Height="9" Fill="{x:Static local:SlotBrushes.Good}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0"
                         Visibility="{Binding FriendsPending, Converter={StaticResource Visible}}" />
              </Grid>
            </Button>
            <!-- CR-S62: quick moderation actions, top right, for moderator and admin accounts only. -->
            <Button x:Name="ModerationButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                    Content="{Binding S[moderation.open]}" Click="OnToggleModerationPane" VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding S[moderation.open]}"
                    Visibility="{Binding CanModerate, Converter={StaticResource Visible}}" />
            <!-- Owner 2026-11-08 (games-5): signed in, "{avatar} {e-mail} (exit)": the Discord avatar when linked (loaded once, async), else a
                 round initial in the accent colour; the Supporter chip before it. -->
            <StackPanel x:Name="HeaderAccountPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        IsEnabled="{Binding CanChangeIdentity}"
                        Visibility="{Binding ShowHeaderAccount, Converter={StaticResource Visible}}">
              <!-- CR-S69: a Supporter's account carries a small badge; every account is an Infinity Racer otherwise. -->
              <Border Background="{StaticResource InfinityPink}" CornerRadius="8" Padding="7,1" Margin="0,0,10,0" VerticalAlignment="Center"
                      ToolTip="{Binding S[shell.supporter_badge_tip]}"
                      Visibility="{Binding ShowSupporterBadge, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding S[shell.supporter_badge]}" FontSize="10" FontWeight="Bold" Foreground="White" />
              </Border>
              <Grid x:Name="HeaderAvatar" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Email}">
                <Ellipse Fill="#33FF4F8B" Stroke="{StaticResource InfinityPink}" StrokeThickness="1.5" />
                <TextBlock Text="{Binding AccountInitial}" Foreground="{StaticResource InfinityPink}" FontSize="13" FontWeight="Black"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Visibility="{Binding HasDiscordAvatar, Converter={StaticResource Visible}}">
                  <Ellipse.Fill><ImageBrush ImageSource="{Binding DiscordAvatar}" Stretch="UniformToFill" /></Ellipse.Fill>
                </Ellipse>
              </Grid>
              <TextBlock Text="{Binding Email}" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}"
                         VerticalAlignment="Center" Foreground="{StaticResource InfinityMuted}" />
              <Button Content="{Binding S[shell.exit]}" Style="{StaticResource LinkButton}" Click="OnSignOut" />
            </StackPanel>
            <!-- OD-118; games-5: signed out (the offline path) the top right is a single Sign in button. -->
            <Button x:Name="HeaderSignIn" DockPanel.Dock="Right" Content="{Binding S[offline.sign_in]}" Style="{StaticResource AccentButtonStyle}" Click="OnOpenSignIn" Padding="14,6"
                    VerticalAlignment="Center" IsEnabled="{Binding Idle}" Visibility="{Binding ShowHeaderSignIn, Converter={StaticResource Visible}}" />
          </DockPanel>
        </Border>

        <!-- Owner 2026-11-08: the FRIENDS sidebar, shell level (any page), toggled by the header's friends button; as the in-game overlay's
             (W15): add by gamertag on top, friends online first then by name, then incoming requests and invites with accept / decline. -->
        <Border x:Name="FriendsPane" DockPanel.Dock="Right" Width="320" Padding="18,18,10,14" Background="{StaticResource InfinitySurface}"
                BorderBrush="#3365184D" BorderThickness="1,0,0,0" Visibility="{Binding ShowFriendsSidebar, Converter={StaticResource Visible}}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,12">
              <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmButton}" Width="32" Height="30" Padding="0" Click="OnToggleFriends"
                      AutomationProperties.Name="{Binding S[play.friends_close]}" ToolTip="{Binding S[play.friends_close]}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding S[play.friends_title]}" FontSize="13" FontWeight="Black" />
                <TextBlock Text="{Binding FriendsCounts}" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource InfinityMuted}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,6">
              <Button DockPanel.Dock="Right" Content="{Binding S[play.friends_add]}" Style="{StaticResource SmButton}" Padding="12,6" Margin="8,0,0,0"
                      Click="OnAddFriend" IsEnabled="{Binding CanAddFriend}" />
              <TextBox Text="{Binding FriendAddName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Padding="8,5" KeyDown="OnFriendAddKey"
                       AutomationProperties.Name="{Binding S[play.friends_add_hint]}" ToolTip="{Binding S[play.friends_add_hint]}" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding FriendsStatus}" Margin="0,4,8,6" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                       AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasFriendsStatus, Converter={StaticResource Visible}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,6,0,0">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding S[play.friends_not_read]}" Style="{StaticResource SmHint}" Margin="0,4,0,0"
                           Visibility="{Binding FriendsNotRead, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding S[play.friends_empty]}" Style="{StaticResource SmHint}" Margin="0,4,0,0"
                           Visibility="{Binding FriendsEmpty, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding FriendCards}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="8,8" Margin="0,0,0,4" CornerRadius="10" Background="#08FFFFFF">
                        <StackPanel>
                          <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="32" Height="32" VerticalAlignment="Center">
                              <Ellipse Fill="{StaticResource SmCardRaised}" />
                              <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <!-- CR-S102: the friend's Discord avatar once loaded (cdn.discordapp.com only), over the initial -->
                              <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource Visible}}">
                                <Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" /></Ellipse.Fill>
                              </Ellipse>
                              <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource InfinitySurface}" StrokeThickness="2">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource InfinityFaint}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Fill" Value="{x:Static local:SlotBrushes.Good}" /></DataTrigger></Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Discord}" FontSize="10" Foreground="#FF7888FF" TextTrimming="CharacterEllipsis"
                                         Visibility="{Binding HasDiscord, Converter={StaticResource Visible}}" />
                              <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource InfinityMuted}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Online}" Value="True"><Setter Property="Foreground" Value="{x:Static local:SlotBrushes.Good}" /></DataTrigger></Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Text="{Binding Profiles}" FontSize="10" Foreground="{StaticResource InfinityFaint}" TextWrapping="Wrap"
                                         Visibility="{Binding HasProfiles, Converter={StaticResource Visible}}" />
                            </StackPanel>
                          </DockPanel>
                          <!-- a friend's live invite to this account: accept joins in the game's overlay; decline here -->
                          <StackPanel Margin="42,6,0,0" Visibility="{Binding Invited, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding DataContext.S[play.friend_invited], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11"
                                       Foreground="{x:Static local:SlotBrushes.Good}" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,4,0,0">
                              <Button Content="{Binding DataContext.S[play.friends_accept], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SmButton}"
                                      Padding="10,4" Margin="0,0,6,0" FontSize="12" Click="OnAcceptFriendInvite" />
                              <Button Content="{Binding DataContext.S[play.friends_decline], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SmButton}"
                                      Padding="10,4" FontSize="12" Click="OnDeclineFriendInvite" />
                            </WrapPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasFriendRequests, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding S[play.friends_requests]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,6" />
                  <ItemsControl ItemsSource="{Binding FriendRequestCards}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="8,8" Margin="0,0,0,4" CornerRadius="10" Background="#08FFFFFF">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                              <Button Content="✓" Style="{StaticResource SmButton}" Width="30" Height="28" Padding="0" Margin="4,0,0,0" Click="OnAcceptFriendRequest"
                                      AutomationProperties.Name="{Binding DataContext.S[play.friends_accept], RelativeSource={RelativeSource AncestorType=Window}}"
                                      ToolTip="{Binding DataContext.S[play.friends_accept], RelativeSource={RelativeSource AncestorType=Window}}" />
                              <Button Content="✕" Style="{StaticResource SmButton}" Width="30" Height="28" Padding="0" Margin="4,0,0,0" Click="OnDeclineFriendRequest"
                                      AutomationProperties.Name="{Binding DataContext.S[play.friends_decline], RelativeSource={RelativeSource AncestorType=Window}}"
                                      ToolTip="{Binding DataContext.S[play.friends_decline], RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <!-- CR-S102: a leader accepts requests to join with the game's ticket, so in the in-game overlay, never here -->
                <TextBlock Text="{Binding S[play.friends_requests_overlay]}" Style="{StaticResource SmHint}" Margin="0,12,8,0" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- CR-S62: the moderation pane (moderators and admins): a player of the world or one looked up, then Kick, Strike or Ban.
             Escape (B) closes it. -->
        <Border x:Name="ModerationPane" DockPanel.Dock="Right" Width="400" Padding="22,22,8,16" Background="{StaticResource InfinitySurface}"
                BorderBrush="#3365184D" BorderThickness="1,0,0,0" KeyDown="OnModerationPaneKey"
                Visibility="{Binding ShowModerationPane, Converter={StaticResource Visible}}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,12,0">
              <Button DockPanel.Dock="Right" Content="{Binding S[moderation.close]}" Style="{StaticResource LinkButton}"
                      Click="OnToggleModerationPane" VerticalAlignment="Center" />
              <TextBlock Text="{Binding S[moderation.title]}" FontSize="20" FontWeight="Bold" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding S[moderation.subtitle]}" Style="{StaticResource PageSubtitle}" Margin="0,2,12,0" TextWrapping="Wrap" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
              <StackPanel Margin="0,0,12,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{Binding S[moderation.refresh]}" Style="{StaticResource LinkButton}" Click="OnModerationRefresh" />
                  <TextBlock Text="{Binding S[moderation.players_title]}" Style="{StaticResource SectionTag}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding S[moderation.players_empty]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,0"
                           Visibility="{Binding HasModerationPlayers, Converter={StaticResource Hidden}}" />
                <ListBox x:Name="ModerationPlayerList" ItemsSource="{Binding ModerationPlayers}" SelectedItem="{Binding ModerationSelected}" DisplayMemberPath="Line"
                         MaxHeight="180" Margin="0,6,0,12" AutomationProperties.Name="{Binding S[moderation.players_title]}"
                         Visibility="{Binding HasModerationPlayers, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding S[moderation.lookup]}" Style="{StaticResource SectionTag}" Margin="0,6,0,0" />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="{Binding S[moderation.find]}" Click="OnModerationFind" IsEnabled="{Binding CanFindModerationTarget}" Margin="8,0,0,0" />
                  <TextBox x:Name="ModerationLookupBox" Text="{Binding ModerationLookup, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                           KeyDown="OnModerationLookupKey" AutomationProperties.Name="{Binding S[moderation.lookup]}" />
                </DockPanel>
                <ListBox ItemsSource="{Binding ModerationMatches}" SelectedItem="{Binding ModerationSelected}" DisplayMemberPath="Line"
                         MaxHeight="140" Margin="0,6,0,0" AutomationProperties.Name="{Binding S[moderation.lookup]}"
                         Visibility="{Binding HasModerationMatches, Converter={StaticResource Visible}}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
                  <StackPanel>
                    <TextBlock Text="{Binding S[moderation.target]}" Style="{StaticResource SectionTag}" />
                    <TextBlock Text="{Binding ModerationTargetText}" FontWeight="Bold" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding S[moderation.action]}" Style="{StaticResource SectionTag}" />
                    <WrapPanel Margin="0,6,0,10">
                      <RadioButton Content="{Binding S[moderation.kick]}" IsChecked="{Binding ModerationKick}" GroupName="ModerationAction" Margin="0,0,14,6" />
                      <RadioButton Content="{Binding S[moderation.strike]}" IsChecked="{Binding ModerationStrike}" GroupName="ModerationAction" Margin="0,0,14,6" />
                      <RadioButton Content="{Binding S[moderation.ban]}" IsChecked="{Binding ModerationBan}" GroupName="ModerationAction" Margin="0,0,14,6"
                                   Visibility="{Binding CanBan, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding S[moderation.reason]}" TextWrapping="Wrap" FontSize="12" />
                    <TextBox Text="{Binding ModerationReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="0,4,0,2"
                             TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54" AutomationProperties.Name="{Binding S[moderation.reason]}" />
                    <TextBlock Text="{Binding ModerationFormProblem}" FontSize="11" Foreground="{StaticResource InfinityGold}" TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowModerationCooldown, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding S[moderation.cooldown]}" FontSize="12" />
                      <ComboBox ItemsSource="{Binding ModerationCooldowns}" SelectedItem="{Binding ModerationCooldown}" DisplayMemberPath="Label" Margin="0,4,0,0"
                                AutomationProperties.Name="{Binding S[moderation.cooldown]}" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowModerationBanForm, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding S[moderation.ban_duration]}" FontSize="12" />
                      <ComboBox ItemsSource="{Binding ModerationBanDurations}" SelectedItem="{Binding ModerationBanDuration}" DisplayMemberPath="Label" Margin="0,4,0,0"
                                AutomationProperties.Name="{Binding S[moderation.ban_duration]}" />
                      <TextBlock Text="{Binding S[moderation.ban_warning]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityRose}" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding ModerationBanTypeHint}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,4" />
                      <TextBox Text="{Binding ModerationBanTyped, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                               AutomationProperties.Name="{Binding ModerationBanTypeHint}" />
                    </StackPanel>
                    <Button Content="{Binding ModerationApplyText}" Click="OnModerationApply" IsEnabled="{Binding CanApplyModeration}"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding ModerationStatus}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding HasModerationStatus, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Status line. -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding DisplayMessage}" Margin="40,0,40,18" TextWrapping="Wrap"
                   Foreground="{StaticResource InfinityMuted}" />

        <!-- Content: one panel per step of sign-in -> game -> profile. -->
        <Grid Margin="40,28,40,16">
          <!-- A quiet first screen: the brand and one clear entrance. -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                      Visibility="{Binding ShowWelcomeHome, Converter={StaticResource Visible}}">
            <Image Source="{StaticResource BrandLogo}" Width="480" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border HorizontalAlignment="Center" Margin="0,20,0,32" Padding="12,4" CornerRadius="4"
                    Background="{StaticResource InfinityWarnSurface}" BorderBrush="{StaticResource InfinityGold}" BorderThickness="1">
              <TextBlock Text="BETA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InfinityGold}" />
            </Border>
            <Button Content="{Binding S[welcome.sign_in]}" Click="OnOpenSignIn" Style="{StaticResource PlayButton}"
                    HorizontalAlignment="Center" Visibility="{Binding Resuming, Converter={StaticResource Hidden}}" />
            <TextBlock Text="{Binding S[native.signing_in]}" HorizontalAlignment="Center" FontSize="16"
                       Foreground="{StaticResource InfinityMuted}" Visibility="{Binding Resuming, Converter={StaticResource Visible}}" />
            <!-- OD-118: the launcher without an account; signing in is only needed for online play. -->
            <StackPanel HorizontalAlignment="Center" Visibility="{Binding Resuming, Converter={StaticResource Hidden}}">
              <Button x:Name="PlayOfflineLink" Content="{Binding S[offline.play_offline_link]}" Click="OnPlayOfflineLink" Style="{StaticResource LinkButton}"
                      HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="15" AutomationProperties.Name="{Binding S[offline.play_offline_link]}" />
              <TextBlock Text="{Binding S[offline.sign_in_needed]}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource InfinityMuted}" />
            </StackPanel>
            <Button Content="{Binding S[mods.dev_open]}" Click="OnNavMods" Margin="0,16,0,0"
                    Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}" HorizontalAlignment="Center" />
            <!-- CR-L39: the official server or a custom one, chosen here and saved. -->
            <StackPanel HorizontalAlignment="Center" Margin="0,26,0,0" Visibility="{Binding Resuming, Converter={StaticResource Hidden}}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ServerChoiceText}" FontSize="13" Foreground="{StaticResource InfinityMuted}" VerticalAlignment="Center" />
                <Button x:Name="ServerChangeLink" Content="{Binding S[server.change]}" Click="OnServerChange" Style="{StaticResource LinkButton}" Margin="4,0,0,0"
                        IsEnabled="{Binding CanChangeServer}" AutomationProperties.Name="{Binding S[server.change]}" />
              </StackPanel>
              <TextBlock Text="{Binding ServerSecurityText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                         Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource InfinityGold}"
                         Visibility="{Binding ShowServerSecurity, Converter={StaticResource Visible}}" />
            </StackPanel>
          </StackPanel>
          <!-- Owner 2026-10-27: Azimuth is found before sign-in. None found, its setup comes first (local only, OD-118). -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowAzimuthFirst, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Padding="28,24" Width="560" Margin="0,20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding S[setup.first_title]}" Style="{StaticResource PageTitle}" FontSize="24" TextWrapping="Wrap" />
              <TextBlock Text="{Binding S[setup.first_body]}" Margin="0,8,0,16" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
              <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}" />
                <TextBlock Text="{Binding SetupFoundLine}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              </DockPanel>
              <TextBlock Text="{Binding SetupStep1}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding S[setup.step2]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,4" />
              <WrapPanel Margin="0,14,0,0">
                <Button x:Name="AzimuthFirstChoose" Content="{Binding S[setup.choose]}" Click="OnChooseAzimuthFirst" Style="{StaticResource AccentButtonStyle}"
                        Padding="16,6" Margin="0,0,10,8" IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding S[setup.choose]}" />
                <Button Content="{Binding S[setup.recheck]}" Click="OnRecheckAzimuthFirst" Padding="16,6" Margin="0,0,10,8" IsEnabled="{Binding Idle}" />
                <Button Content="{Binding S[setup.first_later]}" Click="OnAzimuthLater" Style="{StaticResource LinkButton}" Margin="0,0,0,8" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding S[setup.first_later]}" />
              </WrapPanel>
              <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,4,0,0" Click="OnOpenAzimuthPage" AutomationProperties.Name="{Binding S[setup.grab]}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding S[setup.grab]}" VerticalAlignment="Center" /><Path Data="{StaticResource IconExternal}" Style="{StaticResource InlineIcon}" Margin="6,0,0,0" /></StackPanel></Button>
              <TextBlock Text="{Binding S[setup.first_note]}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityFaint}" Margin="0,14,0,0" />
            </StackPanel>
          </Border>
          </ScrollViewer>
          <!-- CR-L39: the server editor takes the welcome screen's place while it is open. -->
          <!-- OD122-L9: the beholder's servers, the official server and a typed address; controller-first (D-pad, A, B). -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowServerEditor, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Padding="24,20" Width="560" Margin="0,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="{Binding S[picker.refresh]}" Click="OnPickerRefresh" Padding="12,4" IsEnabled="{Binding Idle}"
                            AutomationProperties.Name="{Binding S[picker.refresh]}" />
                    <TextBlock Text="{Binding S[server.title]}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="{Binding BeholderStatusText}" FontSize="11" Foreground="{StaticResource InfinityFaint}" Margin="0,0,0,6" />
                  <ListBox x:Name="ServerList" ItemsSource="{Binding ServerItems}" SelectedItem="{Binding ServerPick}" MaxHeight="300"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding S[server.title]}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="4,6">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource InfinityFaint}" VerticalAlignment="Center"
                                    Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
                              <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource InfinityMuted}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
                          <!-- CR-L40: the server's figures under host · region · ping -->
                          <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource InfinityFaint}" TextWrapping="Wrap"
                                     Visibility="{Binding HasStatus, Converter={StaticResource Visible}}"
                                     ToolTip="{Binding DataContext.ServerStatusTip, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{Binding S[picker.no_servers]}" FontSize="11" Foreground="{StaticResource InfinityFaint}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding NoListedServers, Converter={StaticResource Visible}}" />
                  <StackPanel Visibility="{Binding ShowServerAddressField, Converter={StaticResource Visible}}">
                    <TextBox x:Name="ServerAddressBox" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,4"
                             AutomationProperties.Name="{Binding S[server.custom]}" />
                    <TextBlock Text="{Binding S[server.address_hint]}" FontSize="11" Foreground="{StaticResource InfinityFaint}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Text="{Binding ServerEditText}" FontSize="12" Foreground="{StaticResource InfinityGold}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{Binding S[server.save]}" Click="OnServerSave" Style="{StaticResource AccentButtonStyle}" Padding="18,6" />
                    <Button Content="{Binding S[server.cancel]}" Click="OnServerCancel" Margin="10,0,0,0" Padding="18,6" />
                  </StackPanel>
                </StackPanel>
          </Border>
          </ScrollViewer>
          <!-- Owner 2026-10-26: this PC and the cloud both moved on; the player picks (SAVES_API §4.4/§5). -->
          <Grid x:Name="SaveConflictPrompt" Panel.ZIndex="5" Background="{StaticResource InfinityBackground}" Visibility="{Binding ShowSaveConflict, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Padding="24,20" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding S[saves.conflict_title]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Text="{Binding S[saves.conflict_body]}" TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,0,0,14" />
              <TextBlock Text="{Binding S[saves.conflict_cloud]}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SaveConflictCloudText}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,2,0,10" />
              <TextBlock Text="{Binding S[saves.conflict_local]}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SaveConflictLocalText}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,2,0,16" />
              <WrapPanel>
                <Button Content="{Binding S[saves.conflict_keep_cloud]}" Click="OnConflictKeepCloud" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Margin="0,0,10,8"
                        Visibility="{Binding CanKeepCloudSave, Converter={StaticResource Visible}}" />
                <Button x:Name="ConflictKeepLocalButton" Content="{Binding S[saves.conflict_keep_local]}" Click="OnConflictKeepLocal" Padding="16,6" Margin="0,0,10,8" />
                <Button Content="{Binding S[saves.conflict_not_now]}" Click="OnConflictNotNow" Style="{StaticResource LinkButton}" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock Text="{Binding S[saves.conflict_backup]}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InfinityFaint}" />
            </StackPanel>
          </Border>
          </Grid>
          <!-- OD-133: the line's first save was refused as past its start: a new career only on the player's word (this one backed up first). -->
          <Grid x:Name="FreshStartPrompt" Panel.ZIndex="5" Background="{StaticResource InfinityBackground}" Visibility="{Binding ShowFreshStartRefused, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Padding="24,20" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding S[saves.fresh_refused_title]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
              <TextBlock Text="{Binding S[saves.fresh_refused_body]}" TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,0,0,14" />
              <WrapPanel>
                <Button Content="{Binding S[saves.fresh_refused_new]}" Click="OnFreshRefusedNewCareer" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Margin="0,0,10,8" />
                <Button Content="{Binding S[saves.conflict_not_now]}" Click="OnFreshRefusedNotNow" Style="{StaticResource LinkButton}" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          </Grid>
          <!-- OD-133: a restored career still waiting for the cloud (the Play stopped), or an undo owed: the way out, nothing deleted. -->
          <Grid x:Name="RestoreWaitingPrompt" Panel.ZIndex="5" Background="{StaticResource InfinityBackground}" Visibility="{Binding ShowRestoreWaiting, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Padding="24,20" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding S[restore.blocked_title]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
              <TextBlock Text="{Binding S[restore.blocked_body]}" TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,0,0,14" />
              <WrapPanel>
                <Button Content="{Binding S[restore.blocked_set_aside]}" Click="OnRestoreSetAside" IsEnabled="{Binding Idle}" Style="{StaticResource AccentButtonStyle}"
                        Padding="16,6" Margin="0,0,10,8" />
                <Button Content="{Binding S[restore.blocked_keep]}" Click="OnRestoreKeep" IsEnabled="{Binding Idle}" Padding="16,6" Margin="0,0,10,8"
                        Visibility="{Binding CanKeepRestoredCareer, Converter={StaticResource Visible}}" />
                <Button Content="{Binding S[restore.blocked_later]}" Click="OnRestoreLater" Style="{StaticResource LinkButton}" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          </Grid>
          <!-- OD-133: restore a career a fresh start moved aside: the list, then the confirmation (the server's dry run runs on confirm). -->
          <Grid x:Name="CareerRestorePrompt" Panel.ZIndex="5" Background="{StaticResource InfinityBackground}" Visibility="{Binding ShowCareerRestore, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Padding="24,20" Width="540" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding S[restore.title]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
              <StackPanel Visibility="{Binding ShowCareerRestoreList, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding CareerRestoreListText}" TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,0,0,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                  <ItemsControl ItemsSource="{Binding CareerRestoreRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Margin="0,5" Padding="20,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Click="OnPickCareerRestore" IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button Content="{Binding S[restore.cancel]}" Click="OnCloseCareerRestore" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
              </StackPanel>
              <StackPanel Visibility="{Binding ShowCareerRestoreConfirm, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding S[restore.confirm_title]}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding CareerRestoreConfirmText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="{Binding S[restore.confirm]}" Click="OnConfirmCareerRestore" IsEnabled="{Binding Idle}" Style="{StaticResource AccentButtonStyle}"
                          Padding="16,6" Margin="0,0,10,8" />
                  <Button Content="{Binding S[restore.back]}" Click="OnBackCareerRestore" IsEnabled="{Binding Idle}" Padding="16,6" Margin="0,0,10,8" />
                  <Button Content="{Binding S[restore.cancel]}" Click="OnCloseCareerRestore" Style="{StaticResource LinkButton}" Margin="0,0,0,8" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          </Grid>
          <!-- CR-S52: a Hardcore line still empty starts from scratch or from one of the account's profiles, checked on the spot. The first
               Play's choice, then the server's dry run, shown before the player confirms (nothing is copied before an accepted check). -->
          <Grid x:Name="SeedPrompt" Panel.ZIndex="5" Background="{StaticResource InfinityBackground}" Visibility="{Binding ShowSeedPanel, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource SmCard}" Padding="26,22" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <!-- SAVE_MANAGER_UX §3: ‹ Back and the breadcrumb here too (Back = Not now: nothing was copied) -->
              <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Left" Content="{Binding S[sm.back]}" Style="{StaticResource SmButton}" Padding="12,6" FontSize="13" Margin="0,0,12,0" Click="OnSeedCloseChoice" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding CheckTrail, Mode=OneWay}" Foreground="{StaticResource InfinityMuted}" /><Run Text="{Binding S[sm.check_title], Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
              </DockPanel>
              <!-- §2.5: the check as a visible step list (Reading → Checking progression → Result) -->
              <ItemsControl ItemsSource="{Binding CheckSteps}" Margin="0,0,0,14" Focusable="False" Visibility="{Binding ShowCheckSteps, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource SmLine}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Black" Width="20" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Visibility="{Binding ShowSeedChoice, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding SeedChoiceTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
                <TextBlock Text="{Binding S[seed.first_launch_body]}" TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,0,0,14" />
                <Button Margin="0,0,0,12" Padding="20,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSeedScratch" IsEnabled="{Binding Idle}">
                  <StackPanel>
                    <TextBlock Text="{Binding S[seed.scratch]}" FontWeight="Bold" />
                    <TextBlock Text="{Binding S[seed.scratch_detail]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
                <TextBlock Text="{Binding S[seed.option]}" FontWeight="Bold" />
                <!-- a list, not a ComboBox: its popup froze the launcher under Proton on the DECK (2026-10-27) -->
                <ListBox Margin="0,6,0,0" ItemsSource="{Binding SeedChoiceSources}" SelectedItem="{Binding SeedChoiceSource}" MaxHeight="160"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding S[seed.source_label]}" />
                <TextBlock Text="{Binding S[seed.warning]}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" />
                <!-- the panel covers the status line: progress and early failures are shown here too -->
                <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="{Binding S[seed.check]}" Click="OnSeedCheckChoice" IsEnabled="{Binding CanCheckSeedChoice}" Style="{StaticResource AccentButtonStyle}"
                          Padding="16,6" Margin="0,0,10,8" />
                  <Button Content="{Binding S[saves.conflict_not_now]}" Click="OnSeedCloseChoice" Style="{StaticResource LinkButton}" Margin="0,0,0,8" />
                </WrapPanel>
              </StackPanel>
              <StackPanel Visibility="{Binding ShowSeedCheck, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding SeedCheckTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SeedCheckText}" Margin="0,8,0,6" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding SeedCheckReasons}" Margin="8,0,0,6" TextWrapping="Wrap" Foreground="{StaticResource InfinityRose}"
                           Visibility="{Binding SeedCheckRefused, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding SeedCheckSummary}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                <TextBlock Text="{Binding S[seed.warning]}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                           Visibility="{Binding SeedCheckAccepted, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding S[seed.commit_counts]}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                           Visibility="{Binding SeedCommitMayBeLimited, Converter={StaticResource Visible}}" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="{Binding S[seed.confirm]}" Click="OnConfirmSeed" IsEnabled="{Binding Idle}" Margin="0,0,10,8" Padding="16,6"
                          Style="{StaticResource AccentButtonStyle}" Visibility="{Binding SeedCheckAccepted, Converter={StaticResource Visible}}" />
                  <!-- §2.5: a refusal's ways out: a fresh HARDCORE career, or the source played as NOOB -->
                  <Button Content="{Binding S[sm.check.fresh]}" Click="OnDismissSeed" IsEnabled="{Binding Idle}" Margin="0,0,10,8"
                          Background="{x:Static local:SlotBrushes.Hardcore}" Style="{StaticResource SmPrimary}" Visibility="{Binding ShowCheckWaysOut, Converter={StaticResource Visible}}" />
                  <Button Content="{Binding S[sm.check.as_noob]}" Click="OnPlaySourceAsNoob" IsEnabled="{Binding Idle}" Margin="0,0,10,8"
                          Style="{StaticResource SmButton}" Visibility="{Binding CanPlaySourceAsNoob, Converter={StaticResource Visible}}" />
                  <Button Content="{Binding S[seed.start_fresh]}" Click="OnDismissSeed" IsEnabled="{Binding Idle}" Padding="16,6" Margin="0,0,10,8"
                          Visibility="{Binding ShowCheckWaysOut, Converter={StaticResource Hidden}}" />
                  <Button Content="{Binding S[saves.conflict_not_now]}" Click="OnSeedCloseChoice" Style="{StaticResource LinkButton}" Margin="0,0,0,8"
                          Visibility="{Binding ShowSeedNotNow, Converter={StaticResource Visible}}" />
                  <!-- OD-214 (§6.7): a refused check leaves an empty career: start fresh (above) or delete it. -->
                  <Button Content="{Binding S[careers.delete_empty]}" Click="OnSeedDeleteCareer" Style="{StaticResource LinkButton}" Margin="0,0,0,8"
                          Visibility="{Binding ShowSeedDeleteCareer, Converter={StaticResource Visible}}" />
                </WrapPanel>
              </StackPanel>
              <!-- A seed whose first upload waits on the day's checks (429): wait, or a new career instead (the seed set aside, kept). -->
              <StackPanel Visibility="{Binding ShowSeedBlocked, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding S[seed.blocked_title]}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SeedBlockedText}" Margin="0,8,0,6" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="{Binding S[seed.abandon]}" Click="OnAbandonSeed" IsEnabled="{Binding Idle}" Padding="16,6" Margin="0,0,10,8" />
                  <Button Content="{Binding S[saves.conflict_not_now]}" Click="OnSeedCloseChoice" Style="{StaticResource LinkButton}" Margin="0,0,0,8" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          </Grid>
          <!-- CR-L39: a custom server's pinned keys changed; this covers every screen until the player answers. -->
          <Grid x:Name="TrustChangePrompt" Panel.ZIndex="5" Background="{StaticResource InfinityBackground}" Visibility="{Binding ShowTrustChange, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Padding="24,20" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="{Binding S[server.keys_changed_title]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Text="{Binding TrustChangeText}" TextWrapping="Wrap" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding S[server.keys_reject]}" Click="OnTrustReject" Style="{StaticResource AccentButtonStyle}" Padding="18,6" />
                <Button Content="{Binding S[server.keys_accept]}" Click="OnTrustAccept" Margin="10,0,0,0" Padding="18,6" />
              </StackPanel>
            </StackPanel>
          </Border>
          </Grid>
          <!-- OD-74: native sign-in; the confirmation step owns its temporary credentials. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSignIn, Converter={StaticResource Visible}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <Border Style="{StaticResource Card}" Padding="28,24">
              <StackPanel>
                <Button Click="OnWelcome" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="-6,0,0,14" IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding S[welcome.back]}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconBack}" Style="{StaticResource InlineIcon}" Margin="0,0,6,0" /><TextBlock Text="{Binding S[welcome.back]}" VerticalAlignment="Center" /></StackPanel></Button>
                <TextBlock Text="{Binding S[signin.title]}" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Text="{Binding S[native.subtitle]}" Margin="0,6,0,20" Style="{StaticResource PageSubtitle}" />
                <!-- CR-L39: on a custom server the player sees where the sign-in goes and whether it is encrypted. -->
                <TextBlock Margin="0,-12,0,4" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityGold}"
                           Visibility="{Binding ShowServerSecurity, Converter={StaticResource Visible}}">
                  <Run Text="{Binding ServerChoiceText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ServerSecurityText, Mode=OneWay}" />
                </TextBlock>
                <!-- OD122-L9: the server and relay pickers are one step away from sign-in too. -->
                <Button Content="{Binding S[picker.change_server]}" Click="OnSignInServerChange" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                        Margin="-6,0,0,12" IsEnabled="{Binding CanChangeServer}" AutomationProperties.Name="{Binding S[picker.change_server]}" />
                <StackPanel Visibility="{Binding AwaitingVerification, Converter={StaticResource Hidden}}">
                  <TextBlock Text="{Binding S[native.email]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  <TextBox x:Name="EmailBox" Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" IsEnabled="{Binding CanStartOnlineAccount}" />
                  <TextBlock Text="{Binding S[native.password]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  <PasswordBox x:Name="PasswordBox" Margin="0,6,0,4" IsEnabled="{Binding CanStartOnlineAccount}" KeyDown="OnPasswordKey" IsVisibleChanged="OnPasswordVisibility" />
                  <!-- CR-S53: a local instance mails the password link too (it opens the server's own page). -->
                  <Button Content="{Binding S[native.forgot]}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,0,0,16" Click="OnForgot" IsEnabled="{Binding CanStartOnlineAccount}" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding S[native.sign_in]}" Click="OnNativeSignIn" IsEnabled="{Binding CanStartOnlineAccount}" Style="{StaticResource AccentButtonStyle}" />
                    <Button Grid.Column="2" Content="{Binding S[native.sign_up]}" Click="OnNativeSignUp" IsEnabled="{Binding CanCreateOnlineAccount}" />
                  </Grid>
                  <TextBlock Text="{Binding S[native.registration_disabled]}" Margin="0,12,0,0" TextWrapping="Wrap"
                             Visibility="{Binding ShowRegistrationDisabled, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Visibility="{Binding AwaitingVerification, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding S[native.check_title]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <TextBlock Text="{Binding VerificationText}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,18" />
                  <!-- CR-S53 follow-up: a local instance's mail carries a 6-digit code; the link in it stays the alternative. -->
                  <StackPanel Visibility="{Binding ShowConfirmationCode, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding S[native.code_label]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                    <TextBox x:Name="ConfirmationCodeBox" Text="{Binding ConfirmationCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" Width="160"
                             HorizontalAlignment="Left" FontSize="18" Margin="0,6,0,10" IsEnabled="{Binding CanStartOnlineAccount}" KeyDown="OnConfirmationCodeKey"
                             AutomationProperties.Name="{Binding S[native.code_label]}" />
                    <Button Content="{Binding S[native.code_submit]}" Click="OnSubmitConfirmationCode" IsEnabled="{Binding CanSubmitConfirmationCode}" Style="{StaticResource AccentButtonStyle}" />
                  </StackPanel>
                  <Button Content="{Binding S[native.confirmed]}" Click="OnConfirmed" IsEnabled="{Binding CanStartOnlineAccount}" Style="{StaticResource AccentButtonStyle}"
                          Visibility="{Binding ShowConfirmedButton, Converter={StaticResource Visible}}" />
                  <Button Content="{Binding S[native.resend]}" Margin="0,12,0,0" Click="OnResend" IsEnabled="{Binding CanStartOnlineAccount}" />
                  <Button Content="{Binding S[native.change_login]}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,12,0,0" Click="OnCancelVerification" IsEnabled="{Binding Idle}" />
                </StackPanel>
                <Button Content="{Binding S[signin.cancel]}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="OnCancelSignIn" Visibility="{Binding Busy, Converter={StaticResource Visible}}" />
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>

          <!-- New account: the first profile's name. -->
          <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460" Padding="28,24"
                  Visibility="{Binding ShowNeedsAccount, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding S[signin.title]}" Style="{StaticResource PageTitle}" FontSize="24" />
              <TextBlock Text="{Binding NeedsAccountText}" Margin="0,8,0,18" Style="{StaticResource PageSubtitle}" />
              <TextBlock Text="{Binding S[signin.form_name]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
              <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,6,0,4" />
              <TextBlock Text="{Binding S[profiles.name_rule]}" FontSize="11" Foreground="{StaticResource InfinityFaint}" />
              <Button Content="{Binding S[signin.create]}" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="28,9"
                      Click="OnCreateAccount" IsEnabled="{Binding CanCreateOnlineAccount}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </Border>

          <!-- Account self-service: explicit typed confirmation and a fresh password proof. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowAccount, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="560" HorizontalAlignment="Center" Margin="24">
              <TextBlock Text="{Binding S[nav.account]}" Style="{StaticResource PageTitle}" />
              <!-- CR-S63: the account's Discord link (verified by the bot's page) and each profile's announce switch. -->
              <Border x:Name="DiscordCard" Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0"
                      Visibility="{Binding ShowDiscord, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="{Binding S[discord.title]}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding S[discord.body]}" Style="{StaticResource PageSubtitle}" Margin="0,8,0,14" TextWrapping="Wrap" />
                  <!-- Linked: the avatar (the account's avatar; its initial until it loads) and the handle. -->
                  <DockPanel Visibility="{Binding HasDiscordLink, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                    <Grid Width="48" Height="48" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center">
                      <Ellipse Fill="{StaticResource InfinitySurfaceHigh}" />
                      <TextBlock Text="{Binding DiscordInitial}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Ellipse Visibility="{Binding HasDiscordAvatar, Converter={StaticResource Visible}}">
                        <Ellipse.Fill><ImageBrush ImageSource="{Binding DiscordAvatar}" Stretch="UniformToFill" /></Ellipse.Fill>
                      </Ellipse>
                    </Grid>
                    <Button DockPanel.Dock="Right" Content="{Binding S[discord.unlink]}" Click="OnUnlinkDiscord" IsEnabled="{Binding CanUseDiscord}"
                            VerticalAlignment="Center" Padding="14,6" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DiscordHandle}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DiscordLinkedText}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                    </StackPanel>
                  </DockPanel>
                  <Button Content="{Binding S[discord.link]}" Click="OnLinkDiscord" IsEnabled="{Binding CanUseDiscord}" HorizontalAlignment="Left"
                          Style="{StaticResource AccentButtonStyle}" Padding="18,8" Margin="0,0,0,10"
                          Visibility="{Binding ShowLinkDiscord, Converter={StaticResource Visible}}" />
                  <WrapPanel Visibility="{Binding DiscordWaiting, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                    <Button Content="{Binding S[discord.check]}" Click="OnCheckDiscord" Padding="14,6" Margin="0,0,10,0" />
                    <Button Content="{Binding S[discord.cancel]}" Click="OnCancelDiscordLink" Padding="14,6" />
                  </WrapPanel>
                  <TextBlock Text="{Binding DiscordStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityGold}" Margin="0,0,0,10"
                             Visibility="{Binding HasDiscordStatus, Converter={StaticResource Visible}}" />
                  <StackPanel Visibility="{Binding HasAnnounceSwitches, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding S[discord.announce_title]}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding AnnounceSwitches}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,4">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Announce, Mode=OneWay}" IsEnabled="{Binding Idle}" Click="OnAnnounceToggle"
                                      Content="{Binding DataContext.S[discord.announce], RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="{Binding Gamertag}" FontWeight="Bold" VerticalAlignment="Center" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding S[discord.announce_hint]}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityFaint}" Margin="0,6,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- CR-L47: each live profile's play-dashboard switch (hidden when the server sends no websiteListed). -->
              <Border x:Name="WebsiteCard" Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0"
                      Visibility="{Binding ShowWebsite, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="{Binding S[website.title]}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding WebsiteStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityGold}" Margin="0,8,0,0"
                             Visibility="{Binding HasWebsiteStatus, Converter={StaticResource Visible}}" />
                  <ItemsControl ItemsSource="{Binding WebsiteSwitches}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,4">
                          <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Listed, Mode=OneWay}" IsEnabled="{Binding Idle}" Click="OnWebsiteToggle"
                                    Content="{Binding DataContext.S[website.listed], RelativeSource={RelativeSource AncestorType=Window}}" />
                          <TextBlock Text="{Binding Gamertag}" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding S[website.hint]}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityFaint}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding S[account.delete_title]}" FontSize="20" FontWeight="SemiBold" />
                  <StackPanel Visibility="{Binding HasDeletionPending, Converter={StaticResource Hidden}}" IsEnabled="{Binding Idle}">
                    <TextBlock Text="{Binding S[account.delete_body]}" Style="{StaticResource PageSubtitle}" Margin="0,12,0,18" />
                    <TextBlock Text="{Binding S[native.email]}" />
                    <TextBox Text="{Binding DeletionEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />
                    <TextBlock Text="{Binding DeletionHint}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding DeletionConfirmation, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />
                    <TextBlock Text="{Binding S[account.delete_password]}" />
                    <PasswordBox x:Name="DeletionPasswordBox" Margin="0,6,0,18" IsVisibleChanged="OnPasswordVisibility" />
                    <Button Content="{Binding S[account.delete_submit]}" Click="OnRequestDeletion" IsEnabled="{Binding CanRequestDeletion}" HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Visibility="{Binding HasDeletionPending, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding DeletionPendingText}" Style="{StaticResource PageSubtitle}" Margin="0,12,0,18" />
                    <Button Content="{Binding S[account.delete_cancel]}" Click="OnCancelDeletion" IsEnabled="{Binding CanChangeIdentity}" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- OD-118: after sign-in, this PC's profiles that could go online (Update online profiles). Panel over the content. -->
          <Border x:Name="UpsertPanel" Panel.ZIndex="20" Style="{StaticResource Card}" Background="{StaticResource InfinitySurface}" MaxWidth="600"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22" KeyDown="OnUpsertPanelKey" Margin="0,16"
                  Visibility="{Binding ShowProfileUpsert, Converter={StaticResource Visible}}">
            <DockPanel>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button x:Name="UpsertUploadButton" Content="{Binding S[upsert.upload]}" Click="OnUploadProfiles" IsEnabled="{Binding CanUpload}"
                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0" />
                <Button Content="{Binding S[upsert.not_now]}" Click="OnCloseProfileUpsert" Padding="12,6" />
              </WrapPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{Binding S[upsert.title]}" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="{Binding UpsertIntro}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <StackPanel Margin="0,12,0,0" Visibility="{Binding HasUpsertAccountProfiles, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding S[upsert.on_account]}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                <ItemsControl ItemsSource="{Binding UpsertAccountProfiles}" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Margin="0,2,0,0" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="{Binding S[upsert.on_this_pc]}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,14,0,4" />
              <ItemsControl ItemsSource="{Binding UpsertRows}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                      <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanChange}" Content="{Binding Name}" FontWeight="Bold" />
                      <TextBlock Text="{Binding Line}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="24,4,0,0" />
                      <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityGold}" Margin="24,4,0,0" />
                      <!-- OD-120: the name was taken meanwhile: a new one, then Put them online again. -->
                      <StackPanel Margin="24,6,0,0" Visibility="{Binding AsksName, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding DataContext.S[upsert.new_name], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,4,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding UpsertSelectionText}" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,2,0,0" />
              <TextBlock Text="{Binding S[upsert.rules]}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
            </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <!-- OD-120: an account profile renamed by the plain-name backfill: one-time notice with the free rename. -->
          <Border x:Name="RenamePanel" Panel.ZIndex="20" Style="{StaticResource Card}" Background="{StaticResource InfinitySurface}" MaxWidth="560"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22" KeyDown="OnRenamePanelKey" Margin="0,16"
                  Visibility="{Binding ShowRenameNotice, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding S[rename.title]}" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="{Binding RenameNoticeText}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <Button x:Name="RenameKeepButton" Content="{Binding RenameKeepLabel}" Click="OnKeepRenamedName" IsEnabled="{Binding CanKeepName}"
                      Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" />
              <TextBlock Text="{Binding S[rename.new_name]}" FontSize="12" Margin="0,16,0,0" />
              <DockPanel Margin="0,4,0,0">
                <Button Content="{Binding S[rename.choose]}" Click="OnRenameProfile" IsEnabled="{Binding CanRename}" DockPanel.Dock="Right"
                        Padding="12,6" Margin="10,0,0,0" />
                <TextBox Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
              </DockPanel>
              <Button Content="{Binding S[rename.later]}" Click="OnRenameLater" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,14,0,0" />
            </StackPanel>
          </Border>

          <!-- OD-118: an online-only area on the offline path: centered "Offline mode" with the disconnect icon, and Sign in. -->
          <StackPanel x:Name="OfflinePane" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                      Visibility="{Binding ShowOfflinePane, Converter={StaticResource Visible}}">
            <Viewbox Width="72" Height="72" HorizontalAlignment="Center">
              <Path Data="{StaticResource OfflineIcon}" Stroke="{StaticResource InfinityMuted}" StrokeThickness="1.5" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Stretch="None" />
            </Viewbox>
            <TextBlock Text="{Binding S[offline.mode]}" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" />
            <TextBlock Text="{Binding S[offline.mode_hint]}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,8,0,0" Foreground="{StaticResource InfinityMuted}" />
            <Button Content="{Binding S[offline.sign_in]}" Click="OnOpenSignIn" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                    Margin="0,16,0,0" Padding="18,8" IsEnabled="{Binding Idle}" />
          </StackPanel>

          <!-- SAVE_MANAGER_UX.md (OD-207) under OD-214: the save manager is the Profiles page of a signed-in player (T-1111-AZIMUTH, the
               prototype's two peer cards: HARDCORE and AZIMUTH, one row per game under each with its own ⋯; History, Resolve, Copy, Delete,
               Help Sensei). ‹ Back + breadcrumb on every non-root screen; Esc and the mouse's back button do the same (MainWindow.xaml.cs). -->
          <Grid x:Name="SavesPage" Visibility="{Binding ShowSaveManager, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <!-- head: ‹ Back, the breadcrumb, the game; none at the root (owner 2026-11-08, INVITE_UX C: no stray "Saves" above "Profiles") -->
            <Border BorderBrush="{StaticResource SmLine}" BorderThickness="0,0,0,1" Padding="0,0,0,12" MinHeight="48"
                    Visibility="{Binding SavesCanGoBack, Converter={StaticResource Visible}}">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Content="{Binding S[sm.back]}" Style="{StaticResource SmButton}" Padding="12,6" Margin="0,0,14,0" FontSize="13"
                        Click="OnSavesBack" Visibility="{Binding SavesCanGoBack, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding S[sm.back]}" />
                <!-- owner 2026-11-08 (PROFILES_ROWS): no game pill here; a game row's action sets its game and the breadcrumb names it -->
                <!-- games-5: History's Refresh, small, at the right of the head row (out of the slot filters) -->
                <Button x:Name="HistoryRefresh" DockPanel.Dock="Right" Content="{Binding S[sm.history_refresh]}" Style="{StaticResource SmButton}" Padding="10,4" FontSize="12"
                        Margin="10,0,0,0" VerticalAlignment="Center" Click="OnHistoryRefresh" IsEnabled="{Binding Idle}"
                        Visibility="{Binding ShowSavesHistory, Converter={StaticResource Visible}}" />
                <TextBlock VerticalAlignment="Center" FontSize="15" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding SavesTrail, Mode=OneWay}" Foreground="{StaticResource InfinityMuted}" /><Run Text="{Binding SavesTrailLast, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
              </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
              <Grid Margin="0,22,4,18" MaxWidth="1040">

                <!-- ============ HOME: both profile cards as peers, HARDCORE ("the vanilla way") and AZIMUTH ("the sandbox way") ============ -->
                <StackPanel Visibility="{Binding ShowSavesHome, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding S[nav.profiles]}" Style="{StaticResource PageTitle}" FontSize="26" Margin="9,0,9,4" />
                  <TextBlock Text="{Binding SavesSubtitle}" Style="{StaticResource SmSub}" Margin="9,0,9,18" />
                  <ItemsControl ItemsSource="{Binding SaveCards}" Focusable="False" IsEnabled="{Binding Idle}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="9">
                          <Border MinHeight="290">
                            <Border.Style>
                              <Style TargetType="Border" BasedOn="{StaticResource SmCard}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Selected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{Binding Accent}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsExplainer}" Value="True">
                                    <Setter Property="Background" Value="{Binding Soft}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Grid>
                              <!-- the HARDCORE profile, or the AZIMUTH identity with this PC's Azimuth save: the same structure -->
                              <DockPanel Visibility="{Binding IsProfile, Converter={StaticResource Visible}}" LastChildFill="False">
                                <DockPanel DockPanel.Dock="Top">
                                  <Button DockPanel.Dock="Right" Content="⋯" Style="{StaticResource SmButton}" Width="38" Height="36" Padding="0" FontSize="18"
                                          Click="OnSavesMenu" Visibility="{Binding HasMenu, Converter={StaticResource Visible}}" AutomationProperties.Name="⋯" />
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModeLabel}" Foreground="{Binding Accent}" Style="{StaticResource SmModeTag}" />
                                    <Border Style="{StaticResource SmPill}" Margin="10,0,0,0" Visibility="{Binding Selected, Converter={StaticResource Visible}}">
                                      <TextBlock Text="{Binding DataContext.S[sm.selected], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                                    </Border>
                                  </StackPanel>
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                                  <Grid DockPanel.Dock="Left" Width="64" Height="64" VerticalAlignment="Top">
                                    <Ellipse Fill="{Binding Soft}" Stroke="{Binding Accent}" StrokeThickness="2" />
                                    <TextBlock Text="{Binding Initial}" Foreground="{Binding Accent}" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Margin="2" Visibility="{Binding DataContext.HasDiscordAvatar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                                      <Ellipse.Fill><ImageBrush ImageSource="{Binding DataContext.DiscordAvatar, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill" /></Ellipse.Fill>
                                    </Ellipse>
                                  </Grid>
                                  <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Gamertag}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                </DockPanel>
                                <!-- owner 2026-11-08 (PROFILES_ROWS): one row per catalog game, the same fields on both cards (LV · CR · modified, or the
                                     empty state), its chip and its own ⋯ (a HARDCORE career's tools, or this PC's Azimuth save's) -->
                                <ItemsControl x:Name="ProfileGameRows" DockPanel.Dock="Top" ItemsSource="{Binding Games}" Margin="0,16,0,0" Focusable="False">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                          <Grid DockPanel.Dock="Left" Width="44" Height="44" VerticalAlignment="Center">
                                            <!-- the styled fallback (the catalog's short code on its accent) when the cover is missing -->
                                            <Border CornerRadius="6" Background="{Binding Soft}" BorderBrush="{Binding Accent}" BorderThickness="1"
                                                    Visibility="{Binding HasCover, Converter={StaticResource Hidden}}">
                                              <TextBlock Text="{Binding ShortCode}" Foreground="{Binding Accent}" FontSize="12" FontWeight="Black"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border CornerRadius="6" Visibility="{Binding HasCover, Converter={StaticResource Visible}}">
                                              <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                                            </Border>
                                          </Grid>
                                          <Button DockPanel.Dock="Right" Content="⋯" Style="{StaticResource SmButton}" Width="32" Height="30" Padding="0" FontSize="15"
                                                  VerticalAlignment="Center" Margin="8,0,0,0" Click="OnGameRowMenu" Visibility="{Binding HasMenu, Converter={StaticResource Visible}}"
                                                  AutomationProperties.Name="{Binding Name}" />
                                          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                          <DockPanel>
                                          <!-- the game's chip, beside its name (the fields below get the row's whole width): plain words, a green or amber dot -->
                                          <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" Background="#0DFFFFFF" VerticalAlignment="Center"
                                                  MaxWidth="220" Visibility="{Binding HasChip, Converter={StaticResource Visible}}" ToolTip="{Binding ChipTip}">
                                            <StackPanel Orientation="Horizontal">
                                              <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{x:Static local:SlotBrushes.Good}"
                                                       Visibility="{Binding ChipGood, Converter={StaticResource Visible}}" />
                                              <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource SmWarn}"
                                                       Visibility="{Binding ChipWarn, Converter={StaticResource Visible}}" />
                                              <TextBlock Text="{Binding ChipText}" FontSize="11" TextWrapping="Wrap" MaxWidth="190">
                                                <TextBlock.Style>
                                                  <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource InfinityMuted}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding ChipWarn}" Value="True"><Setter Property="Foreground" Value="{StaticResource SmWarn}" /></DataTrigger></Style.Triggers>
                                                  </Style>
                                                </TextBlock.Style>
                                              </TextBlock>
                                            </StackPanel>
                                          </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                          </DockPanel>
                                            <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                       ToolTip="{Binding LineTipText}" />
                                          </StackPanel>
                                        </DockPanel>
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Note}" FontSize="12" Foreground="{StaticResource InfinityGold}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Hint}" Style="{StaticResource SmHint}" Margin="0,12,0,0" />
                              </DockPanel>
                              <!-- no profile of this mode: the explainer -->
                              <StackPanel Visibility="{Binding IsExplainer, Converter={StaticResource Visible}}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModeLabel}" Foreground="{Binding Accent}" Style="{StaticResource SmModeTag}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ExplainTitle}" FontSize="22" FontWeight="Bold" Margin="0,10,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExplainBody}" Style="{StaticResource SmHint}" FontSize="14" MaxWidth="400" MinHeight="64" HorizontalAlignment="Left" />
                                <Button Content="{Binding CreateLabel}" Background="{Binding Accent}" Style="{StaticResource SmPrimary}" HorizontalAlignment="Left"
                                        Margin="0,18,0,0" IsEnabled="{Binding CreateEnabled}" Click="OnSavesCreate" />
                                <TextBlock Text="{Binding CreateNote}" Style="{StaticResource SmHint}" Margin="0,10,0,0" Visibility="{Binding HasCreateNote, Converter={StaticResource Visible}}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- the last old Noob save copy or export (an AZIMUTH row's ⋯): what happened, with the backup's path or the file -->
                  <Border Style="{StaticResource SmNote}" Margin="9,14,9,0" Visibility="{Binding HasOldSaveResult, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding OldSaveResultText}" TextWrapping="Wrap" />
                  </Border>
                  <Border Style="{StaticResource SmNote}" Margin="9,14,9,0" Visibility="{Binding ShowGameRunningNote, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding GameRunningText}" Foreground="{StaticResource SmWarn}" TextWrapping="Wrap" />
                  </Border>

                </StackPanel>

                <!-- ============ CREATE: a profile of a mode the account has none of ============ -->
                <StackPanel MaxWidth="620" Visibility="{Binding ShowSavesCreate, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding CreateTitle}" Style="{StaticResource SmH1}" />
                  <TextBlock Text="{Binding CreateSub}" Style="{StaticResource SmSub}" />
                  <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" FontSize="16" Padding="10,8"
                           AutomationProperties.Name="{Binding CreateTitle}" />
                  <TextBlock Text="{Binding S[profiles.name_rule]}" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource InfinityFaint}" />
                  <TextBlock Text="{Binding AzimuthNameWarning}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding ShowAzimuthNameWarning, Converter={StaticResource Visible}}" />
                  <Border Style="{StaticResource SmNote}" Visibility="{Binding ShowSeedOption, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <CheckBox Content="{Binding S[seed.option]}" IsChecked="{Binding NewSeedFromProfile}" FontWeight="Bold" />
                      <TextBlock Text="{Binding S[seed.warning]}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" />
                      <ListBox Margin="0,8,0,0" ItemsSource="{Binding SeedSources}" SelectedItem="{Binding NewSeedSource}" MaxHeight="160"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding NewSeedFromProfile, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Border>
                  <WrapPanel Margin="0,18,0,0">
                    <Button Content="{Binding S[sm.create_confirm]}" Background="{Binding CreateAccent}" Style="{StaticResource SmPrimary}" Click="OnCreateProfile" IsEnabled="{Binding Idle}" />
                    <Button Content="{Binding S[sm.cancel]}" Style="{StaticResource SmButton}" Margin="10,0,0,0" Click="OnSavesBack" />
                  </WrapPanel>
                </StackPanel>

                <!-- owner 2026-11-08: a career starts on PLAY (its inline choice), never on the Profiles page -->

                <!-- ============ PICK: "Use another save on this PC…" (owner 2026-11-11), every save of the game here, the pick becomes the Azimuth save ============ -->
                <StackPanel x:Name="OtherSavePicker" MaxWidth="860" Visibility="{Binding ShowSavesPick, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding PickTitle}" Style="{StaticResource SmH1}" />
                  <TextBlock Text="{Binding PickSub}" Style="{StaticResource SmSub}" />
                  <!-- azimuth9: first, a folder from anywhere (the launcher's own picker), then a divider, then the saves this PC has -->
                  <Border x:Name="PickFolderCard" Style="{StaticResource SmCard}" Margin="0,0,0,10" Padding="16,12">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="{Binding S[othersave.browse]}" Style="{StaticResource SmButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                              Click="OnPickOtherSaveFolder" IsEnabled="{Binding CanUseOtherSave}" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding S[othersave.pick_folder]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding S[othersave.pick_folder_hint]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SmNote}" Visibility="{Binding HasOldSaveResult, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding OldSaveResultText}" Foreground="{StaticResource SmWarn}" TextWrapping="Wrap" />
                  </Border>
                  <Border BorderBrush="{StaticResource SmLine}" BorderThickness="0,1,0,0" Margin="0,8,0,12" />
                  <TextBlock Text="{Binding S[othersave.group_profiles]}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                  <TextBlock Text="{Binding S[othersave.none]}" Style="{StaticResource SmHint}" Visibility="{Binding PickEmpty, Converter={StaticResource Visible}}" />
                  <ItemsControl ItemsSource="{Binding PickRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SmCard}" Margin="0,0,0,10" Padding="16,12">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding DataContext.S[othersave.use], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SmButton}" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnUseOtherSave"
                                    IsEnabled="{Binding DataContext.CanUseOtherSave, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}" />
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                              <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LineTip}" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- the launcher's backups: collapsed by default, newest first, each saying what it kept and why -->
                  <DockPanel Margin="0,10,0,8" Visibility="{Binding HasPickBackups, Converter={StaticResource Visible}}">
                    <Button x:Name="PickBackupsToggle" DockPanel.Dock="Right" Content="{Binding PickBackupsToggle}" Style="{StaticResource SmButton}" Padding="10,4" FontSize="12"
                            Click="OnTogglePickBackups" />
                    <TextBlock Text="{Binding PickBackupsHeader}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding PickBackupRows}" Focusable="False" Visibility="{Binding PickBackupsOpen, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SmCard}" Margin="0,0,0,10" Padding="16,12">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding DataContext.S[othersave.use], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource SmButton}" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnUseOtherSave"
                                    IsEnabled="{Binding DataContext.CanUseOtherSave, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}" />
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LineTip}" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Style="{StaticResource SmNote}"><TextBlock Text="{Binding S[othersave.note]}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" /></Border>
                  <Border Style="{StaticResource SmNote}" Visibility="{Binding ShowGameRunningNote, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding GameRunningText}" Foreground="{StaticResource SmWarn}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <!-- ============ HISTORY: one slot's timeline, this PC's entries and the cloud's revisions ============ -->
                <Grid Visibility="{Binding ShowSavesHistory, Converter={StaticResource Visible}}">
                  <!-- games-5: the list and the detail share the width (no fixed column), so nothing is cut at 1280 px or with FRIENDS open -->
                  <Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="240" /><ColumnDefinition Width="6*" MinWidth="240" /></Grid.ColumnDefinitions>
                  <DockPanel Margin="0,0,18,0">
                    <!-- the slot filters wrap; Refresh moved to the head row (right of the breadcrumb) -->
                    <WrapPanel x:Name="HistoryFilters" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                      <Button Content="{Binding S[sm.hardcore]}" Tag="Hardcore" Click="OnHistorySlot" Margin="0,0,6,6" FontWeight="SemiBold">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SmButton}"><Style.Triggers>
                          <DataTrigger Binding="{Binding HistoryHardcoreOn}" Value="True"><Setter Property="BorderBrush" Value="{x:Static local:SlotBrushes.Hardcore}" /><Setter Property="Foreground" Value="{x:Static local:SlotBrushes.Hardcore}" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                      </Button>
                      <Button Content="{Binding S[sm.azimuth]}" Tag="Azimuth" Click="OnHistorySlot" Margin="0,0,6,6" FontWeight="SemiBold">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SmButton}"><Style.Triggers>
                          <DataTrigger Binding="{Binding HistoryAzimuthOn}" Value="True"><Setter Property="BorderBrush" Value="{x:Static local:SlotBrushes.Azimuth}" /><Setter Property="Foreground" Value="{x:Static local:SlotBrushes.Azimuth}" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                      </Button>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding S[sm.history_empty]}" Style="{StaticResource SmHint}" Visibility="{Binding HistoryEmpty, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding HistoryRows}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Click="OnSelectHistory" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" Padding="12,10">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SmButton}"><Setter Property="Background" Value="{StaticResource SmCardSurface}" /><Style.Triggers>
                              <DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="BorderBrush" Value="{Binding DataContext.HistoryAccent, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                            <StackPanel HorizontalAlignment="Stretch">
                              <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource SmPill}" Margin="0,0,8,0"><TextBlock Text="{Binding Origin}" FontSize="11" Foreground="{StaticResource InfinityMuted}" /></Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                              </DockPanel>
                              <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                              <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource InfinityFaint}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                  <Border Grid.Column="1" Style="{StaticResource SmCard}" VerticalAlignment="Top" Visibility="{Binding HasHistorySelected, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding HistoryDetailTitle}" Foreground="{Binding HistoryAccent}" Style="{StaticResource SmModeTag}" HorizontalAlignment="Left" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding HistoryDetailHeadline}" FontSize="22" FontWeight="Bold" Margin="0,8,0,2" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding HistoryDetailLine}" Style="{StaticResource SmHint}" />
                      <WrapPanel Margin="0,16,0,0">
                        <Button Content="{Binding S[sm.menu.copy_azimuth]}" Style="{StaticResource SmButton}" Margin="0,0,8,8" Click="OnHistoryCopy" IsEnabled="{Binding HistoryCanCopyToAzimuth}" />
                        <Button Content="{Binding S[sm.open_explorer]}" Style="{StaticResource SmButton}" Margin="0,0,8,8" Click="OnHistoryOpenFolder"
                                Visibility="{Binding HistoryCanOpenFolder, Converter={StaticResource Visible}}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding HistoryCopyBlocked}" Style="{StaticResource SmHint}" FontSize="12" Visibility="{Binding HasHistoryCopyBlocked, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding HistoryCloudCopyNote}" Style="{StaticResource SmHint}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasHistoryCloudCopyNote, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding HistoryDetailNote}" Style="{StaticResource SmHint}" Margin="0,14,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- ============ DELETE: what is lost, the typed gamertag ============ -->
                <StackPanel MaxWidth="640" Visibility="{Binding ShowSavesDelete, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding DeleteProfileTitle}" Style="{StaticResource SmH1}" />
                  <TextBlock Text="{Binding DeleteProfileBody}" Style="{StaticResource SmSub}" Foreground="#FFFFC1C9" Margin="0,0,0,10" />
                  <TextBlock Text="{Binding DeleteProfileKeeps}" Style="{StaticResource SmHint}" />
                  <TextBlock Text="{Binding DeleteProfileTypeHint}" Margin="0,18,0,6" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBox Text="{Binding DeleteProfileTyped, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" FontSize="16" Padding="10,8"
                           AutomationProperties.Name="{Binding DeleteProfileTypeHint}" />
                  <TextBlock Text="{Binding DeleteProfileStatus}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding HasDeleteProfileStatus, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
                  <WrapPanel Margin="0,18,0,0">
                    <Button Content="{Binding S[profiles.delete_confirm]}" Style="{StaticResource SmDanger}" Click="OnConfirmDeleteProfile" IsEnabled="{Binding CanConfirmDeleteProfile}" />
                    <Button Content="{Binding S[profiles.delete_cancel]}" Style="{StaticResource SmButton}" Margin="10,0,0,0" Click="OnCancelDeleteProfile" />
                  </WrapPanel>
                  <TextBlock Text="{Binding DeleteRateNote}" Style="{StaticResource SmHint}" Margin="0,14,0,0" />
                </StackPanel>

                <!-- ============ HELP SENSEI ============ -->
                <StackPanel MaxWidth="780" Visibility="{Binding ShowSavesHelp, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding S[sm.help_title]}" Style="{StaticResource SmH1}" />
                  <TextBlock Text="{Binding S[sm.help_sub]}" Style="{StaticResource SmSub}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,18">
                    <Grid Width="124" Height="124">
                      <Ellipse Fill="{x:Static local:SlotBrushes.HardcoreSoft}" Stroke="{x:Static local:SlotBrushes.Hardcore}" StrokeThickness="2" />
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding S[sm.hardcore]}" Foreground="{x:Static local:SlotBrushes.Hardcore}" FontWeight="Black" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding S[sm.help.cloud]}" Foreground="{x:Static local:SlotBrushes.Hardcore}" FontSize="12" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="⇄" FontSize="22" Foreground="{StaticResource InfinityMuted}" VerticalAlignment="Center" Margin="16,0" />
                    <Grid Width="124" Height="124">
                      <Ellipse Fill="{x:Static local:SlotBrushes.AzimuthSoft}" Stroke="{x:Static local:SlotBrushes.Azimuth}" StrokeThickness="2" />
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding S[sm.azimuth]}" Foreground="{x:Static local:SlotBrushes.Azimuth}" FontWeight="Black" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding S[sm.help.pc]}" Foreground="{x:Static local:SlotBrushes.Azimuth}" FontSize="12" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{Binding S[sm.faq1_q]}" FontWeight="Bold" FontSize="15" Margin="0,8,0,4" />
                  <TextBlock Text="{Binding S[sm.faq1_a]}" Style="{StaticResource SmHint}" FontSize="14" />
                  <TextBlock Text="{Binding S[sm.faq2_q]}" FontWeight="Bold" FontSize="15" Margin="0,16,0,4" />
                  <TextBlock Text="{Binding S[sm.faq2_a]}" Style="{StaticResource SmHint}" FontSize="14" />
                  <TextBlock Text="{Binding S[sm.faq3_q]}" FontWeight="Bold" FontSize="15" Margin="0,16,0,4" />
                  <TextBlock Text="{Binding S[sm.faq3_a]}" Style="{StaticResource SmHint}" FontSize="14" />
                  <TextBlock Text="{Binding S[sm.faq4_q]}" FontWeight="Bold" FontSize="15" Margin="0,16,0,4" />
                  <TextBlock Text="{Binding S[sm.faq4_a]}" Style="{StaticResource SmHint}" FontSize="14" />
                  <WrapPanel Margin="0,20,0,0">
                    <Button Content="{Binding S[sm.restore_original]}" Style="{StaticResource SmButton}" Margin="0,0,10,8" Click="OnRestoreOriginal" IsEnabled="{Binding Idle}" />
                  </WrapPanel>
                </StackPanel>

                <!-- ============ DONE ============ -->
                <StackPanel MaxWidth="620" Margin="0,60,0,0" Visibility="{Binding ShowSavesDone, Converter={StaticResource Visible}}">
                  <TextBlock Text="✓" FontSize="40" Foreground="{x:Static local:SlotBrushes.Good}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding DoneText}" Style="{StaticResource SmH1}" TextAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding S[sm.done_sub]}" Style="{StaticResource SmSub}" TextAlignment="Center" HorizontalAlignment="Center" />
                  <Button Content="{Binding S[sm.back_to_saves]}" Background="{x:Static local:SlotBrushes.Azimuth}" Style="{StaticResource SmPrimary}" HorizontalAlignment="Center"
                          Click="OnSavesHome" />
                </StackPanel>
              </Grid>
            </ScrollViewer>
            <!-- foot: Help Sensei -->
            <Border Grid.Row="2" BorderBrush="{StaticResource SmLine}" BorderThickness="0,1,0,0" Padding="0,8,0,0"
                    Visibility="{Binding ShowHelpLink, Converter={StaticResource Visible}}">
              <Button Content="{Binding S[sm.help_link]}" Style="{StaticResource SmLink}" HorizontalAlignment="Center" Click="OnOpenSavesHelp" />
            </Border>
          </Grid>

          <!-- Owner 2026-11-08: the Profiles page of the offline path and of a server before CR-S98: list, create, delete (no Play here). -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowPlainProfiles, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" Margin="0,8">
              <TextBlock Text="{Binding S[nav.profiles]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding ProfilesText}" Margin="0,8,0,14" Style="{StaticResource PageSubtitle}" />
              <!-- owner 2026-11-10: the rows as drawn, following ProfileRows a few per frame (ShellViewModel.CardSame.cs) -->
              <ItemsControl ItemsSource="{Binding ProfileRowsShown}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <!-- The card button spans both columns; its text sits in column 0 (wraps) and the links get column 1, so they never overlap. -->
                      <Border Grid.ColumnSpan="2" Style="{StaticResource SmCard}" Padding="20,14" MinHeight="64" />
                      <StackPanel Grid.Column="0" Margin="20,14,10,14" IsHitTestVisible="False" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Gamertag}" FontWeight="Bold" FontSize="16" />
                          <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
                          <!-- CR-S63: the account's Discord link shows on every profile of the account. -->
                          <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding OnAccount, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding DataContext.HasDiscordLink, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                              <Grid Width="18" Height="18" Margin="0,0,6,0">
                                <Ellipse Fill="{StaticResource InfinitySurfaceHigh}" />
                                <TextBlock Text="{Binding DataContext.DiscordInitial, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Visibility="{Binding DataContext.HasDiscordAvatar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                                  <Ellipse.Fill><ImageBrush ImageSource="{Binding DataContext.DiscordAvatar, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill" /></Ellipse.Fill>
                                </Ellipse>
                              </Grid>
                              <TextBlock Text="{Binding DataContext.DiscordHandle, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12"
                                         VerticalAlignment="Center" Foreground="{StaticResource InfinityMuted}" />
                            </StackPanel>
                          </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" MaxWidth="280" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                        <!-- CR-S61: an account profile can be deleted from the cloud (a typed confirmation below). -->
                        <Button Content="{Binding DataContext.S[profiles.delete], RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Click="OnDeleteProfile" Visibility="{Binding CanDeleteFromCloud, Converter={StaticResource Visible}}"
                                IsEnabled="{Binding DataContext.CanAskDeleteProfile, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <!-- W12: the cloud career's newest revision onto this PC (what is there archived first). -->
                        <Button Content="{Binding DataContext.S[careers.download], RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Click="OnDownloadCareer" Visibility="{Binding CanDownload, Converter={StaticResource Visible}}"
                                IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <!-- CR-S98 (OD-207): delete the chosen game's career, or the whole profile (every game); both typed. -->
                        <Button Content="{Binding DeleteCareerLabel}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Click="OnDeleteProfile" Visibility="{Binding CanDeleteCareer, Converter={StaticResource Visible}}"
                                IsEnabled="{Binding DataContext.CanAskDeleteProfile, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="{Binding DataContext.S[careers.delete_profile], RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Click="OnDeleteWholeProfile" Visibility="{Binding CanDeleteWholeProfile, Converter={StaticResource Visible}}"
                                IsEnabled="{Binding DataContext.CanAskDeleteProfile, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding ShowNewProfile, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="{Binding S[profiles.new]}" Style="{StaticResource SectionTag}" FontSize="12" />
                  <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding CreateProfileLabel}" Margin="10,0,0,0"
                            Click="OnCreateProfile" IsEnabled="{Binding Idle}" Style="{StaticResource AccentButtonStyle}" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                  </DockPanel>
                  <TextBlock Text="{Binding S[profiles.name_rule]}" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource InfinityFaint}" />
                  <!-- Owner 2026-10-26: the name is Azimuth's own player; a Noob profile adopts that career, a Hardcore one needs another name. -->
                  <TextBlock Text="{Binding AzimuthNameWarning}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding ShowAzimuthNameWarning, Converter={StaticResource Visible}}" />
                  <!-- OD-60: Hardcore (a new career the game seeds; cloud per the server's CR-S51 flags) or Noob (the offline save). -->
                  <StackPanel Margin="0,14,0,0" Visibility="{Binding CanChooseHardcore, Converter={StaticResource Visible}}">
                    <RadioButton Content="{Binding S[signin.form_hardcore]}" IsChecked="{Binding NewHardcore}" GroupName="NewMode" FontWeight="Bold" />
                    <TextBlock Text="{Binding HardcoreHint}" FontSize="11" Margin="30,2,0,10" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                    <!-- CR-S52: on a server that allows it, the Hardcore profile may start from one of the account's Noob careers, checked on the spot.
                         The owner's warning shows with the option, before anything is chosen. -->
                    <Border Margin="30,0,0,12" Padding="12,10" CornerRadius="8" Background="{StaticResource InfinityWarnSurface}"
                            Visibility="{Binding ShowSeedOption, Converter={StaticResource Visible}}">
                      <StackPanel>
                        <CheckBox Content="{Binding S[seed.option]}" IsChecked="{Binding NewSeedFromProfile}" FontWeight="Bold" />
                        <TextBlock Text="{Binding S[seed.warning]}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" />
                        <ListBox Margin="0,8,0,0" ItemsSource="{Binding SeedSources}" SelectedItem="{Binding NewSeedSource}" MaxHeight="160"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding S[seed.source_label]}"
                                 Visibility="{Binding NewSeedFromProfile, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding S[seed.option_hint]}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}"
                                   Visibility="{Binding NewSeedFromProfile, Converter={StaticResource Visible}}" />
                      </StackPanel>
                    </Border>
                    <RadioButton Content="{Binding S[signin.form_noob]}" IsChecked="{Binding NewNoob}" GroupName="NewMode" FontWeight="Bold" IsEnabled="{Binding CanChooseNoob}" />
                    <TextBlock Text="{Binding NoobHint}" FontSize="11" Margin="30,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                  </StackPanel>
                  <TextBlock Text="{Binding FreeNoobHint}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}"
                             Visibility="{Binding ShowFreeNoobHint, Converter={StaticResource Visible}}" />
                <!-- OD-118: offline creation is Noob; Hardcore is created signed in. -->
                <TextBlock Text="{Binding S[offline.create_noob]}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}"
                           Visibility="{Binding OfflineMode, Converter={StaticResource Visible}}" />
                </StackPanel>
              </Border>
              <!-- CR-S61: delete an account profile from the cloud, at once and for good; the player types its name to confirm. -->
              <Border x:Name="DeleteProfilePanel" Margin="0,16,0,0" Padding="18,16" CornerRadius="12" Background="{StaticResource InfinityDangerSurface}"
                      BorderBrush="{StaticResource InfinityDangerBorder}" BorderThickness="1"
                      Visibility="{Binding ShowDeleteProfile, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="{Binding DeleteProfileTitle}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DeleteProfileBody}" Margin="0,6,0,6" TextWrapping="Wrap" Foreground="{StaticResource InfinityRose}" />
                  <TextBlock Text="{Binding DeleteProfileKeeps}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding DeleteProfileTypeHint}" Margin="0,12,0,4" TextWrapping="Wrap" />
                  <TextBox Text="{Binding DeleteProfileTyped, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                           AutomationProperties.Name="{Binding DeleteProfileTypeHint}" />
                  <TextBlock Text="{Binding DeleteProfileStatus}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding HasDeleteProfileStatus, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{Binding S[profiles.delete_confirm]}" Click="OnConfirmDeleteProfile" IsEnabled="{Binding CanConfirmDeleteProfile}"
                            BorderBrush="{StaticResource InfinityDangerBorder}" />
                    <Button Content="{Binding S[profiles.delete_cancel]}" Margin="10,0,0,0" Click="OnCancelDeleteProfile"
                            Style="{StaticResource AccentButtonStyle}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- PLAY: admission happens here; the game starts only with a verified active ticket. -->
          <!-- Owner 2026-11-08: no news on PLAY; news lives only on the NEWS page (sidebar). -->
          <Grid x:Name="HomeArea" Visibility="{Binding ShowHome, Converter={StaticResource Visible}}">
          <!-- owner 2026-11-12 (PLAY must fit): the column is laid out at its design width and scaled down as a whole when the window is smaller
               (never up, never a scrollbar), so both profile cards and their PLAY buttons stay in view at the minimum window size. -->
          <Viewbox x:Name="HomeFit" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="PlayColumn" Width="680" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,4">
              <!-- Owner 2026-11-08 (the PLAY revamp; games-5 after the wireframe): one centered column: our logo, the game tiles, one button per
                   profile, "manage profiles". -->
              <Image x:Name="PlayLogo" Source="{StaticResource BrandLogo}" Width="300" HorizontalAlignment="Center" Margin="0,0,0,4"
                     RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding PlayTitle}" />
              <!-- every catalog game (PlayTiles): its cover (OD-217, shipped in the package) or the styled tile, the name small under it; a game
                   this Azimuth install lacks is dimmed with the reason. A horizontal scrollbar when they overflow. -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,4" PanningMode="HorizontalOnly"
                            HorizontalAlignment="Center" Focusable="False" IsEnabled="{Binding Idle}">
                <ItemsControl ItemsSource="{Binding GameCards}" Focusable="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="OnSelectGameTile" IsEnabled="{Binding Enabled}" Width="140" Margin="8,0,8,10" Cursor="Hand" VerticalAlignment="Top"
                              FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}" ToolTipService.ShowOnDisabled="True">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <StackPanel Background="Transparent">
                              <Grid Width="140" Height="140">
                                <Grid x:Name="Art">
                                  <Border CornerRadius="14" Background="{StaticResource SmCardSurface}" />
                                  <!-- the styled tile: no cover file, or one that did not decode -->
                                  <Grid Visibility="{Binding HasCover, Converter={StaticResource Hidden}}">
                                    <Border x:Name="Glow" CornerRadius="14" Background="{Binding Soft}" Opacity="0" Margin="1" />
                                    <Border CornerRadius="0,0,14,14" Height="4" VerticalAlignment="Bottom" Margin="1" Background="{Binding Accent}" Opacity="0.85" />
                                    <StackPanel Margin="18,16,18,14" VerticalAlignment="Top">
                                      <TextBlock Text="{Binding ShortCode}" FontSize="36" FontWeight="Black" Foreground="{Binding Accent}" />
                                      <TextBlock Text="{Binding Tagline}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfinityMuted}" />
                                    </StackPanel>
                                  </Grid>
                                  <Border CornerRadius="14" Visibility="{Binding HasCover, Converter={StaticResource Visible}}">
                                    <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                                  </Border>
                                </Grid>
                                <Border x:Name="Ring" CornerRadius="14" BorderBrush="{StaticResource SmLine}" BorderThickness="1" />
                              </Grid>
                              <TextBlock x:Name="Name" Text="{Binding Title}" Margin="0,8,0,0" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                         Foreground="{StaticResource InfinityMuted}" />
                              <TextBlock Text="{Binding Reason}" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                         Foreground="{StaticResource InfinityFaint}" Visibility="{Binding HasReason, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource InfinityMuted}" /></Trigger>
                              <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{Binding Accent}" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="3" />
                                <Setter TargetName="Glow" Property="Opacity" Value="1" />
                                <Setter TargetName="Name" Property="Foreground" Value="{StaticResource InfinityText}" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                              </DataTrigger>
                              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Art" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Visibility="{Binding ShowPlayAction, Converter={StaticResource Visible}}">
                <!-- Owner 2026-11-12 (first-hand, WINDOWS chat): PLAY holds only the logo, the game tiles, this ONE notice line, the profile cards and
                     "manage profiles". Information is this line (the most important message first, "+N more" with the others as its tooltip,
                     ShellViewModel.PlayNotice.cs); a decision is a centred popup (the former-Noob choice, START CAREER, a save copy's confirmation).
                     OD-118 T1c: it wraps, so it is never clipped at 1172x746 in pt-BR. -->
                <StackPanel x:Name="PlayNoticeLine" Margin="0,0,0,14" HorizontalAlignment="Center" Visibility="{Binding HasPlayNotice, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding PlayNotice}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Center" TextAlignment="Center"
                             Foreground="{StaticResource InfinityGold}" AutomationProperties.LiveSetting="Polite" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button x:Name="PlayNoticeLink" Content="{Binding PlayNoticeActionLabel}" Style="{StaticResource SmLink}" Click="OnPlayNoticeAction"
                            IsEnabled="{Binding PlayNoticeActionEnabled}" Margin="0,0,12,0" Visibility="{Binding HasPlayNoticeAction, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding PlayNoticeMore}" ToolTip="{Binding PlayNoticeMoreTip}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource InfinityFaint}" Visibility="{Binding HasPlayNoticeMore, Converter={StaticResource Visible}}" />
                  </StackPanel>
                </StackPanel>
                <!-- one button per profile: its career in the selected game, then PLAY {MODE} (or start / create / resolve / not offered) -->
                <ItemsControl x:Name="PlayButtonsRow" ItemsSource="{Binding PlayButtons}" Focusable="False" IsEnabled="{Binding CanUsePlayButtons}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="OnPlayButton" IsEnabled="{Binding Enabled}" Margin="7,0" MinHeight="150" Cursor="Hand"
                              FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" CornerRadius="16" Background="{StaticResource SmCardSurface}" BorderBrush="{Binding Accent}" BorderThickness="1.5" Padding="20,16">
                              <DockPanel LastChildFill="False">
                                <DockPanel DockPanel.Dock="Top">
                                  <Grid DockPanel.Dock="Left" Width="40" Height="40" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding Soft}" Stroke="{Binding Accent}" StrokeThickness="1.5" />
                                    <TextBlock Text="{Binding Initial}" Foreground="{Binding Accent}" FontSize="16" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Grid>
                                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModeLabel}" Foreground="{Binding Accent}" Style="{StaticResource SmModeTag}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Gamertag}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InfinityText}"
                                               Visibility="{Binding HasGamertag, Converter={StaticResource Visible}}" />
                                  </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Stats}" ToolTip="{Binding StatsHover}" Margin="0,12,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InfinityText}"
                                           TextTrimming="CharacterEllipsis" Visibility="{Binding HasStats, Converter={StaticResource Visible}}" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Note}" Margin="0,10,0,0" Style="{StaticResource SmHint}"
                                           Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                <Border x:Name="Action" DockPanel.Dock="Bottom" Margin="0,12,0,0" CornerRadius="10" Background="{Binding Accent}" Padding="14,11">
                                  <TextBlock x:Name="ActionText" Text="{Binding Title}" Foreground="#FF071018" FontWeight="Black" FontSize="17" HorizontalAlignment="Center" TextWrapping="Wrap"
                                             TextAlignment="Center" />
                                </Border>
                              </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource SmCardRaised}" /></Trigger>
                              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
                              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Action" Property="Opacity" Value="0.8" /></Trigger>
                              <!-- games-5: a disabled button (the game has no such mode, a game running, no Azimuth) is clearly off: grey, no accent, no
                                   hover; its reason is the line above (Note). Last, so it wins over the hover. -->
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource SmCardSurface}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SmLine}" />
                                <Setter TargetName="Action" Property="Background" Value="#FF2B2631" />
                                <Setter TargetName="ActionText" Property="Foreground" Value="{StaticResource InfinityFaint}" />
                                <Setter Property="Opacity" Value="0.75" />
                                <Setter Property="Cursor" Value="Arrow" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{Binding S[play.manage_profiles]}" Style="{StaticResource SmLink}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnNavProfiles" />
              </StackPanel>
              <!-- owner 2026-11-10 (3.1.1): the queue is a modal over the whole window (QueueOverlay, below), no longer a card here -->
            </StackPanel>
            </Grid>
          </Viewbox>
          </Grid>

          <!-- OD-119: News, the same feed (offline too); an item opens here with Back. T3b (Alex): read on black, with an almost
               invisible bundled pattern, full-bleed over the content area. -->
          <Border Margin="-40,-28,-40,-16" Background="{StaticResource NewsReadingBackground}" Visibility="{Binding ShowNews, Converter={StaticResource Visible}}">
          <Border.Resources>
            <SolidColorBrush x:Key="NewsCardSurface" Color="#111111" />
          </Border.Resources>
          <Grid>
          <Rectangle Fill="{StaticResource NewsReadingPattern}" IsHitTestVisible="False" />
          <Grid Margin="40,28,40,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowNewsList, Converter={StaticResource Visible}}">
              <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{Binding S[news.title]}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding NewsStatus}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,8,0,0"
                           Visibility="{Binding HasNewsStatus, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
                <ItemsControl ItemsSource="{Binding NewsCards}" ItemTemplate="{StaticResource NewsCardTemplate}" Margin="0,16,0,0" Focusable="False" />
              </StackPanel>
            </ScrollViewer>
            <DockPanel Visibility="{Binding ShowNewsDetail, Converter={StaticResource Visible}}" MaxWidth="820" HorizontalAlignment="Left" KeyDown="OnNewsKey">
              <Button x:Name="NewsBackButton" DockPanel.Dock="Top" Click="OnNewsBack" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconBack}" Style="{StaticResource InlineIcon}" Width="14" Height="14" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding S[news.back]}" />
                </StackPanel>
              </Button>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" TextWrapping="Wrap" MaxWidth="760" local:EmojiText.Text="{Binding NewsOpen.Title}"
                         HorizontalAlignment="Left" Foreground="{StaticResource NewsReadingHeading}" />
              <TextBlock DockPanel.Dock="Top" Text="{Binding NewsOpen.Date}" Foreground="{StaticResource NewsReadingMuted}" Margin="0,8,0,20" />
              <FlowDocumentScrollViewer x:Name="NewsDocumentViewer" Document="{Binding NewsDocument}" VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Focusable="True" />
            </DockPanel>
          </Grid>
          </Grid>
          </Border>

          <!-- ============ CRASH (OD-241): exactly two buttons, Ignore and Get logs; nothing is sent to a server. -->
          <ScrollViewer x:Name="CrashPage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowCrashReport, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="{Binding S[crash.title]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding S[crash.intro]}" Style="{StaticResource PageSubtitle}" Margin="0,8,0,20" TextWrapping="Wrap" />
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CrashWhen}" Foreground="{StaticResource InfinityMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding CrashCode}" FontWeight="Bold" FontSize="20" />
                  </DockPanel>
                  <TextBlock Text="{Binding CrashLocation}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding CrashEarlierNote}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" Margin="0,8,0,0"
                             Visibility="{Binding HasCrashEarlier, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding S[crash.participants]}" FontWeight="Bold" Margin="0,16,0,0" />
                  <TextBlock Text="{Binding CrashParticipants}" TextWrapping="Wrap" Margin="0,6,0,8" />
                  <TextBlock Text="{Binding CrashContextNote}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding S[crash.blame_unknown]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" Margin="0,0,0,16" />
                  <TextBlock Text="{Binding S[crash.logs_help]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding CrashStatus}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                             Visibility="{Binding HasCrashStatus, Converter={StaticResource Visible}}" />
                  <WrapPanel Margin="0,20,0,0">
                    <Button Content="{Binding S[crash.get_logs]}" Click="OnGetCrashLogs" IsEnabled="{Binding CanHandleCrash}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{Binding S[crash.ignore]}" Click="OnIgnoreCrash" IsEnabled="{Binding CanHandleCrash}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ FOUND A BUG? (OD-241): one "Get launcher logs" button, the crash screen's collector. -->
          <ScrollViewer x:Name="BugPage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowBugReport, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="740" HorizontalAlignment="Left">
              <TextBlock Text="{Binding S[bugs.eyebrow]}" Style="{StaticResource SectionTag}" />
              <TextBlock Text="{Binding S[bugs.title]}" Style="{StaticResource PageTitle}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding S[bugs.intro]}" Style="{StaticResource PageSubtitle}" Margin="0,8,0,24" TextWrapping="Wrap" />
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{Binding S[bugs.how]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="{StaticResource InfinityGold}" />
                  <Button Content="{Binding S[bugs.get_logs]}" Click="OnGetLauncherLogs" IsEnabled="{Binding CanGetLauncherLogs}" Style="{StaticResource AccentButtonStyle}"
                          HorizontalAlignment="Left" Margin="0,18,0,0" />
                  <TextBlock Text="{Binding LogsStatus}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                             Visibility="{Binding HasLogsStatus, Converter={StaticResource Visible}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Configure: independent Azimuth and game integrity checks. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSetup, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding S[setup.title]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding S[configure.intro]}" Margin="0,6,0,18" Style="{StaticResource PageSubtitle}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

              <Border Grid.Column="0" VerticalAlignment="Top">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers>
                  <DataTrigger Binding="{Binding AzimuthCardReady}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource InfinityGood}" /></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <StackPanel>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="AZIMUTH" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite">
                      <Path Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="18" Height="18" StrokeThickness="2.6" Stroke="{StaticResource InfinityGood}" Margin="0,0,8,0" Visibility="{Binding AzimuthCardReady, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding AzimuthCardStatus}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding SetupSummary}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding HookLine}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                  <DockPanel Margin="0,4">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="14" Height="14" Margin="0,0,10,0" StrokeThickness="2.4" Stroke="{StaticResource InfinityGood}" Visibility="{Binding AzimuthFound, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding AzimuthFound, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding SetupFoundLine}" TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="14" Height="14" Margin="0,0,10,0" StrokeThickness="2.4" Stroke="{StaticResource InfinityGood}" Visibility="{Binding AzimuthVersionOk, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding AzimuthVersionOk, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding SetupVersionLine}" TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="14" Height="14" Margin="0,0,10,0" StrokeThickness="2.4" Stroke="{StaticResource InfinityGood}" Visibility="{Binding HookOk, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding HookOk, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding SetupHookLine}" TextWrapping="Wrap" />
                  </DockPanel>
                  <!-- OD-125/127: ExtraOptions.Infinity is the hook's winmm.dll; another ExtraOptions there asks for Reinstall. -->
                  <DockPanel Margin="0,4">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="14" Height="14" Margin="0,0,10,0" StrokeThickness="2.4" Stroke="{StaticResource InfinityGood}" Visibility="{Binding ExtraOptionsOk, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding ExtraOptionsOk, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding SetupExtraOptionsLine}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding HookPackageProblem}" Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding HasHookPackageProblem, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding EoAzimuthText}" Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding EoAzimuthMismatch, Converter={StaticResource Visible}}" />
                  <WrapPanel Margin="0,16,0,0">
                    <Button Margin="0,0,10,0" Click="OnInstallHook" AutomationProperties.Name="{Binding HookInstallLabel}"
                            Style="{StaticResource AccentButtonStyle}" Visibility="{Binding CanInstallHook, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding HookInstallLabel}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                    <Button Content="{Binding S[setup.choose]}" Click="OnChooseAzimuth" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[setup.recheck]}" Click="OnRecheckAzimuth" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8" />
                    <!-- Owner 2026-10-28: Azimuth's own launcher, to change the game's settings there. -->
                    <Button Content="{Binding S[setup.launch_azimuth]}" Click="OnLaunchAzimuthDirectly" IsEnabled="{Binding CanLaunchAzimuthDirectly}"
                            Padding="10,5" FontSize="12" Margin="0,0,0,8" ToolTip="{Binding S[setup.launch_azimuth_hint]}" />
                  </WrapPanel>
                  <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,8,0,0" Click="OnOpenAzimuthPage" AutomationProperties.Name="{Binding S[setup.grab]}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding S[setup.grab]}" VerticalAlignment="Center" /><Path Data="{StaticResource IconExternal}" Style="{StaticResource InlineIcon}" Margin="6,0,0,0" /></StackPanel></Button>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" VerticalAlignment="Top">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers>
                  <DataTrigger Binding="{Binding IntegrityReady}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource InfinityGood}" /></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <StackPanel>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding S[integrity.title]}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite">
                      <Path Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="18" Height="18" StrokeThickness="2.6" Stroke="{StaticResource InfinityGood}" Margin="0,0,8,0" Visibility="{Binding IntegrityReady, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding IntegrityCardStatus}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding IntegrityStatus}" TextWrapping="Wrap" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding IntegrityFindings}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding IntegrityLocationLabel}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8" Foreground="{StaticResource InfinityMuted}" />
                  <WrapPanel>
                    <Button Content="{Binding S[integrity.choose]}" Click="OnChooseContent" IsEnabled="{Binding CanChooseContent}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[setup.recheck]}" Click="OnCheckIntegrity" IsEnabled="{Binding CanCheckIntegrity}" Margin="0,0,8,8"
                            Visibility="{Binding ShowIntegrityCheck, Converter={StaticResource Visible}}" />
                    <Button Content="{Binding S[integrity.cancel]}" Click="OnCancelIntegrity" Visibility="{Binding IntegrityChecking, Converter={StaticResource Visible}}" Margin="0,0,8,8" />
                  </WrapPanel>
                  <StackPanel Visibility="{Binding ShowIntegritySupport, Converter={StaticResource Visible}}">
                    <WrapPanel Margin="-6,8,0,8">
                      <Button Content="{Binding S[integrity.copy]}" Style="{StaticResource LinkButton}" Click="OnCopyIntegrity" />
                      <Button Content="{Binding S[help.open_channel]}" Style="{StaticResource LinkButton}" Click="OnHelpChannel" />
                    </WrapPanel>
                    <TextBlock Text="{Binding S[integrity.help]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              </Grid>

              <!-- OD-116: "Use a different catalog"; an unofficial catalog is always shown with its warning. -->
              <Border x:Name="CatalogCard" Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding S[catalog.title]}" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding CatalogSourceText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CustomCatalogWarning}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding UsingCustomCatalog, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding S[catalog.hint]}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,6" Foreground="{StaticResource InfinityMuted}" />
                  <TextBox Text="{Binding CatalogDraft, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" AutomationProperties.Name="{Binding S[catalog.title]}" />
                  <TextBlock Text="{Binding S[catalog.invalid]}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding CatalogDraftInvalid, Converter={StaticResource Visible}}" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="{Binding S[catalog.use_custom]}" Click="OnUseCustomCatalog" IsEnabled="{Binding CanUseCustomCatalog}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[catalog.use_official]}" Click="OnUseOfficialCatalog" IsEnabled="{Binding CanUseOfficialCatalog}" Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- OD-136 (CR-L41.1): Settings → Discord, per install; all on by default. -->
              <Border x:Name="DiscordPresenceCard" Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding S[presence.settings_title]}" FontWeight="Bold" FontSize="18" Margin="0,0,0,8" />
                  <TextBlock Text="{Binding S[presence.settings_hint]}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource InfinityMuted}" />
                  <CheckBox Content="{Binding S[presence.enabled]}" IsChecked="{Binding PresenceEnabled}" FontWeight="Bold" Margin="0,0,0,8" />
                  <WrapPanel Margin="24,0,0,0" IsEnabled="{Binding PresenceEnabled}">
                    <CheckBox Content="{Binding S[presence.toggle_club]}" IsChecked="{Binding PresenceClub}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_mode]}" IsChecked="{Binding PresenceMode}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_name]}" IsChecked="{Binding PresenceName}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_level]}" IsChecked="{Binding PresenceLevel}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_credits]}" IsChecked="{Binding PresenceCredits}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_car]}" IsChecked="{Binding PresenceCar}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_lobby]}" IsChecked="{Binding PresenceLobby}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_join]}" IsChecked="{Binding PresenceJoin}" Margin="0,0,18,6" />
                    <CheckBox Content="{Binding S[presence.toggle_livery]}" IsChecked="{Binding PresenceLivery}" Margin="0,0,18,6" />
                  </WrapPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>

          <!-- Compact manifest catalog; selection and information share the right sidebar. -->
          <Grid Visibility="{Binding ShowMods, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,18,0">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding ModsTitle}" Style="{StaticResource PageTitle}" />
                <!-- Owner 2026-11-10: the game chips are PLAY's tiles (one selection with PLAY); the chosen game's mods folder under them. -->
                <ItemsControl ItemsSource="{Binding GameCards}" Margin="0,10,0,0" Visibility="{Binding ShowModGameChips, Converter={StaticResource Visible}}"
                              AutomationProperties.Name="{Binding S[mods.games]}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="OnSelectModsGame" Padding="12,6" Margin="0,0,8,6" Cursor="Hand" ToolTip="{Binding Reason}"
                              AutomationProperties.Name="{Binding Title}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter Property="BorderBrush" Value="{Binding Accent}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="FontWeight" Value="Bold" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.45" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding Title}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ModsGameFolder}" ToolTip="{Binding ExtraOptionsModsFolder}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource InfinityMuted}" />
                <!-- Alex 2026-11-10: every mod of the chosen game on or off (the # of each loadorder.txt line), after the small confirmation. -->
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding ShowToggleAllMods, Converter={StaticResource Visible}}">
                  <Button Content="{Binding S[mods.enable_all]}" Click="OnEnableAllMods" IsEnabled="{Binding CanEnableAllMods}" Padding="10,6" Margin="0,0,8,0"
                          AutomationProperties.Name="{Binding S[mods.enable_all]}" />
                  <Button Content="{Binding S[mods.disable_all]}" Click="OnDisableAllMods" IsEnabled="{Binding CanDisableAllMods}" Padding="10,6"
                          AutomationProperties.Name="{Binding S[mods.disable_all]}" />
                </WrapPanel>
                <!-- Owner 2026-11-10: the background read of the mods, while it runs, with its progress (the cards follow when it ends). -->
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding ModsReading, Converter={StaticResource Visible}}">
                  <StackPanel>
                    <TextBlock Text="{Binding ModsReadingText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding ModsReadingPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding ModsReadingIndeterminate, Mode=OneWay}" />
                  </StackPanel>
                </Border>
                <Grid Margin="0,14,0,12" Visibility="{Binding HasModCards, Converter={StaticResource Visible}}">
                  <TextBox Text="{Binding ModSearch, UpdateSourceTrigger=PropertyChanged}" Padding="14,11,38,11"
                           AutomationProperties.Name="{Binding S[mods.search]}" />
                  <TextBlock Text="{Binding S[mods.search]}" Margin="15,0,38,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource InfinityMuted}" IsHitTestVisible="False"
                             Visibility="{Binding ModSearchEmpty, Converter={StaticResource Visible}}" />
                  <Button Content="×" Width="28" Height="28" Padding="0" Margin="0,0,7,0" HorizontalAlignment="Right"
                          Click="OnClearModSearch" ToolTip="{Binding S[mods.search_clear]}" AutomationProperties.Name="{Binding S[mods.search_clear]}"
                          Visibility="{Binding ModSearchEmpty, Converter={StaticResource Hidden}}" />
                </Grid>
                <StackPanel>
                  <WrapPanel>
                    <!-- Development tools only: the DEV catalog override and the native offline session. -->
                    <WrapPanel Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}">
                      <Button Click="OnNavHome" Padding="10,6" Margin="0,0,8,8" AutomationProperties.Name="{Binding S[welcome.back]}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconBack}" Style="{StaticResource InlineIcon}" Margin="0,0,6,0" /><TextBlock Text="{Binding S[welcome.back]}" VerticalAlignment="Center" /></StackPanel></Button>
                      <Button Content="{Binding S[integrity.choose]}" Click="OnChooseContent" IsEnabled="{Binding CanChooseContent}" ToolTip="{Binding IntegrityLocationLabel}" Padding="10,6" Margin="0,0,8,8" />
                      <!-- Hidden (as on Configure) when there is no hook package to install: an empty label is no button. -->
                      <Button Click="OnInstallHook" IsEnabled="{Binding CanInstallHook}" Padding="10,6" Margin="0,0,8,8" AutomationProperties.Name="{Binding HookInstallLabel}"
                              Visibility="{Binding CanInstallHook, Converter={StaticResource Visible}}"><TextBlock Text="{Binding HookInstallLabel}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                    </WrapPanel>
                    <Button Click="OnLoadModCatalog" Padding="10,8" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8"
                            ToolTip="{Binding S[mods.refresh_catalog]}" AutomationProperties.Name="{Binding S[mods.refresh_catalog]}">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource InlineIcon}" Width="16" Height="16" StrokeThickness="2" />
                        </Button>
                    <Button Content="{Binding S[mods.folder_short]}" Click="OnChooseAzimuth" Padding="10,6" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8"
                            ToolTip="{Binding ModFolder}" AutomationProperties.Name="{Binding S[mods.choose_folder]}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding ModCatalogSummary}" ToolTip="{Binding ModCatalogStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                  <!-- OD-116: a player-chosen catalog is never shown without this warning. -->
                  <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,8,0,0" BorderBrush="{StaticResource InfinityGold}"
                          Visibility="{Binding UsingCustomCatalog, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding CustomCatalogWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}" />
                      <Button Content="{Binding S[catalog.use_official]}" Style="{StaticResource LinkButton}" Click="OnUseOfficialCatalog" HorizontalAlignment="Left"
                              IsEnabled="{Binding CanUseOfficialCatalog}" Margin="-6,4,0,0" />
                    </StackPanel>
                  </Border>
                  <!-- H4/§1.4: production recovery, always with a resolution. -->
                  <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0" Visibility="{Binding ShowModRecovery, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding S[mods.recovery_title]}" FontWeight="Bold" />
                      <TextBlock Text="{Binding ModRecoveryText}" TextWrapping="Wrap" Margin="0,6,0,8" />
                      <WrapPanel>
                        <Button Content="{Binding S[mods.recover]}" Click="OnRecoverMods" IsEnabled="{Binding CanRecoverMods}" Padding="10,6" Margin="0,0,8,6" />
                        <Button Content="{Binding S[mods.resolve]}" Click="OnResolveMods" IsEnabled="{Binding CanResolveMods}" Padding="10,6" Margin="0,0,8,6"
                                ToolTip="{Binding S[mods.resolve_hint]}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding S[mods.resolve_hint]}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                    </StackPanel>
                  </Border>
                  <!-- Not an interrupted operation: a read that failed for now, another game folder, a moved installation; always Try again. -->
                  <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0" Visibility="{Binding ShowModAttention, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding S[mods.attention_title]}" FontWeight="Bold" />
                      <TextBlock Text="{Binding ModAttentionText}" TextWrapping="Wrap" Margin="0,6,0,8" />
                      <WrapPanel>
                        <Button Content="{Binding S[mods.retry]}" Click="OnRetryModState" IsEnabled="{Binding CanRetryMods}" Padding="10,6" Margin="0,0,8,6" />
                        <Button Content="{Binding S[mods.relink]}" Click="OnRelinkMods" IsEnabled="{Binding ModsIdle}" Padding="10,6" Margin="0,0,8,6"
                                Visibility="{Binding HasModRelink, Converter={StaticResource Visible}}" />
                        <Button Content="{Binding S[mods.open_setup]}" Click="OnOpenSetupForMods" Padding="10,6" Margin="0,0,8,6"
                                Visibility="{Binding ShowModsOpenSetup, Converter={StaticResource Visible}}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <!-- OD-233: the old flat mods folder moves to the per-game folders; never shown as an unreadable record. -->
                  <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0" Visibility="{Binding ShowModsLayout, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding S[mods.layout_title]}" FontWeight="Bold" />
                      <TextBlock Text="{Binding ModsLayoutText}" TextWrapping="Wrap" Margin="0,6,0,8" />
                      <Button Content="{Binding S[mods.layout_move]}" Click="OnMoveModsLayout" IsEnabled="{Binding ModsIdle}" Padding="10,6" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <!-- OD-126: the mods of ExtraOptions' loader (<Azimuth>\mods) copied there by hand (owner 2026-10-28: the launcher's own
                     catalog and custom mods have their cards above), each marked as such with a note on online play. -->
                <StackPanel Margin="0,0,0,18" Visibility="{Binding HasExtraOptionsMods, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding S[eomods.title]}" FontSize="16" FontWeight="Bold" />
                  <TextBlock Text="{Binding ExtraOptionsModsHint}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding ExtraOptionsModsFolder}" TextWrapping="Wrap" Margin="0,2,0,10" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                  <ItemsControl ItemsSource="{Binding ExtraOptionsModItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,12,8">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                              <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" />
                              <TextBlock Text="{Binding DataContext.S[eomods.manual_online], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Content="{Binding Toggle}" Click="OnToggleExtraOptionsMod" IsEnabled="{Binding CanToggle}"
                                      Padding="12,7" Margin="12,0,0,0" AutomationProperties.Name="{Binding Toggle}" />
                              <!-- Owner 2026-10-28: an off manual mod can be deleted from the mods folder (asked twice). -->
                              <Button Content="{Binding DeleteLabel}" Click="OnDeleteExtraOptionsMod" IsEnabled="{Binding CanDelete}"
                                      Padding="12,7" Margin="8,0,0,0" AutomationProperties.Name="{Binding DeleteLabel}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding S[mods.search_none]}" TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{StaticResource InfinityMuted}"
                           Visibility="{Binding NoMatchingMods, Converter={StaticResource Visible}}" />
                <!-- Owner 2026-11-10: a game the catalog has nothing for yet says so (its ExtraOptions card stays). -->
                <TextBlock Text="{Binding ModsEmptyForGame}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource InfinityMuted}"
                           Visibility="{Binding ShowModsEmptyForGame, Converter={StaticResource Visible}}" />
                <!-- OD-232: one card per set of packs sharing a hint (the ZS FM5 / FM6 Addon Packs): one folder pick installs them all,
                     the packs are rows with their own actions. -->
                <ItemsControl ItemsSource="{Binding FilteredModSetCards}" Visibility="{Binding HasModSetCards, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                              <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding DataContext.S[modset.install_all], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Click="OnInstallModSet" IsEnabled="{Binding CanInstallAll}" Padding="12,7" Margin="12,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding DataContext.S[modset.install_all], RelativeSource={RelativeSource AncestorType=Window}}" />
                          </Grid>
                          <Expander Header="{Binding DataContext.S[modset.packs], RelativeSource={RelativeSource AncestorType=Window}}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Margin="0,10,0,0">
                            <StackPanel>
                              <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,0" />
                              <TextBlock Text="{Binding Report}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityGold}" Margin="0,8,0,0"
                                         AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasReport, Converter={StaticResource Visible}}" />
                              <ItemsControl ItemsSource="{Binding Packs}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                      <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                          <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,3,0,0" />
                                          <TextBlock Text="{Binding Badge}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                                                     Foreground="{StaticResource InfinityGold}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                          <Button Content="i" Click="OnModInformation" Width="24" Height="24" Padding="0" Margin="12,0,0,0" FontWeight="Bold" FontStyle="Italic"
                                                  ToolTip="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}"
                                                  AutomationProperties.Name="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}" />
                                          <Button Content="{Binding Action}" Click="OnActOnMod" IsEnabled="{Binding CanAct}" Padding="12,7" Margin="8,0,0,0"
                                                  AutomationProperties.Name="{Binding Action}" />
                                          <Button Content="{Binding DataContext.S[mods.uninstall], RelativeSource={RelativeSource AncestorType=Window}}" Click="OnUninstallModCard"
                                                  IsEnabled="{Binding CanUninstall}" Visibility="{Binding Installed, Converter={StaticResource Visible}}" Padding="12,7" Margin="8,0,0,0"
                                                  AutomationProperties.Name="{Binding DataContext.S[mods.uninstall], RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding FilteredModCards}" Visibility="{Binding HasModCards, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Width="230" Height="144" Padding="0" Margin="0,0,12,12">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                          <Button Click="OnSelectMod" Style="{StaticResource ModCardButton}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,24,0" ToolTip="{Binding Name}" />
                              <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,5,0,0" />
                              <TextBlock Text="{Binding SourceBadge}" Foreground="{StaticResource InfinityPink}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                                         Visibility="{Binding ShowSourceBadge, Converter={StaticResource Visible}}" />
                              <TextBlock Text="{Binding Badge}" Foreground="{StaticResource InfinityGold}" FontSize="12" Margin="0,12,0,0"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                            </StackPanel>
                          </Button>
                          <Button Content="i" Click="OnModInformation" Width="24" Height="24" Padding="0" Margin="0,9,9,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="Bold" FontStyle="Italic"
                                  ToolTip="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}"
                                  AutomationProperties.Name="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}" />
                          <Button Grid.Row="1" Content="{Binding Action}" Click="OnActOnMod" IsEnabled="{Binding CanAct}"
                                  Visibility="{Binding ShowAction, Converter={StaticResource Visible}}" Padding="10,7" Margin="14,0,14,14" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ModCatalogStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource InfinityMuted}" />
                <!-- T2b: a catalog that failed offers a retry and the way to another catalog (the card is on Configure). -->
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding ModCatalogFailed, Converter={StaticResource Visible}}">
                  <Button Content="{Binding S[mods.catalog_retry]}" Click="OnLoadModCatalog" IsEnabled="{Binding ModsIdle}" Padding="10,6" Margin="0,0,8,8" />
                  <Button Content="{Binding S[mods.catalog_other]}" Click="OnOpenCatalogSetting" Padding="10,6" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
              </ScrollViewer>
            </DockPanel>

            <!-- The options sidebar: the INI as a form; Save and Undo stay at the bottom. -->
            <Border Grid.Column="1" Width="360" Margin="0,-28,-40,-16" Padding="22,22,8,16" Background="{StaticResource InfinitySurface}"
                    BorderBrush="#3365184D" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowModOptions, Converter={StaticResource Visible}}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,12,0">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}"
                          Click="OnCloseModPanel" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding S[mods.options_title]}" FontSize="20" FontWeight="Bold" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedMod.Name}" Style="{StaticResource PageSubtitle}" Margin="0,2,12,0" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ModOptionsWait}" TextWrapping="Wrap" FontSize="11" Margin="0,8,12,0"
                           Foreground="{StaticResource InfinityGold}" Visibility="{Binding HasModOptionsWait, Converter={StaticResource Visible}}" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="{Binding S[mods.save_options]}" Click="OnSaveIni" IsEnabled="{Binding IniDirty}"
                          Style="{StaticResource AccentButtonStyle}" />
                  <Button Content="{Binding S[mods.revert_options]}" Margin="10,0,0,0" Click="OnRevertIni" IsEnabled="{Binding IniDirty}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding S[mods.options_hint]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                    <ItemsControl ItemsSource="{Binding ModOptions}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,8,0,10" IsEnabled="{Binding Editable}">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" FontSize="11" Margin="0,4,0,6" />
                          <TextBlock Text="{Binding LockReason}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" FontSize="11" Margin="0,0,0,6"
                                     Visibility="{Binding HasLockReason, Converter={StaticResource Visible}}" />
                          <CheckBox IsChecked="{Binding Checked}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" />
                          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsNumber, Converter={StaticResource Visible}}" />
                          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text}" Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" />
                        </StackPanel>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Width="360" Margin="0,-28,-40,-16" Padding="22,22,16,16" Background="{StaticResource InfinitySurface}"
                    BorderBrush="#3365184D" BorderThickness="1,0,0,0" Visibility="{Binding ShowModInfo, Converter={StaticResource Visible}}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}" Click="OnCloseModPanel" />
                  <TextBlock Text="{Binding S[mods.information]}" FontSize="20" FontWeight="Bold" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding SelectedMod.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedMod.Credits}" FontSize="11" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedMod.SourceBadge}" Foreground="{StaticResource InfinityPink}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                               Visibility="{Binding SelectedMod.ShowSourceBadge, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding SelectedMod.Description}" TextWrapping="Wrap" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding SelectedMod.Status}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding SelectedMod.Requirements}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
                    <!-- Alex (1.0.11): every Install first says where the mod goes and which existing files it replaces (backed up, restored later). -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding SelectedModInstallPreview, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding InstallPreviewText}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                      <TextBlock Text="{Binding InstallPreviewFiles}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource InfinityMuted}"
                                 Visibility="{Binding InstallPreviewHasFiles, Converter={StaticResource Visible}}" />
                      <Button x:Name="InstallPreviewButton" Content="{Binding InstallPreviewLabel}" Click="OnConfirmInstall" IsEnabled="{Binding CanConfirmInstall}"
                              Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                    <!-- M5 reviewed update: the change first, then the confirmation. -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding SelectedModUpdate, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding SelectedMod.UpdateSummary}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="{Binding UpdatePreviewText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding UpdatePreviewFiles}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource InfinityMuted}"
                                 Visibility="{Binding UpdatePreviewHasFiles, Converter={StaticResource Visible}}" />
                      <Button x:Name="ConfirmUpdateButton" Content="{Binding ConfirmUpdateLabel}" Click="OnConfirmModUpdate" IsEnabled="{Binding CanConfirmModUpdate}"
                              Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                    <!-- H3: changed files are a warning with two choices; M6: settings repair. -->
                    <WrapPanel Margin="0,14,0,0">
                      <Button Content="{Binding S[mods.accept_files]}" Click="OnAcceptModFiles" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModDrift, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.disable_keep]}" Click="OnDisableModKeeping" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModCanDisableKeeping, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.repair_settings]}" Click="OnRepairModSettings" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModSettingsIssues, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.uninstall]}" Click="OnUninstallMod" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModCanUninstall, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.purge]}" Click="OnPurgeMod" Padding="10,6" Margin="0,0,8,8"
                              ToolTip="{Binding S[mods.purge_hint]}" Visibility="{Binding SelectedModCanPurge, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <!-- OD-117: an installed mod of the player's own files: check its files again, or point at another copy. -->
                    <!-- T2c: the label wraps inside the pane (pt-BR was clipped mid-word). -->
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding SelectedModExternal, Converter={StaticResource Visible}}">
                      <Button Click="OnOpenExternalSetup" Padding="10,6" Margin="0,0,8,8" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                              AutomationProperties.Name="{Binding S[external.recheck]}">
                        <TextBlock Text="{Binding S[external.recheck]}" TextWrapping="Wrap" />
                      </Button>
                    </StackPanel>
                    <Button Content="{Binding S[mods.options]}" Click="OnSelectedModOptions" Margin="0,18,0,0"
