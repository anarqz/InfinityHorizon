            <Button Content="{Binding S[online.updates]}" Click="OnOpenLauncherUpdate" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.exit]}" Click="OnExitLauncherUpdate" Margin="0,0,10,10" />
          </WrapPanel>
          <TextBlock Text="{Binding OnlineServiceHelp}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
          <Button Content="{Binding S[mods.dev_open]}" Click="OnNavMods" HorizontalAlignment="Left" Margin="0,16,0,0"
                  Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}" IsEnabled="{Binding ModsIdle}" />
          <Button Click="OnDiscord" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="{Binding S[nav.discord]}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding S[nav.discord]}" VerticalAlignment="Center" /><Path Data="{StaticResource IconExternal}" Style="{StaticResource InlineIcon}" Margin="6,0,0,0" /></StackPanel></Button>
        </StackPanel>
