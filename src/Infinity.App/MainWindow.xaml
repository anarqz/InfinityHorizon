    <!-- Owner 2026-11-12 (first-hand, WINDOWS chat: "the warning as a popup in the middle of the screen, so players are AWARE"; only what needs the
         player's decision is a popup, everything else is PLAY's notice line). Three centred popups over the window, one at a time (each waits
         behind the prompts of ShellViewModel.PromptOpen, the former-Noob one also behind the other two). The same light dim as the queue
         modal: the page stays visible behind; nothing under it takes a click. -->
    <!-- T-1111-AZIMUTH (OD-243): the one-time former-Noob choice, one row per game: the game and the source, LV · CR · saved of both saves,
         Copy my Noob save (backup first, its path in the row's result, under the busy overlay) / Keep Azimuth's save; Close once all are
         chosen, Not now closes it unasked (asked again at the next start). -->
    <Border x:Name="OldNoobNotice" Panel.ZIndex="94" Background="#B3080410" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="Cycle" Visibility="{Binding ShowOldNoobNotice, Converter={StaticResource Visible}}"
            KeyDown="OnOldNoobNoticeKey" IsVisibleChanged="OnOldNoobNoticeVisible" AutomationProperties.Name="{Binding S[oldnotice.title]}">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{x:Static local:SlotBrushes.Azimuth}" BorderThickness="1.5"
              CornerRadius="18" Padding="32,26" MaxWidth="680" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding S[sm.azimuth]}" Foreground="{x:Static local:SlotBrushes.Azimuth}" Style="{StaticResource SmModeTag}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding S[oldnotice.title]}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding S[oldnotice.body]}" Style="{StaticResource SmHint}" FontSize="14" Margin="0,8,0,16" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OldNoobNoticeLater" Content="{Binding S[oldnotice.later]}" Style="{StaticResource SmButton}" Click="OnOldNoobNoticeLater"
                    IsEnabled="{Binding Idle}" Visibility="{Binding OldNoobNoticeUndecided, Converter={StaticResource Visible}}" />
            <Button x:Name="OldNoobNoticeCloseButton" Content="{Binding S[oldnotice.close]}" Style="{StaticResource SmPrimary}" Click="OnOldNoobNoticeClose"
                    Background="{x:Static local:SlotBrushes.Azimuth}" Visibility="{Binding OldNoobNoticeDone, Converter={StaticResource Visible}}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" FocusVisualStyle="{x:Null}">
            <ItemsControl ItemsSource="{Binding OldNoobNoticeRows}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SmCard}" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding OldLine}" ToolTip="{Binding OldTip}" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AzimuthLine}" ToolTip="{Binding AzimuthTip}" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                      <WrapPanel Margin="0,12,0,0" Visibility="{Binding Undecided, Converter={StaticResource Visible}}">
                        <Button Content="{Binding DataContext.S[oldnotice.copy], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SmPrimary}"
                                Background="{x:Static local:SlotBrushes.Azimuth}" Margin="0,0,8,0" Click="OnOldNoobNoticeCopy"
                                IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="{Binding DataContext.S[oldnotice.keep], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SmButton}"
                                Click="OnOldNoobNoticeKeep" IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding Result}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"
                                 Visibility="{Binding HasResult, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
    <!-- (owner 2026-11-12) START {MODE} CAREER, PLAY's choice (fresh / from my other profile / from this PC's save) as a popup; Play follows. -->
    <Border x:Name="PlayStartPrompt" Panel.ZIndex="94" Background="#B3080410" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="Cycle" Visibility="{Binding ShowPlayStart, Converter={StaticResource Visible}}"
            IsVisibleChanged="OnPlayStartVisible" KeyDown="OnPlayStartKey" AutomationProperties.Name="{Binding CareerStartTitle}">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="32,26" MaxWidth="720" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
          <StackPanel>
            <TextBlock Text="{Binding CareerStartTitle}" Style="{StaticResource SmH1}" />
            <TextBlock Text="{Binding StartSub}" Style="{StaticResource SmSub}" />
            <Button Style="{StaticResource SmChoice}" Tag="{Binding StartAccent}" Click="OnPlayStartFresh" IsEnabled="{Binding Idle}">
              <StackPanel>
                <TextBlock Text="{Binding S[sm.start.fresh]}" FontWeight="Bold" FontSize="15" />
                <TextBlock Text="{Binding StartFreshHint}" Style="{StaticResource SmHint}" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource SmChoice}" Tag="{Binding StartAccent}" Click="OnPlayStartFromProfile" IsEnabled="{Binding StartFromProfileEnabled}"
                    Visibility="{Binding ShowStartFromProfile, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{Binding StartFromProfileLabel}" FontWeight="Bold" FontSize="15" />
                <TextBlock Text="{Binding StartFromProfileHint}" Style="{StaticResource SmHint}" FontSize="14" />
              </StackPanel>
            </Button>
            <!-- B2 (OD-239): shown on a HARDCORE card only, disabled with its reason; an Azimuth card starts fresh only -->
            <Button Style="{StaticResource SmChoice}" Tag="{Binding StartAccent}" Click="OnPlayStartFromPc" IsEnabled="False"
                    Visibility="{Binding ShowStartFromPc, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{Binding S[sm.start.from_pc]}" FontWeight="Bold" FontSize="15" />
                <TextBlock Text="{Binding StartFromPcHint}" Style="{StaticResource SmHint}" FontSize="14" />
              </StackPanel>
            </Button>
            <Border Style="{StaticResource SmNote}" Visibility="{Binding CareerStartHardcore, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{Binding S[sm.start.hc_note]}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding S[seed.warning]}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                           Visibility="{Binding ShowCareerStartSeedWarning, Converter={StaticResource Visible}}" />
              </StackPanel>
            </Border>
            <WrapPanel Margin="0,12,0,0">
              <Button x:Name="PlayStartNotNow" Content="{Binding S[saves.conflict_not_now]}" Click="OnClosePlayStart" Style="{StaticResource SmButton}" Margin="0,0,10,0" />
              <Button Content="{Binding S[careers.delete_empty]}" Click="OnDeleteStartCareer" Style="{StaticResource SmDanger}" Margin="0,0,10,0"
                      Visibility="{Binding CanDeleteStartCareer, Converter={StaticResource Visible}}" IsEnabled="{Binding CanAskDeleteProfile}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
    <!-- (owner 2026-11-12) every confirmation that copies, restores or replaces a save: what is copied, what is replaced, the backup line,
         Confirm / Cancel (ShellViewModel.AskCopy). Nothing is written before Confirm. -->
    <Border x:Name="CopyConfirmOverlay" Panel.ZIndex="94" Background="#B3080410" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="Cycle" Visibility="{Binding ShowCopyConfirm, Converter={StaticResource Visible}}"
            IsVisibleChanged="OnCopyConfirmVisible" KeyDown="OnCopyConfirmKey" AutomationProperties.Name="{Binding CopyTitle}">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="32,26" MaxWidth="820" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
          <StackPanel>
            <TextBlock Text="{Binding CopyTitle}" Style="{StaticResource SmH1}" />
            <TextBlock Text="{Binding CopySub}" Style="{StaticResource SmSub}" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource SmCard}" DataContext="{Binding CopyFromSide}">
                <StackPanel>
                  <Border Style="{StaticResource SmPill}" HorizontalAlignment="Left"><TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" /></Border>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SmCompareLines}" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="1" Text="→" FontSize="28" Foreground="{StaticResource InfinityMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Grid.Column="2" Style="{StaticResource SmCard}" DataContext="{Binding CopyToSide}">
                <StackPanel>
                  <Border Style="{StaticResource SmPill}" HorizontalAlignment="Left"><TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" /></Border>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SmCompareLines}" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource SmNote}"><TextBlock Text="{Binding CopyNote}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" /></Border>
            <Border Style="{StaticResource SmNote}" Visibility="{Binding ShowCopyBlocked, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding CopyBlockedText}" Foreground="{StaticResource SmWarn}" TextWrapping="Wrap" />
            </Border>
            <WrapPanel Margin="0,18,0,0">
              <Button x:Name="CopyConfirmButton" Content="{Binding CopyConfirmLabel}" Background="{x:Static local:SlotBrushes.Azimuth}" Style="{StaticResource SmPrimary}"
                      Click="OnConfirmCopy" IsEnabled="{Binding CanConfirmCopy}" />
              <Button Content="{Binding S[sm.cancel]}" Style="{StaticResource SmButton}" Margin="10,0,0,0" x:Name="CopyCancelButton" Click="OnCancelCopy" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
    <!-- (owner 2026-11-12: "The resolve page, let's move to a popup instead of a full page") cloud vs this PC, the newer one recommended: each
         side says what its choice replaces and the backup; Keep cloud backs this PC's save up first and is refused while the game runs; a
         refusal or failure stays here with its reason; Not now writes nothing. In the queue of the other save confirmations. -->
    <Border x:Name="ResolveOverlay" Panel.ZIndex="94" Background="#B3080410" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="Cycle" Visibility="{Binding ShowResolveConfirm, Converter={StaticResource Visible}}"
            IsVisibleChanged="OnResolveVisible" KeyDown="OnResolveKey" AutomationProperties.Name="{Binding ResolveTitle}">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="32,26" MaxWidth="860" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
          <StackPanel>
            <TextBlock Text="{Binding ResolveTitle}" Style="{StaticResource SmH1}" />
            <TextBlock Text="{Binding S[sm.resolve_sub]}" Style="{StaticResource SmSub}" />
            <UniformGrid Columns="2">
              <Border Style="{StaticResource SmCard}" Margin="0,0,9,0" DataContext="{Binding ResolveCloud}">
                <StackPanel>
                  <Grid HorizontalAlignment="Left">
                    <Border CornerRadius="6" Padding="8,3" Background="{x:Static local:SlotBrushes.GoodSoft}" Visibility="{Binding Newer, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="Black" Foreground="{x:Static local:SlotBrushes.Good}" />
                    </Border>
                    <Border Style="{StaticResource SmPill}" Visibility="{Binding Newer, Converter={StaticResource Hidden}}">
                      <TextBlock Text="{Binding Pill}" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" />
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SmCompareLines}" />
                  <TextBlock Text="{Binding DataContext.S[sm.resolve.cloud_replaces], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SmHint}" FontSize="12"
                             Margin="0,10,0,0" TextWrapping="Wrap" />
                  <Button Content="{Binding ActionLabel}" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnResolveKeepCloud"
                          IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource SmButton}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Recommended}" Value="True">
                            <Setter Property="Background" Value="{x:Static local:SlotBrushes.Azimuth}" />
                            <Setter Property="Foreground" Value="#FF071018" />
                            <Setter Property="FontWeight" Value="Bold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Border>              <Border Style="{StaticResource SmCard}" Margin="9,0,0,0" DataContext="{Binding ResolvePc}">
                <StackPanel>
                  <Grid HorizontalAlignment="Left">
                    <Border CornerRadius="6" Padding="8,3" Background="{x:Static local:SlotBrushes.GoodSoft}" Visibility="{Binding Newer, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding Pill}" FontSize="11" FontWeight="Black" Foreground="{x:Static local:SlotBrushes.Good}" />
                    </Border>
                    <Border Style="{StaticResource SmPill}" Visibility="{Binding Newer, Converter={StaticResource Hidden}}">
                      <TextBlock Text="{Binding Pill}" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" />
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SmCompareLines}" />
                  <TextBlock Text="{Binding DataContext.S[sm.resolve.pc_replaces], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SmHint}" FontSize="12"
                             Margin="0,10,0,0" TextWrapping="Wrap" />
                  <Button Content="{Binding ActionLabel}" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnResolveKeepPc"
                          IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource SmButton}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Recommended}" Value="True">
                            <Setter Property="Background" Value="{x:Static local:SlotBrushes.Azimuth}" />
                            <Setter Property="Foreground" Value="#FF071018" />
                            <Setter Property="FontWeight" Value="Bold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Border>            </UniformGrid>
            <Border Style="{StaticResource SmNote}" Visibility="{Binding ResolveHardcore, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding S[sm.resolve_hc_note]}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource SmNote}" Visibility="{Binding ShowResolveBlocked, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding GameRunningText}" Foreground="{StaticResource SmWarn}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource SmWarn}" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Right">
              <Button x:Name="ResolveNotNow" Content="{Binding S[saves.conflict_not_now]}" Style="{StaticResource SmButton}" Click="OnCloseResolve" IsEnabled="{Binding Idle}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
    <!-- Owner 2026-10-28: an Azimuth never opened (data has only bin) blocks everything, like the mod progress dialog below. -->
    <Border x:Name="AzimuthFirstRunOverlay" Background="#FF0E0B16" Panel.ZIndex="95"
            Visibility="{Binding ShowAzimuthFirstRun, Converter={StaticResource Visible}}"
            Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="40,32" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding S[azimuth_firstrun.title]}" FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AzimuthFirstRunBody}" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{Binding AzimuthFirstRunStatus}" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                     Foreground="{StaticResource InfinityGold}" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding HasAzimuthFirstRunStatus, Converter={StaticResource Visible}}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button x:Name="AzimuthFirstRunLaunch" Content="{Binding S[azimuth_firstrun.launch]}" Click="OnLaunchAzimuthFirstRun"
                    Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0" />
            <Button Content="{Binding S[azimuth_firstrun.check]}" Click="OnCheckAzimuthFirstRun" Padding="14,8" Margin="0,0,10,0" />
            <!-- another Azimuth folder, when this one is a fresh copy beside the one the player uses -->
            <Button Content="{Binding S[setup.choose]}" Click="OnChooseAzimuth" Padding="14,8" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- T2b/T4b: an opaque backdrop, and no opacity or effect on the content under it: under Wine, any composited dim or blur
         drew the text boxes behind it as solid grey bars. Nothing behind the dialog needs to show while a mod operation runs. -->
    <Border x:Name="ModProgressOverlay" Background="#FF0E0B16" Panel.ZIndex="100"
            Visibility="{Binding ShowModProgressOverlay, Converter={StaticResource Visible}}"
            Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="40,32" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Grid Width="48" Height="48" Margin="0,0,0,22">
            <Ellipse Stroke="{StaticResource InfinityBorder}" StrokeThickness="4" />
            <Path Data="M 24,2 A 22,22 0 0 1 46,24" Stroke="{StaticResource InfinityPink}" StrokeThickness="4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
              <Path.Style>
                <Style TargetType="Path">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ModOperationBusy}" Value="True">
                      <DataTrigger.EnterActions><BeginStoryboard x:Name="ModSpinner"><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                      </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ModSpinner" /></DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Grid>
          <TextBlock Text="{Binding S[mods.progress.title]}" FontSize="22" FontWeight="Bold" TextAlignment="Center" />
          <TextBlock Text="{Binding ModProgress}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding S[mods.progress.hint]}" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
        </StackPanel>
      </Border>
    </Border>
    <!-- Owner 2026-11-10 (build #3): a card's Install or Update that must be seen first (files it replaces, a reviewed update) asks here, over
         the page, never in the side pane. The same opaque backdrop as the progress dialog (T2b/T4b: no composited dim under Wine). -->
    <Border x:Name="ModConfirmOverlay" Background="#FF0E0B16" Panel.ZIndex="99"
            Visibility="{Binding ShowModConfirm, Converter={StaticResource Visible}}"
            Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyDown="OnModConfirmKey"
            IsVisibleChanged="OnModConfirmVisible">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="32,26" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding ModConfirmTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ModConfirmText}" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="{Binding ModConfirmHasFiles, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding ModConfirmFiles}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ModConfirmCancelButton" Content="{Binding S[mods.confirm_cancel]}" Click="OnCancelModConfirm" Padding="14,7" Margin="0,0,10,0" IsCancel="True" />
            <Button x:Name="ModConfirmButton" Content="{Binding ModConfirmLabel}" Click="OnConfirmModCard" IsEnabled="{Binding CanConfirmModCard}"
                    Style="{StaticResource AccentButtonStyle}" Padding="14,7" AutomationProperties.Name="{Binding ModConfirmLabel}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- Owner 2026-11-08 (image 7): the Profiles page's ⋯ menus (a profile card's and each game row's) float over the page, by their button
         (bottom-right aligned, above it near the bottom, inside the window). Drawn in the window (no WPF Popup: a Popup window froze under
         Proton); an outside click, Esc or an item closes it; arrows and Tab cycle its items. -->
    <Grid x:Name="MenuLayer" Panel.ZIndex="95" Visibility="{Binding ShowFloatingMenu, Converter={StaticResource Visible}}" KeyDown="OnMenuLayerKey">
      <Border Background="Transparent" MouseDown="OnMenuBackdrop" MouseWheel="OnMenuBackdropWheel" />
      <Canvas>
        <Border x:Name="FloatingMenuPanel" MinWidth="250" MaxWidth="330" Padding="6" CornerRadius="10" Background="{StaticResource SmMenuSurface}"
                BorderBrush="{StaticResource SmLine}" BorderThickness="1" KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle">
          <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black" /></Border.Effect>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding OpenMenu.Items}" Focusable="False" Visibility="{Binding FloatingMenuIsCard, Converter={StaticResource Visible}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource SmMenuItem}" IsEnabled="{Binding Enabled}" Click="OnSavesMenuItem"
                          Tag="{Binding DataContext.OpenMenu.Owner, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Reason}">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding Danger}" Value="True"><Setter Property="Foreground" Value="{StaticResource SmBad}" /></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap"
                                 Visibility="{Binding HasReason, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding OpenMenu.Items}" Focusable="False" Visibility="{Binding FloatingMenuIsRow, Converter={StaticResource Visible}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource SmMenuItem}" IsEnabled="{Binding Enabled}" Click="OnGameRowMenuItem"
                          Tag="{Binding DataContext.OpenMenu.Owner, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Reason}">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers><DataTrigger Binding="{Binding Danger}" Value="True"><Setter Property="Foreground" Value="{StaticResource SmBad}" /></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap"
                                 Visibility="{Binding HasReason, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Canvas>
    </Grid>
    <!-- Owner 2026-10-28: the launcher's own file and folder picker for every caller (never the Windows dialog): a pane on the
         right above any screen (the first-run notice too); a pick goes back to the caller, the backdrop or Escape (B) cancels. -->
    <Grid x:Name="BrowserLayer" Panel.ZIndex="96" Visibility="{Binding ShowBrowser, Converter={StaticResource Visible}}">
      <!-- No dim: under Wine a composited backdrop draws the text boxes behind it as grey bars (T2b/T4b); a transparent one still takes the click. -->
      <Border Background="Transparent" MouseDown="OnPickerBackdrop" />
      <Border x:Name="PickerPane" HorizontalAlignment="Right" Width="440" Padding="22,22,16,16" Background="{StaticResource InfinitySurface}"
              BorderBrush="#3365184D" BorderThickness="1,0,0,0" KeyDown="OnPickerPaneKey">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{Binding S[external.cancel]}" Style="{StaticResource LinkButton}" Click="OnStopBrowsing" />
            <TextBlock Text="{Binding BrowserTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="BrowserPanel" Visibility="{Binding ShowBrowser, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding BrowserPlaces}" Margin="0,0,0,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding Label}" Click="OnBrowsePlace" Padding="8,4" Margin="0,0,6,6" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="{Binding S[external.go]}" Click="OnBrowseDraft" Padding="10,6" Margin="6,0,0,0" />
              <TextBox x:Name="BrowserPathBox" Text="{Binding BrowserDraft, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" KeyDown="OnBrowserPathKey"
                       AutomationProperties.Name="{Binding S[external.path]}" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,8">
              <Button x:Name="BrowserUpButton" Content="{Binding S[external.up]}" Click="OnBrowseUp" Padding="10,6" Margin="0,0,8,6" />
              <Button Content="{Binding BrowserPickLabel}" Click="OnPickBrowserFolder" IsEnabled="{Binding BrowserCanPickFolder}"
                                Visibility="{Binding BrowserPicksFolder, Converter={StaticResource Visible}}"
                      Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,6" />
              <Button Content="{Binding S[external.cancel]}" Click="OnStopBrowsing" Padding="10,6" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock Text="{Binding S[external.empty_folder]}" Foreground="{StaticResource InfinityMuted}" FontSize="12"
                       Visibility="{Binding BrowserEmpty, Converter={StaticResource Visible}}" />
            <ItemsControl x:Name="BrowserList" ItemsSource="{Binding BrowserEntries}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Click="OnBrowserEntry" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,4" AutomationProperties.Name="{Binding Name}">
                  <StackPanel Orientation="Horizontal">
                    <!-- Bundled icons (Wine has no emoji font): a folder, or a ZIP or file to pick. -->
                    <Path Width="16" Height="16" Margin="0,0,10,0">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource InlineIcon}">
                          <Setter Property="Data" Value="{StaticResource IconArchive}" />
                          <Style.Triggers><DataTrigger Binding="{Binding Folder}" Value="True"><Setter Property="Data" Value="{StaticResource IconFolder}" /></DataTrigger></Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <!-- owner 2026-11-10: the background jobs' toasts, bottom right (the launcher stays usable); a failure stays with Retry -->
    <StackPanel x:Name="JobToastStack" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Width="320"
                Visibility="{Binding ShowJobToasts, Converter={StaticResource Visible}}">
      <ItemsControl ItemsSource="{Binding JobToasts}" Focusable="False">
        <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:JobToast}">
          <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource SmCardRaised}" BorderBrush="{StaticResource SmLine}" BorderThickness="1">
            <DockPanel LastChildFill="True">
              <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                <local:ThreadedSpinner Width="18" Height="18" OwnThread="False" Ring="{StaticResource SmLine}" Accent="{StaticResource InfinityAccent}" Spinning="{Binding Running}"
                                       Visibility="{Binding Running, Converter={StaticResource Visible}}" />
                <TextBlock Text="✓" FontWeight="Bold" Foreground="{StaticResource InfinityAccent}" HorizontalAlignment="Center"
                           Visibility="{Binding Done, Converter={StaticResource Visible}}" />
                <TextBlock Text="!" FontWeight="Bold" Foreground="#FFFF6B6B" HorizontalAlignment="Center"
                           Visibility="{Binding Failed, Converter={StaticResource Visible}}" />
              </Grid>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{Binding DataContext.S[jobs.retry], RelativeSource={RelativeSource AncestorType=Window}}" Click="OnRetryJob" Margin="6,0,0,0" Padding="8,2"
                        Visibility="{Binding Failed, Converter={StaticResource Visible}}" />
                <Button Content="✕" Click="OnDismissJob" Margin="6,0,0,0" Padding="6,2" Visibility="{Binding Failed, Converter={StaticResource Visible}}"
                        AutomationProperties.Name="{Binding DataContext.S[jobs.dismiss], RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="{Binding DataContext.S[signin.cancel], RelativeSource={RelativeSource AncestorType=Window}}" Click="OnCancelJob" Margin="6,0,0,0" Padding="8,2"
                        Visibility="{Binding CanCancel, Converter={StaticResource Visible}}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}"
                           Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                             Visibility="{Binding HasProgress, Converter={StaticResource Visible}}" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding JobsMoreText}" Margin="0,6,4,0" HorizontalAlignment="Right" Foreground="{StaticResource InfinityMuted}"
                 Visibility="{Binding HasJobsMore, Converter={StaticResource Visible}}" />
    </StackPanel>
    <!-- owner 2026-11-10 (3.1.1): the queue modal. Once the server says where the player is ("Joining queue…" before it), the queue shows
         over the whole window like the busy overlay: nothing outside it takes a click or a key (MainWindow.ScreenLock), its own Leave queue
         button does. Admitted, it gives way to "Joining game…" (the busy overlay). -->
    <Border x:Name="QueueOverlay" Panel.ZIndex="97" Background="#B3080410" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
            Visibility="{Binding ShowQueueModal, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding AdmissionTitle}">
      <Border Style="{StaticResource Card}" Background="#EE170B22" BorderBrush="#775A184D" HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="420" MaxWidth="560">
        <StackPanel>
          <TextBlock Text="{Binding AdmissionTitle}" FontWeight="Bold" FontSize="22" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding AdmissionDetail}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource InfinityMuted}" />
          <Grid Margin="0,18,0,12" Visibility="{Binding Queued, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,26,0">
              <TextBlock Text="{Binding S[queue.your_position]}" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
              <TextBlock Text="{Binding QueueNumber}" FontSize="48" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding QueueEstimate}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding QueueAhead}" Foreground="{StaticResource InfinityMuted}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
          <ProgressBar Height="3" IsIndeterminate="True" Margin="0,16,0,16" Foreground="{StaticResource InfinityAccent}"
                       AutomationProperties.Name="{Binding AdmissionTitle}" />
          <TextBlock Text="{Binding S[queue.keep_open]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
          <Button x:Name="QueueLeaveButton" Content="{Binding LeaveQueueLabel}" Click="OnLeaveQueue" HorizontalAlignment="Left" Margin="0,18,0,0"
                  IsEnabled="{Binding CanLeaveQueue}" />
        </StackPanel>
      </Border>
    </Border>
    <!-- owner 2026-11-08: every network or save action shows this modal overlay (spinner + what is happening); clicks and keys stop here.
         Review 3.1.1: above the ⋯ menus (95) and the file picker (96), so neither stays clickable under a lock or a load; only the mod
         operation's own progress screen (100) is above it. -->
    <Border x:Name="BusyOverlay" Panel.ZIndex="97" Background="#B3080410" Focusable="True" KeyboardNavigation.TabNavigation="None"
            Visibility="{Binding ShowBusyOverlay, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding BusyLabel}">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,24" CornerRadius="10" MinWidth="320"
              Background="{StaticResource SmCardRaised}" BorderBrush="{StaticResource SmLine}" BorderThickness="1">
        <StackPanel HorizontalAlignment="Center">
          <!-- owner 2026-11-10: the ring turns on its own UI thread, so it never looks stuck while the window's thread works -->
          <local:ThreadedSpinner x:Name="BusySpinner" Width="44" Height="44" HorizontalAlignment="Center" Ring="{StaticResource SmLine}"
                                 Accent="{StaticResource InfinityAccent}" Spinning="{Binding ShowBusyOverlay}" />
          <TextBlock Text="{Binding BusyLabel}" Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                     MaxWidth="420" AutomationProperties.LiveSetting="Polite" />
          <!-- owner 2026-11-10: why the screen is blocked ("please wait, don't close the launcher") -->
          <TextBlock Text="{Binding BusyWhy}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     Foreground="{StaticResource InfinityMuted}" />
          <TextBlock Text="{Binding BusyElapsed}" Margin="0,6,0,0" TextAlignment="Center" Foreground="{StaticResource InfinityMuted}"
                     Visibility="{Binding HasBusyElapsed, Converter={StaticResource Visible}}" />
          <Button x:Name="BusyCancelButton" Content="{Binding S[signin.cancel]}" Margin="0,14,0,0" HorizontalAlignment="Center" Click="OnBusyCancel"
                  Visibility="{Binding CanCancelBusy, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
