            <!-- OD-117: set up a mod made of the player's own files; one row per source, then the notice and Install. -->
            <Border Grid.Column="1" Width="400" Margin="0,-28,-40,-16" Padding="22,22,16,16" Background="{StaticResource InfinitySurface}"
                    x:Name="ExternalPane" BorderBrush="#3365184D" BorderThickness="1,0,0,0" Visibility="{Binding ShowExternalSetup, Converter={StaticResource Visible}}"
                    KeyDown="OnExternalPaneKey">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}" Click="OnCloseExternalSetup" />
                  <TextBlock Text="{Binding ExternalSetupTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,8,0" Visibility="{Binding ShowBrowser, Converter={StaticResource Hidden}}">
                  <TextBlock Text="{Binding ExternalTargetText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding ExternalReplacesText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}" Margin="0,0,0,8"
                             Visibility="{Binding ExternalReplaces, Converter={StaticResource Visible}}" />
