                      <TextBlock Text="{Binding S[external.intro]}" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <ItemsControl ItemsSource="{Binding ExternalRows}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" FontWeight="Bold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Help}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,4,0,8" />
