                    <!-- Development tools only: the DEV catalog override and the native offline session. -->
                    <WrapPanel Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}">
                      <Button Click="OnNavHome" Padding="10,6" Margin="0,0,8,8" AutomationProperties.Name="{Binding S[welcome.back]}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconBack}" Style="{StaticResource InlineIcon}" Margin="0,0,6,0" /><TextBlock Text="{Binding S[welcome.back]}" VerticalAlignment="Center" /></StackPanel></Button>
                      <Button Content="{Binding S[integrity.choose]}" Click="OnChooseContent" IsEnabled="{Binding CanChooseContent}" ToolTip="{Binding IntegrityLocationLabel}" Padding="10,6" Margin="0,0,8,8" />
                      <!-- Hidden (as on Configure) when there is no hook package to install: an empty label is no button. -->
                      <Button Click="OnInstallHook" IsEnabled="{Binding CanInstallHook}" Padding="10,6" Margin="0,0,8,8" AutomationProperties.Name="{Binding HookInstallLabel}"
                              Visibility="{Binding CanInstallHook, Converter={StaticResource Visible}}"><TextBlock Text="{Binding HookInstallLabel}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
                    </WrapPanel>
                    <Button Click="OnLoadModCatalog" Padding="10,8" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8"
                            ToolTip="{Binding S[mods.refresh_catalog]}" AutomationProperties.Name="{Binding S[mods.refresh_catalog]}">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource InlineIcon}" Width="16" Height="16" StrokeThickness="2" />
                        </Button>
                    <Button Content="{Binding S[mods.folder_short]}" Click="OnChooseAzimuth" Padding="10,6" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8"
                            ToolTip="{Binding ModFolder}" AutomationProperties.Name="{Binding S[mods.choose_folder]}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding ModCatalogSummary}" ToolTip="{Binding ModCatalogStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                  <!-- OD-116: a player-chosen catalog is never shown without this warning. -->
                  <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,8,0,0" BorderBrush="{StaticResource InfinityGold}"
                          Visibility="{Binding UsingCustomCatalog, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding CustomCatalogWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}" />
                      <Button Content="{Binding S[catalog.use_official]}" Style="{StaticResource LinkButton}" Click="OnUseOfficialCatalog" HorizontalAlignment="Left"
                              IsEnabled="{Binding CanUseOfficialCatalog}" Margin="-6,4,0,0" />
                    </StackPanel>
                  </Border>
                  <!-- H4/§1.4: production recovery, always with a resolution. -->
                  <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0" Visibility="{Binding ShowModRecovery, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding S[mods.recovery_title]}" FontWeight="Bold" />
                      <TextBlock Text="{Binding ModRecoveryText}" TextWrapping="Wrap" Margin="0,6,0,8" />
                      <WrapPanel>
                        <Button Content="{Binding S[mods.recover]}" Click="OnRecoverMods" IsEnabled="{Binding CanRecoverMods}" Padding="10,6" Margin="0,0,8,6" />
                        <Button Content="{Binding S[mods.resolve]}" Click="OnResolveMods" IsEnabled="{Binding CanResolveMods}" Padding="10,6" Margin="0,0,8,6"
                                ToolTip="{Binding S[mods.resolve_hint]}" />
                        <Button Content="{Binding S[mods.relink]}" Click="OnRelinkMods" IsEnabled="{Binding ModsIdle}" Padding="10,6" Margin="0,0,8,6"
                                Visibility="{Binding HasModRelink, Converter={StaticResource Visible}}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding S[mods.resolve_hint]}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <!-- OD-126: the mods of ExtraOptions' loader (<Azimuth>\mods) copied there by hand (owner 2026-10-28: the launcher's own
                     catalog and custom mods have their cards above), each marked as such with a note on online play. -->
                <StackPanel Margin="0,0,0,18" Visibility="{Binding HasExtraOptionsMods, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding S[eomods.title]}" FontSize="16" FontWeight="Bold" />
                  <TextBlock Text="{Binding ExtraOptionsModsHint}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding ExtraOptionsModsFolder}" TextWrapping="Wrap" Margin="0,2,0,10" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                  <ItemsControl ItemsSource="{Binding ExtraOptionsModItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,12,8">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                              <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" />
                              <TextBlock Text="{Binding DataContext.S[eomods.manual_online], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Content="{Binding Toggle}" Click="OnToggleExtraOptionsMod" IsEnabled="{Binding CanToggle}"
                                      Padding="12,7" Margin="12,0,0,0" AutomationProperties.Name="{Binding Toggle}" />
                              <!-- Owner 2026-10-28: an off manual mod can be deleted from the mods folder (asked twice). -->
                              <Button Content="{Binding DeleteLabel}" Click="OnDeleteExtraOptionsMod" IsEnabled="{Binding CanDelete}"
                                      Padding="12,7" Margin="8,0,0,0" AutomationProperties.Name="{Binding DeleteLabel}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding S[mods.search_none]}" TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{StaticResource InfinityMuted}"
                           Visibility="{Binding NoMatchingMods, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding FilteredModCards}" Visibility="{Binding HasModCards, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Width="230" Height="144" Padding="0" Margin="0,0,12,12">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                          <Button Click="OnSelectMod" Style="{StaticResource ModCardButton}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,24,0" ToolTip="{Binding Name}" />
                              <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,5,0,0" />
                              <TextBlock Text="{Binding CustomBadge}" Foreground="{StaticResource InfinityPink}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                                         Visibility="{Binding ShowSourceBadge, Converter={StaticResource Visible}}" />
                              <TextBlock Text="{Binding Badge}" Foreground="{StaticResource InfinityGold}" FontSize="12" Margin="0,12,0,0"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                            </StackPanel>
                          </Button>
                          <Button Content="i" Click="OnModInformation" Width="24" Height="24" Padding="0" Margin="0,9,9,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="Bold" FontStyle="Italic"
                                  ToolTip="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}"
                                  AutomationProperties.Name="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}" />
                          <Button Grid.Row="1" Content="{Binding Action}" Click="OnActOnMod" IsEnabled="{Binding CanAct}"
                                  Visibility="{Binding ShowAction, Converter={StaticResource Visible}}" Padding="10,7" Margin="14,0,14,14" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ModCatalogStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource InfinityMuted}" />
                <!-- T2b: a catalog that failed offers a retry and the way to another catalog (the card is on Configure). -->
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding ModCatalogFailed, Converter={StaticResource Visible}}">
                  <Button Content="{Binding S[mods.catalog_retry]}" Click="OnLoadModCatalog" IsEnabled="{Binding ModsIdle}" Padding="10,6" Margin="0,0,8,8" />
                  <Button Content="{Binding S[mods.catalog_other]}" Click="OnOpenCatalogSetting" Padding="10,6" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
              </ScrollViewer>
            </DockPanel>

            <!-- The options sidebar: the INI as a form; Save and Undo stay at the bottom. -->
            <Border Grid.Column="1" Width="360" Margin="0,-28,-40,-16" Padding="22,22,8,16" Background="{StaticResource InfinitySurface}"
                    BorderBrush="#3365184D" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowModOptions, Converter={StaticResource Visible}}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,12,0">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}"
                          Click="OnCloseModPanel" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding S[mods.options_title]}" FontSize="20" FontWeight="Bold" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedMod.Name}" Style="{StaticResource PageSubtitle}" Margin="0,2,12,0" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="{Binding S[mods.save_options]}" Click="OnSaveIni" IsEnabled="{Binding IniDirty}"
                          Style="{StaticResource AccentButtonStyle}" />
                  <Button Content="{Binding S[mods.revert_options]}" Margin="10,0,0,0" Click="OnRevertIni" IsEnabled="{Binding IniDirty}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding S[mods.options_hint]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                    <ItemsControl ItemsSource="{Binding ModOptions}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,8,0,10" IsEnabled="{Binding Editable}">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" FontSize="11" Margin="0,4,0,6" />
                          <TextBlock Text="{Binding LockReason}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" FontSize="11" Margin="0,0,0,6"
                                     Visibility="{Binding HasLockReason, Converter={StaticResource Visible}}" />
                          <CheckBox IsChecked="{Binding Checked}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" />
                          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsNumber, Converter={StaticResource Visible}}" />
                          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text}" Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" />
                        </StackPanel>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Width="360" Margin="0,-28,-40,-16" Padding="22,22,16,16" Background="{StaticResource InfinitySurface}"
                    BorderBrush="#3365184D" BorderThickness="1,0,0,0" Visibility="{Binding ShowModInfo, Converter={StaticResource Visible}}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}" Click="OnCloseModPanel" />
                  <TextBlock Text="{Binding S[mods.information]}" FontSize="20" FontWeight="Bold" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding SelectedMod.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedMod.Credits}" FontSize="11" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedMod.CustomBadge}" Foreground="{StaticResource InfinityPink}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                               Visibility="{Binding SelectedMod.ShowSourceBadge, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding SelectedMod.Description}" TextWrapping="Wrap" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding SelectedMod.Status}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding SelectedMod.Requirements}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
                    <!-- OD-114: an unreviewed custom mod is confirmed for its exact digest before its first install or enable. -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0" Visibility="{Binding SelectedModNeedsConfirmation, Converter={StaticResource Visible}}">
                      <StackPanel>
                        <TextBlock Text="{Binding S[mods.custom_confirm_title]}" FontWeight="Bold" Foreground="{StaticResource InfinityGold}" />
                        <TextBlock Text="{Binding SelectedModConfirmation}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                        <Button Content="{Binding S[mods.custom_confirm]}" Click="OnConfirmCustomMod" IsEnabled="{Binding CanConfirmCustomMod}"
                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                      </StackPanel>
                    </Border>
                    <!-- Alex (1.0.11): every Install first says where the mod goes and which existing files it replaces (backed up, restored later). -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding SelectedModInstallPreview, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding InstallPreviewText}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                      <TextBlock Text="{Binding InstallPreviewFiles}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource InfinityMuted}"
                                 Visibility="{Binding InstallPreviewHasFiles, Converter={StaticResource Visible}}" />
                      <Button x:Name="InstallPreviewButton" Content="{Binding InstallPreviewLabel}" Click="OnConfirmInstall" IsEnabled="{Binding CanConfirmInstall}"
                              Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                    <!-- M5 reviewed update: the change first, then the confirmation. -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding SelectedModUpdate, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding SelectedMod.UpdateSummary}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="{Binding UpdatePreviewText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding UpdatePreviewFiles}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource InfinityMuted}"
                                 Visibility="{Binding UpdatePreviewHasFiles, Converter={StaticResource Visible}}" />
                      <Button x:Name="ConfirmUpdateButton" Content="{Binding ConfirmUpdateLabel}" Click="OnConfirmModUpdate" IsEnabled="{Binding CanConfirmModUpdate}"
                              Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                    <!-- H3: changed files are a warning with two choices; M6: settings repair. -->
                    <WrapPanel Margin="0,14,0,0">
                      <Button Content="{Binding S[mods.accept_files]}" Click="OnAcceptModFiles" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModDrift, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.disable_keep]}" Click="OnDisableModKeeping" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModCanDisableKeeping, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.repair_settings]}" Click="OnRepairModSettings" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModSettingsIssues, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.uninstall]}" Click="OnUninstallMod" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModCanUninstall, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.purge]}" Click="OnPurgeMod" Padding="10,6" Margin="0,0,8,8"
                              ToolTip="{Binding S[mods.purge_hint]}" Visibility="{Binding SelectedModCanPurge, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <!-- OD-117: an installed mod of the player's own files: check its files again, or point at another copy. -->
                    <!-- T2c: the label wraps inside the pane (pt-BR was clipped mid-word). -->
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding SelectedModExternal, Converter={StaticResource Visible}}">
                      <Button Click="OnOpenExternalSetup" Padding="10,6" Margin="0,0,8,8" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                              AutomationProperties.Name="{Binding S[external.recheck]}">
                        <TextBlock Text="{Binding S[external.recheck]}" TextWrapping="Wrap" />
                      </Button>
                    </StackPanel>
                    <Button Content="{Binding S[mods.options]}" Click="OnSelectedModOptions" Margin="0,18,0,0"
                            Visibility="{Binding SelectedMod.HasOptions, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding SelectedModFiles}" TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0" Foreground="{StaticResource InfinityMuted}" />
                    <Expander Header="{Binding S[mods.files]}" Margin="0,12,0,0">
                      <ItemsControl ItemsSource="{Binding SelectedMod.Manifest.Files}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding Root}" Foreground="{StaticResource InfinityPink}" FontSize="10" />
                            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" FontSize="11" />
                          </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <!-- OD-117: set up a mod made of the player's own files; one row per source, then the notice and Install. -->
            <Border Grid.Column="1" Width="400" Margin="0,-28,-40,-16" Padding="22,22,16,16" Background="{StaticResource InfinitySurface}"
                    x:Name="ExternalPane" BorderBrush="#3365184D" BorderThickness="1,0,0,0" Visibility="{Binding ShowExternalSetup, Converter={StaticResource Visible}}"
                    KeyDown="OnExternalPaneKey">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}" Click="OnCloseExternalSetup" />
                  <TextBlock Text="{Binding ExternalSetupTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,8,0" Visibility="{Binding ShowBrowser, Converter={StaticResource Hidden}}">
                  <!-- The mod writes game files: the game folder comes first, in the pane, not as a refusal after Install. -->
                  <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10" Visibility="{Binding ExternalNeedsGameFolder, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <!-- The one game folder is Configure's (the same setting every mod and Play use); never a second choice here. -->
                      <TextBlock Text="{Binding S[external.game_folder]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityGold}" />
                      <Button Content="{Binding S[external.open_configure]}" Click="OnNavSetup" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding ExternalTargetText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding ExternalReplacesText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}" Margin="0,0,0,8"
                             Visibility="{Binding ExternalReplaces, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding ExternalNotice}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,10" />
                  <Button x:Name="ExternalInstallButton" Content="{Binding ExternalInstallLabel}" Click="OnInstallExternal" IsEnabled="{Binding CanInstallExternal}"
                          Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,8,0">
                    <!-- The sources -->
                    <StackPanel Visibility="{Binding ShowBrowser, Converter={StaticResource Hidden}}">
                      <TextBlock Text="{Binding S[external.intro]}" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <ItemsControl ItemsSource="{Binding ExternalRows}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" FontWeight="Bold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Help}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,4,0,8" />
                              <DockPanel>
                                <Path DockPanel.Dock="Left" Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="14" Height="14" StrokeThickness="2.4" Margin="0,0,8,0" Stroke="{StaticResource InfinityGood}"
                                           Visibility="{Binding ShowCheckMark, Converter={StaticResource Visible}}" />
                                <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Style="{StaticResource InlineIcon}" Width="14" Height="14" StrokeThickness="2" Margin="0,0,8,0" Stroke="{StaticResource InfinityGold}"
                                           Visibility="{Binding ShowWarningMark, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                              </DockPanel>
                              <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,8,0,0"
                                           Visibility="{Binding Checking, Converter={StaticResource Visible}}" />
                              <Expander Header="{Binding DataContext.S[external.details], RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,8,0,0"
                                        Visibility="{Binding HasDetails, Converter={StaticResource Visible}}">
                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" BorderThickness="0" Background="Transparent" />
                              </Expander>
                              <WrapPanel Margin="0,10,0,0">
                                <Button Content="{Binding DataContext.S[external.choose_folder], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Click="OnBrowseExternal" Padding="10,6" Margin="0,0,8,6" Visibility="{Binding PicksFolder, Converter={StaticResource Visible}}" />
                                <Button Content="{Binding DataContext.S[external.choose_file], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Click="OnBrowseExternal" Padding="10,6" Margin="0,0,8,6" Visibility="{Binding PicksFile, Converter={StaticResource Visible}}" />
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <!-- OD-41: start the profile from one of Azimuth's own saves on this PC (backed up, then cloned). -->
          <DockPanel MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ShowPickSave, Converter={StaticResource Visible}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="{Binding S[saves.pick_title]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding PickSaveText}" Margin="0,8,0,16" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button Margin="0,5" Padding="20,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Click="OnSkipSave" IsEnabled="{Binding Idle}">
                <StackPanel>
                  <TextBlock Text="{Binding S[saves.new_career]}" FontWeight="Bold" />
                  <TextBlock Text="{Binding S[saves.new_career_detail]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding S[saves.backup_note]}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource InfinityFaint}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
              <ItemsControl ItemsSource="{Binding SaveChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="0,5" Padding="20,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnPickSave" IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Grid>
    <!-- OD-118 (T1b): offline, a newer launcher on GitHub (checked from this PC to GitHub only): advice, never a block. -->
    <Border x:Name="GitHubAdvisory" Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="31" Background="{StaticResource InfinitySurfaceHigh}" Padding="22,10"
            Visibility="{Binding ShowGitHubAdvisory, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding S[updater.github_dismiss]}" Click="OnDismissGitHubAdvisory" Margin="10,0,0,0" />
        <Button DockPanel.Dock="Right" Content="{Binding S[updater.github_open]}" Click="OnOfficialReleases" Style="{StaticResource AccentButtonStyle}" Margin="16,0,0,0" />
        <TextBlock Text="{Binding GitHubAdvisoryText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource InfinityWarnSurface}" Padding="22,10"
            Visibility="{Binding ShowLauncherUpdateBanner, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding LauncherUpdateBannerAction}" Click="OnOpenLauncherUpdate" IsEnabled="{Binding CanRetryLauncherUpdate}" Margin="16,0,0,0" />
        <TextBlock Text="{Binding LauncherUpdateStatus}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="{StaticResource InfinityWarnSurface}" Padding="22,10"
            Visibility="{Binding ShowOnlineStatusBanner, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding S[online.retry]}" Click="OnCheckOnlineStatus" IsEnabled="{Binding CanCheckOnlineStatus}" Margin="16,0,0,0" />
        <StackPanel>
          <TextBlock Text="{Binding OnlineServiceMessage}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding OnlineRetryHint}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="{StaticResource InfinityBackground}"
            Visibility="{Binding ShowLauncherUpdate, Converter={StaticResource Visible}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="40,36" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{StaticResource BrandLogo}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,30" />
          <TextBlock Text="{Binding S[updater.title]}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LauncherUpdateStatus}" Margin="0,16,0,12" FontSize="17" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding LauncherUpdateVersion}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LauncherUpdateProgress}" Foreground="{StaticResource InfinityMuted}" Margin="0,10,0,0" />
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,18,0,14" Visibility="{Binding LauncherUpdateBusy, Converter={StaticResource Visible}}" />
          <WrapPanel Margin="0,20,0,12">
            <Button Content="{Binding S[updater.apply]}" Click="OnApplyLauncherUpdate" IsEnabled="{Binding CanApplyLauncherUpdate}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.cancel]}" Click="OnCancelLauncherUpdate" Visibility="{Binding CanCancelLauncherUpdate, Converter={StaticResource Visible}}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.retry]}" Click="OnCheckLauncherUpdates" IsEnabled="{Binding CanRetryLauncherUpdate}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.support]}" Click="OnUpdateSupport" IsEnabled="{Binding CanRetryLauncherUpdate}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.exit]}" Click="OnExitLauncherUpdate" Margin="0,0,10,10" />
          </WrapPanel>
          <TextBlock Text="{Binding S[updater.help]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="{StaticResource InfinityBackground}"
            Visibility="{Binding ShowOnlineStatusPage, Converter={StaticResource Visible}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="40,36" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{StaticResource BrandLogo}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,30" />
          <TextBlock Text="{Binding OnlineServiceTitle}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OnlineServiceMessage}" Margin="0,16,0,12" FontSize="17" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding OnlineRetryHint}" Foreground="{StaticResource InfinityGold}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding S[online.resume]}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="{Binding OnlineServicePaused, Converter={StaticResource Visible}}" />
          <WrapPanel Margin="0,20,0,12">
            <Button Content="{Binding S[online.retry]}" Click="OnCheckOnlineStatus" IsEnabled="{Binding CanCheckOnlineStatus}" Margin="0,0,10,10" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="{Binding S[online.continue]}" Click="OnCloseOnlineStatus" Visibility="{Binding OnlineServiceAllowsPlay, Converter={StaticResource Visible}}" Margin="0,0,10,10" />
            <!-- OD-118: never stranded here: the launcher works offline. -->
            <Button x:Name="StatusPlayOffline" Content="{Binding S[offline.play_offline_link]}" Click="OnPlayOfflineFromStatus" Margin="0,0,10,10"
                    Visibility="{Binding CanPlayOfflineFromStatus, Converter={StaticResource Visible}}" />
            <Button Content="{Binding S[online.support]}" Click="OnOnlineSupport" Margin="0,0,10,10" />
            <Button Content="{Binding S[online.updates]}" Click="OnOpenLauncherUpdate" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.exit]}" Click="OnExitLauncherUpdate" Margin="0,0,10,10" />
          </WrapPanel>
          <TextBlock Text="{Binding OnlineServiceHelp}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
          <Button Content="{Binding S[mods.dev_open]}" Click="OnNavMods" HorizontalAlignment="Left" Margin="0,16,0,0"
                  Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}" IsEnabled="{Binding ModsIdle}" />
          <Button Click="OnDiscord" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="{Binding S[nav.discord]}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding S[nav.discord]}" VerticalAlignment="Center" /><Path Data="{StaticResource IconExternal}" Style="{StaticResource InlineIcon}" Margin="6,0,0,0" /></StackPanel></Button>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource InfinityWarnSurface}"
            BorderBrush="{StaticResource InfinityGold}" BorderThickness="0,1,0,0" Padding="20,10"
            Visibility="{Binding ShowBuildOriginWarning, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding S[build_origin.releases]}" Click="OnOfficialReleases"
                VerticalAlignment="Center" Margin="18,0,0,0" Padding="12,6" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding S[build_origin.title]}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InfinityGold}" />
          <TextBlock Text="{Binding S[build_origin.warning]}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding S[legal.about]}" Click="OnAbout" Margin="16,0,0,0" Padding="10,4" />
        <Button DockPanel.Dock="Right" Content="{Binding S[online.view]}" Click="OnOpenOnlineStatus" Margin="16,0,0,0" Padding="10,4"
                    Visibility="{Binding CanViewOnlineStatus, Converter={StaticResource Visible}}" />
        <Border DockPanel.Dock="Left" Padding="9,4" Margin="0,0,16,0" VerticalAlignment="Center" CornerRadius="4"
                Background="{StaticResource InfinityWarnSurface}">
          <TextBlock Text="BETA" Foreground="{StaticResource InfinityGold}" FontWeight="Bold" FontSize="10" />
        </Border>
        <TextBlock Text="{Binding S[beta.notice]}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{StaticResource InfinityMuted}" />
      </DockPanel>
    </Border>
  </Grid>
    <!-- Owner 2026-10-28: an Azimuth never opened (data has only bin) blocks everything, like the mod progress dialog below. -->
    <Border x:Name="AzimuthFirstRunOverlay" Background="#FF0E0B16" Panel.ZIndex="95"
            Visibility="{Binding ShowAzimuthFirstRun, Converter={StaticResource Visible}}"
            Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="40,32" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding S[azimuth_firstrun.title]}" FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AzimuthFirstRunBody}" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{Binding AzimuthFirstRunStatus}" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                     Foreground="{StaticResource InfinityGold}" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding HasAzimuthFirstRunStatus, Converter={StaticResource Visible}}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button x:Name="AzimuthFirstRunLaunch" Content="{Binding S[azimuth_firstrun.launch]}" Click="OnLaunchAzimuthFirstRun"
                    Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0" />
            <Button Content="{Binding S[azimuth_firstrun.check]}" Click="OnCheckAzimuthFirstRun" Padding="14,8" Margin="0,0,10,0" />
            <!-- another Azimuth folder, when this one is a fresh copy beside the one the player uses -->
            <Button Content="{Binding S[setup.choose]}" Click="OnChooseAzimuth" Padding="14,8" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- T2b/T4b: an opaque backdrop, and no opacity or effect on the content under it: under Wine, any composited dim or blur
         drew the text boxes behind it as solid grey bars. Nothing behind the dialog needs to show while a mod operation runs. -->
    <Border x:Name="ModProgressOverlay" Background="#FF0E0B16" Panel.ZIndex="100"
            Visibility="{Binding ModOperationBusy, Converter={StaticResource Visible}}"
            Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="40,32" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Grid Width="48" Height="48" Margin="0,0,0,22">
            <Ellipse Stroke="{StaticResource InfinityBorder}" StrokeThickness="4" />
            <Path Data="M 24,2 A 22,22 0 0 1 46,24" Stroke="{StaticResource InfinityPink}" StrokeThickness="4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
              <Path.Style>
                <Style TargetType="Path">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ModOperationBusy}" Value="True">
                      <DataTrigger.EnterActions><BeginStoryboard x:Name="ModSpinner"><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                      </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ModSpinner" /></DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Grid>
          <TextBlock Text="{Binding S[mods.progress.title]}" FontSize="22" FontWeight="Bold" TextAlignment="Center" />
          <TextBlock Text="{Binding ModProgress}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding S[mods.progress.hint]}" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
        </StackPanel>
      </Border>
    </Border>
    <!-- Owner 2026-10-28: the launcher's own file and folder picker for every caller (never the Windows dialog): a pane on the
         right above any screen (the first-run notice too); a pick goes back to the caller, the backdrop or Escape (B) cancels. -->
    <Grid Panel.ZIndex="96" Visibility="{Binding ShowBrowser, Converter={StaticResource Visible}}">
      <!-- No dim: under Wine a composited backdrop draws the text boxes behind it as grey bars (T2b/T4b); a transparent one still takes the click. -->
      <Border Background="Transparent" MouseDown="OnPickerBackdrop" />
      <Border x:Name="PickerPane" HorizontalAlignment="Right" Width="440" Padding="22,22,16,16" Background="{StaticResource InfinitySurface}"
              BorderBrush="#3365184D" BorderThickness="1,0,0,0" KeyDown="OnPickerPaneKey">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{Binding S[external.cancel]}" Style="{StaticResource LinkButton}" Click="OnStopBrowsing" />
            <TextBlock Text="{Binding BrowserTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="BrowserPanel" Visibility="{Binding ShowBrowser, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding BrowserPlaces}" Margin="0,0,0,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding Label}" Click="OnBrowsePlace" Padding="8,4" Margin="0,0,6,6" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="{Binding S[external.go]}" Click="OnBrowseDraft" Padding="10,6" Margin="6,0,0,0" />
              <TextBox x:Name="BrowserPathBox" Text="{Binding BrowserDraft, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" KeyDown="OnBrowserPathKey"
                       AutomationProperties.Name="{Binding S[external.path]}" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,8">
              <Button x:Name="BrowserUpButton" Content="{Binding S[external.up]}" Click="OnBrowseUp" Padding="10,6" Margin="0,0,8,6" />
              <Button Content="{Binding BrowserPickLabel}" Click="OnPickBrowserFolder" IsEnabled="{Binding BrowserCanPickFolder}"
                                Visibility="{Binding BrowserPicksFolder, Converter={StaticResource Visible}}"
                      Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,6" />
              <Button Content="{Binding S[external.cancel]}" Click="OnStopBrowsing" Padding="10,6" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock Text="{Binding S[external.empty_folder]}" Foreground="{StaticResource InfinityMuted}" FontSize="12"
                       Visibility="{Binding BrowserEmpty, Converter={StaticResource Visible}}" />
            <ItemsControl x:Name="BrowserList" ItemsSource="{Binding BrowserEntries}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Click="OnBrowserEntry" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,4" AutomationProperties.Name="{Binding Name}">
                  <StackPanel Orientation="Horizontal">
                    <!-- Bundled icons (Wine has no emoji font): a folder, or a ZIP or file to pick. -->
                    <Path Width="16" Height="16" Margin="0,0,10,0">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource InlineIcon}">
                          <Setter Property="Data" Value="{StaticResource IconArchive}" />
                          <Style.Triggers><DataTrigger Binding="{Binding Folder}" Value="True"><Setter Property="Data" Value="{StaticResource IconFolder}" /></DataTrigger></Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
