<Window x:Class="Infinity.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Infinity.App"
        Title="Infinity Horizon · BETA" Width="1180" Height="780" MinWidth="960" MinHeight="640"
        Icon="pack://application:,,,/Assets/infinity.ico"
        WindowStartupLocation="CenterScreen" Background="{StaticResource InfinityBackground}"
        Foreground="{StaticResource InfinityText}" FontFamily="{StaticResource InfinityFont}" FontSize="14">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <local:InverseVisibility x:Key="Hidden" />
    <Style x:Key="ModCardButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource InfinitySurfaceHigh}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Grid x:Name="ShellContent" IsEnabled="{Binding ModContentEnabled}">
    <Grid.Style>
      <Style TargetType="Grid">
        <Style.Triggers>
          <DataTrigger Binding="{Binding ModOperationBusy}" Value="True">
            <Setter Property="Effect"><Setter.Value><BlurEffect Radius="9" /></Setter.Value></Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar: the wordmark, HOME, AZIMUTH, MODS, NEWS, HELP ... ACCOUNT, DONATE, server, version.
         Players browse and join worlds only in the in-game overlay (OD-54): the launcher has no Servers
         page. The one exception is the admins' dedicated lobby (OD-109): the top bar's globe and its pane. -->
    <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource InfinitySidebar}" IsEnabled="{Binding Idle}"
          Visibility="{Binding SignedIn, Converter={StaticResource Visible}}">
      <Image Source="{StaticResource BrandLines}" Stretch="UniformToFill" VerticalAlignment="Bottom" Height="150"
             Opacity="0.18" IsHitTestVisible="False" />
      <Border BorderBrush="#3365184D" BorderThickness="0,0,1,0" />
      <DockPanel Margin="0,0,0,14">
        <Image DockPanel.Dock="Top" Source="{StaticResource BrandLogo}" Width="172" Margin="22,22,22,12"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,12,0">
          <Button Content="{Binding S[nav.help]}" Style="{StaticResource NavButton}" IsEnabled="{Binding Ready}" />
          <Button Content="{Binding S[nav.bug]}" Style="{StaticResource NavButton}" Click="OnNavBugReport" Tag="{Binding ShowBugReport}" />
          <Button Content="{Binding S[nav.discord]}" Style="{StaticResource NavButton}" Click="OnDiscord" />
          <Border Height="1" Background="{StaticResource InfinityBorder}" Margin="20,8,8,8" />
          <Button Content="{Binding S[nav.account]}" Style="{StaticResource NavButton}" IsEnabled="{Binding CanChangeIdentity}" Click="OnNavAccount" Tag="{Binding ShowAccount}" />
          <Button Content="{Binding S[nav.donate]}" Style="{StaticResource NavButton}" IsEnabled="{Binding Ready}" />
          <TextBlock Text="{Binding ServerLabel}" Margin="20,14,0,0" FontSize="11" Foreground="{StaticResource InfinityFaint}" />
          <TextBlock Text="{Binding VersionLabel}" Margin="20,2,0,0" FontSize="11" Foreground="{StaticResource InfinityFaint}" />
        </StackPanel>
        <StackPanel Margin="0,0,12,0">
          <Button Content="{Binding S[nav.play]}" Style="{StaticResource NavButton}" Click="OnNavHome" Tag="{Binding ShowHome}" />
          <!-- All game configuration and validation live here. -->
          <Button Style="{StaticResource NavButton}" Click="OnNavSetup" Tag="{Binding ShowSetup}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding S[nav.configure]}" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="#E41E28" VerticalAlignment="Center"
                       ToolTip="{Binding S[play.setup_needed]}" AutomationProperties.Name="{Binding S[play.setup_needed]}"
                       Visibility="{Binding SetupNeeded, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Button>
          <!-- OD-45: Mods, with a small tag when there is news (an update, or a release not seen yet). -->
          <Button Style="{StaticResource NavButton}" IsEnabled="{Binding CanOpenMods}" Click="OnNavMods" Tag="{Binding ShowMods}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding S[nav.mods]}" VerticalAlignment="Center" />
              <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="8" Background="{StaticResource InfinitySunset}"
                      VerticalAlignment="Center" Visibility="{Binding ModsNews, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding ModsTag}" FontSize="10" FontWeight="Bold" Foreground="White" />
              </Border>
            </StackPanel>
          </Button>
          <Button Content="{Binding S[nav.news]}" Style="{StaticResource NavButton}" IsEnabled="{Binding Ready}" />
        </StackPanel>
      </DockPanel>
    </Grid>

    <!-- The page area: Home's art behind everything, then the top bar, the page and the status line. -->
    <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
      <Grid IsHitTestVisible="False" Visibility="{Binding ShowHero, Converter={StaticResource Visible}}">
        <Image Source="{StaticResource BrandHero}" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9" />
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="#FF0E0616" Offset="0.05" />
              <GradientStop Color="#C00E0616" Offset="0.45" />
              <GradientStop Color="#300E0616" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="#CC0E0616" Offset="0" />
              <GradientStop Color="#000E0616" Offset="0.25" />
              <GradientStop Color="#000E0616" Offset="0.7" />
              <GradientStop Color="#FF0E0616" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
      <!-- Sign-in: the infinity mark, large and faint, anchored at the bottom-right corner (owner). -->
      <Image Source="{StaticResource BrandMark}" Width="1100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-40"
             Opacity="0.12" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"
             Visibility="{Binding ShowSignIn, Converter={StaticResource Visible}}" />
      <!-- Speed streaks, faint, on every page but Home. -->
      <Image Source="{StaticResource BrandStreaks}" Width="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,-120,0"
             Opacity="0.10" IsHitTestVisible="False" Visibility="{Binding ShowHome, Converter={StaticResource Hidden}}" />

      <DockPanel>
        <!-- Top bar: connection / GAME (change) / profile (change) ... e-mail (exit). -->
        <Border DockPanel.Dock="Top" Padding="22,14" BorderThickness="0,0,0,1" BorderBrush="#1FF9EAEE"
                Visibility="{Binding SignedIn, Converter={StaticResource Visible}}">
          <DockPanel LastChildFill="False">
            <Border DockPanel.Dock="Left" Padding="10,4" CornerRadius="12" Background="#26F9EAEE" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource InfinityFaint}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Online}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource InfinityAccent}" />
                          <Setter Property="Effect" Value="{StaticResource InfinityGlow}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Connection}" Margin="8,0,0,0" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource InfinityMuted}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                        IsEnabled="{Binding CanChangeIdentity}"
                        Visibility="{Binding SignedIn, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding GameLabel}" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Content="{Binding S[shell.change]}" Style="{StaticResource LinkButton}" Click="OnChangeGame" />
              <TextBlock Text="/" Margin="10,0" Foreground="{StaticResource InfinityFaint}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ProfileLabel}" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Content="{Binding S[shell.change]}" Style="{StaticResource LinkButton}" Click="OnChangeProfile" />
            </StackPanel>
            <!-- OD-109: the dedicated lobby, top right (admins). A Path, not an icon font: Proton has none. -->
            <Button x:Name="LobbyButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="14,0,0,0" Padding="4"
                    Click="OnToggleLobbyPane" VerticalAlignment="Center"
                    ToolTip="{Binding S[lobby.open]}" AutomationProperties.Name="{Binding S[lobby.open]}"
                    Visibility="{Binding ShowLobbyButton, Converter={StaticResource Visible}}">
              <Grid Width="22" Height="22">
                <Path Stretch="Uniform" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M2,12 L22,12 M12,2 C7.5,6.5 7.5,17.5 12,22 M12,2 C16.5,6.5 16.5,17.5 12,22 M4,7 L20,7 M4,17 L20,17" />
                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                         Fill="{StaticResource InfinityAccent}" Effect="{StaticResource InfinityGlow}"
                         Visibility="{Binding DedicatedActive, Converter={StaticResource Visible}}" />
              </Grid>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        IsEnabled="{Binding CanChangeIdentity}"
                        Visibility="{Binding SignedIn, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Email}" MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}"
                         VerticalAlignment="Center" Foreground="{StaticResource InfinityMuted}" />
              <Button Content="{Binding S[shell.exit]}" Style="{StaticResource LinkButton}" Click="OnSignOut" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- OD-109: the dedicated lobby pane, modelled on the Mods options sidebar. Escape (B) closes it. -->
        <Border x:Name="LobbyPane" DockPanel.Dock="Right" Width="400" Padding="22,22,8,16" Background="{StaticResource InfinitySurface}"
                BorderBrush="#3365184D" BorderThickness="1,0,0,0" KeyDown="OnLobbyPaneKey"
                Visibility="{Binding ShowLobbyPane, Converter={StaticResource Visible}}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,12,0">
              <Button DockPanel.Dock="Right" Content="{Binding S[lobby.close]}" Style="{StaticResource LinkButton}"
                      Click="OnToggleLobbyPane" VerticalAlignment="Center" />
              <TextBlock Text="{Binding S[lobby.title]}" FontSize="20" FontWeight="Bold" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding S[lobby.subtitle]}" Style="{StaticResource PageSubtitle}" Margin="0,2,12,0" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="LobbyCreateButton" Content="{Binding S[lobby.create]}" Click="OnStartLobby" IsEnabled="{Binding CanCreateLobby}"
                      Style="{StaticResource AccentButtonStyle}" Visibility="{Binding DedicatedActive, Converter={StaticResource Hidden}}" />
              <Button x:Name="LobbyStopButton" Content="{Binding S[lobby.stop]}" Click="OnStopLobby" IsEnabled="{Binding CanStopLobby}"
                      Visibility="{Binding DedicatedActive, Converter={StaticResource Visible}}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding LobbyHint}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityGold}" Margin="0,0,0,10"
                           Visibility="{Binding HasLobbyHint, Converter={StaticResource Visible}}" />
                <StackPanel IsEnabled="{Binding CanEditLobby}">
                  <TextBlock Text="{Binding S[lobby.name]}" Style="{StaticResource SectionTag}" />
                  <TextBox x:Name="LobbyNameBox" Text="{Binding LobbyName, UpdateSourceTrigger=PropertyChanged}" MaxLength="48" Margin="0,6,0,14" />
                  <TextBlock Text="{Binding S[lobby.audience]}" Style="{StaticResource SectionTag}" />
                  <WrapPanel Margin="0,6,0,14">
                    <RadioButton Content="{Binding S[lobby.audience_everyone]}" IsChecked="{Binding LobbyAudienceEveryone}" GroupName="LobbyAudience" Margin="0,0,14,6" />
                    <RadioButton Content="{Binding S[lobby.audience_supporters]}" IsChecked="{Binding LobbyAudienceSupporters}" GroupName="LobbyAudience" Margin="0,0,14,6" />
                    <RadioButton Content="{Binding S[lobby.audience_friends]}" IsChecked="{Binding LobbyAudienceFriends}" GroupName="LobbyAudience" Margin="0,0,14,6" />
                    <RadioButton Content="{Binding S[lobby.audience_private]}" IsChecked="{Binding LobbyAudiencePrivate}" GroupName="LobbyAudience" Margin="0,0,14,6" />
                  </WrapPanel>
                  <TextBlock Text="{Binding S[lobby.max_players]}" Style="{StaticResource SectionTag}" />
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                    <Button Content="-" Click="OnLobbyFewer" IsEnabled="{Binding CanLobbyFewer}" MinWidth="36" AutomationProperties.Name="-" />
                    <TextBlock Text="{Binding LobbyMaxPlayersText}" FontSize="18" FontWeight="Bold" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+" Click="OnLobbyMore" IsEnabled="{Binding CanLobbyMore}" MinWidth="36" AutomationProperties.Name="+" />
                  </StackPanel>
                  <TextBlock Text="{Binding S[lobby.max_players_hint]}" FontSize="11" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" Margin="0,0,0,14" />
                  <TextBlock Text="{Binding S[lobby.latency]}" Style="{StaticResource SectionTag}" />
                  <WrapPanel Margin="0,6,0,14">
                    <RadioButton Content="{Binding S[lobby.latency_any]}" IsChecked="{Binding LobbyLatencyAny}" GroupName="LobbyLatency" Margin="0,0,14,6" />
                    <RadioButton Content="{Binding S[lobby.latency_150]}" IsChecked="{Binding LobbyLatency150}" GroupName="LobbyLatency" Margin="0,0,14,6" />
                    <RadioButton Content="{Binding S[lobby.latency_100]}" IsChecked="{Binding LobbyLatency100}" GroupName="LobbyLatency" Margin="0,0,14,6" />
                    <RadioButton Content="{Binding S[lobby.latency_60]}" IsChecked="{Binding LobbyLatency60}" GroupName="LobbyLatency" Margin="0,0,14,6" />
                  </WrapPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding S[lobby.races]}" Foreground="{StaticResource InfinityMuted}" Margin="0,0,14,4" />
                    <TextBlock Grid.Column="1" Text="{Binding LobbyRaces}" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="{Binding S[lobby.mode]}" Foreground="{StaticResource InfinityMuted}" Margin="0,0,14,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LobbyMode}" FontWeight="Bold" />
                  </Grid>
                </StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding S[lobby.status]}" Foreground="{StaticResource InfinityMuted}" Margin="0,0,14,4" />
                    <TextBlock Grid.Column="1" Text="{Binding LobbyStateText}" FontWeight="Bold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Grid.Row="1" Text="{Binding S[lobby.code]}" Foreground="{StaticResource InfinityMuted}" Margin="0,0,14,4"
                               Visibility="{Binding ShowLobbyCode, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LobbyCode}" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding ShowLobbyCode, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Row="2" Text="{Binding S[lobby.players]}" Foreground="{StaticResource InfinityMuted}" Margin="0,0,14,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LobbyPlayers}" />
                    <TextBlock Grid.Row="3" Text="{Binding S[lobby.uptime]}" Foreground="{StaticResource InfinityMuted}" Margin="0,0,14,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LobbyUptime}" />
                  </Grid>
                </Border>
                <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource InfinityDangerSurface}"
                        BorderBrush="{StaticResource InfinityDangerBorder}" BorderThickness="1"
                        Visibility="{Binding HasLobbyError, Converter={StaticResource Visible}}">
                  <StackPanel>
                    <TextBlock Text="{Binding S[lobby.last_error]}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InfinityRose}" />
                    <TextBlock Text="{Binding LobbyLastError}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" AutomationProperties.LiveSetting="Assertive" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding S[lobby.running_hint]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding S[lobby.close_hint]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,0" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Status line. -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding DisplayMessage}" Margin="40,0,40,18" TextWrapping="Wrap"
                   Foreground="{StaticResource InfinityMuted}" />

        <!-- Content: one panel per step of sign-in -> game -> profile. -->
        <Grid Margin="40,28,40,16">
          <!-- A quiet first screen: the brand and one clear entrance. -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                      Visibility="{Binding ShowWelcome, Converter={StaticResource Visible}}">
            <Image Source="{StaticResource BrandLogo}" Width="480" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border HorizontalAlignment="Center" Margin="0,20,0,32" Padding="12,4" CornerRadius="4"
                    Background="{StaticResource InfinityWarnSurface}" BorderBrush="{StaticResource InfinityGold}" BorderThickness="1">
              <TextBlock Text="BETA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InfinityGold}" />
            </Border>
            <Button Content="{Binding S[welcome.sign_in]}" Click="OnOpenSignIn" Style="{StaticResource PlayButton}"
                    HorizontalAlignment="Center" Visibility="{Binding Resuming, Converter={StaticResource Hidden}}" />
            <TextBlock Text="{Binding S[native.signing_in]}" HorizontalAlignment="Center" FontSize="16"
                       Foreground="{StaticResource InfinityMuted}" Visibility="{Binding Resuming, Converter={StaticResource Visible}}" />
            <Button Content="{Binding S[mods.dev_open]}" Click="OnNavMods" Margin="0,16,0,0"
                    Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}" HorizontalAlignment="Center" />
          </StackPanel>
          <!-- OD-74: native sign-in; the confirmation step owns its temporary credentials. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSignIn, Converter={StaticResource Visible}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <Border Style="{StaticResource Card}" Padding="28,24">
              <StackPanel>
                <Button Content="{Binding S[welcome.back]}" Click="OnWelcome" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="-6,0,0,14" IsEnabled="{Binding Idle}" />
                <TextBlock Text="{Binding S[signin.title]}" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Text="{Binding S[native.subtitle]}" Margin="0,6,0,20" Style="{StaticResource PageSubtitle}" />
                <StackPanel Visibility="{Binding AwaitingVerification, Converter={StaticResource Hidden}}">
                  <TextBlock Text="{Binding S[native.email]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  <TextBox x:Name="EmailBox" Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" IsEnabled="{Binding CanStartOnlineAccount}" />
                  <TextBlock Text="{Binding S[native.password]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  <PasswordBox x:Name="PasswordBox" Margin="0,6,0,4" IsEnabled="{Binding CanStartOnlineAccount}" KeyDown="OnPasswordKey" IsVisibleChanged="OnPasswordVisibility" />
                  <Button Content="{Binding S[native.forgot]}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,0,0,16" Click="OnForgot" IsEnabled="{Binding CanStartOnlineAccount}" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding S[native.sign_in]}" Click="OnNativeSignIn" IsEnabled="{Binding CanStartOnlineAccount}" Style="{StaticResource AccentButtonStyle}" />
                    <Button Grid.Column="2" Content="{Binding S[native.sign_up]}" Click="OnNativeSignUp" IsEnabled="{Binding CanCreateOnlineAccount}" />
                  </Grid>
                  <TextBlock Text="{Binding S[native.registration_disabled]}" Margin="0,12,0,0" TextWrapping="Wrap"
                             Visibility="{Binding ShowRegistrationDisabled, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Visibility="{Binding AwaitingVerification, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding S[native.check_title]}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <TextBlock Text="{Binding VerificationText}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,18" />
                  <Button Content="{Binding S[native.confirmed]}" Click="OnConfirmed" IsEnabled="{Binding CanStartOnlineAccount}" Style="{StaticResource AccentButtonStyle}" />
                  <Button Content="{Binding S[native.resend]}" Margin="0,12,0,0" Click="OnResend" IsEnabled="{Binding CanStartOnlineAccount}" />
                  <Button Content="{Binding S[native.change_login]}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,12,0,0" Click="OnCancelVerification" IsEnabled="{Binding Idle}" />
                </StackPanel>
                <Button Content="{Binding S[signin.cancel]}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="OnCancelSignIn" Visibility="{Binding Busy, Converter={StaticResource Visible}}" />
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>

          <!-- New account: the first profile's name. -->
          <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460" Padding="28,24"
                  Visibility="{Binding ShowNeedsAccount, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding S[signin.title]}" Style="{StaticResource PageTitle}" FontSize="24" />
              <TextBlock Text="{Binding NeedsAccountText}" Margin="0,8,0,18" Style="{StaticResource PageSubtitle}" />
              <TextBlock Text="{Binding S[signin.form_name]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
              <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,6,0,4" />
              <TextBlock Text="{Binding S[profiles.name_rule]}" FontSize="11" Foreground="{StaticResource InfinityFaint}" />
              <Button Content="{Binding S[signin.create]}" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="28,9"
                      Click="OnCreateAccount" IsEnabled="{Binding CanCreateOnlineAccount}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </Border>

          <!-- Account self-service: explicit typed confirmation and a fresh password proof. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowAccount, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="560" HorizontalAlignment="Center" Margin="24">
              <TextBlock Text="{Binding S[nav.account]}" Style="{StaticResource PageTitle}" />
              <Border Style="{StaticResource Card}" Padding="24" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding S[account.delete_title]}" FontSize="20" FontWeight="SemiBold" />
                  <StackPanel Visibility="{Binding HasDeletionPending, Converter={StaticResource Hidden}}" IsEnabled="{Binding Idle}">
                    <TextBlock Text="{Binding S[account.delete_body]}" Style="{StaticResource PageSubtitle}" Margin="0,12,0,18" />
                    <TextBlock Text="{Binding S[native.email]}" />
                    <TextBox Text="{Binding DeletionEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />
                    <TextBlock Text="{Binding DeletionHint}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding DeletionConfirmation, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />
                    <TextBlock Text="{Binding S[account.delete_password]}" />
                    <PasswordBox x:Name="DeletionPasswordBox" Margin="0,6,0,18" IsVisibleChanged="OnPasswordVisibility" />
                    <Button Content="{Binding S[account.delete_submit]}" Click="OnRequestDeletion" IsEnabled="{Binding CanRequestDeletion}" HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Visibility="{Binding HasDeletionPending, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding DeletionPendingText}" Style="{StaticResource PageSubtitle}" Margin="0,12,0,18" />
                    <Button Content="{Binding S[account.delete_cancel]}" Click="OnCancelDeletion" IsEnabled="{Binding CanChangeIdentity}" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Choose a game. -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460"
                      Visibility="{Binding ShowPickGame, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding S[shell.pick_game]}" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />
            <ItemsControl ItemsSource="{Binding Games}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Title}" Margin="0,5" Padding="20,16" FontSize="16" FontWeight="Bold"
                          HorizontalContentAlignment="Left" IsEnabled="{Binding Accepting}" Click="OnChooseGame" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Choose a profile (from the server) or create one. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowPickProfile, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" Margin="0,8">
              <TextBlock Text="{Binding S[shell.pick_profile]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding ProfilesText}" Margin="0,8,0,14" Style="{StaticResource PageSubtitle}" />
              <ItemsControl ItemsSource="{Binding ProfileRows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Button Padding="20,14" HorizontalContentAlignment="Left" Click="OnChooseProfile">
                        <StackPanel Margin="0,0,120,0">
                          <TextBlock Text="{Binding Gamertag}" FontWeight="Bold" FontSize="16" />
                          <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                      <Button Content="{Binding DataContext.S[detail.convert], RelativeSource={RelativeSource AncestorType=Window}}"
                              Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                              Click="OnConvertProfile" Visibility="{Binding Hardcore, Converter={StaticResource Visible}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding S[profiles.new]}" Style="{StaticResource SectionTag}" FontSize="12" />
                  <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding S[profiles.add]}" Margin="10,0,0,0"
                            Click="OnCreateProfile" IsEnabled="{Binding Idle}" Style="{StaticResource AccentButtonStyle}" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                  </DockPanel>
                  <TextBlock Text="{Binding S[profiles.name_rule]}" FontSize="11" Margin="0,6,0,0" Foreground="{StaticResource InfinityFaint}" />
                  <!-- OD-52, OD-60: Hardcore (an Infinity Supporter's, a new career the game seeds) or Noob (the offline save). -->
                  <StackPanel Margin="0,14,0,0" Visibility="{Binding CanChooseHardcore, Converter={StaticResource Visible}}">
                    <RadioButton Content="{Binding S[signin.form_hardcore]}" IsChecked="{Binding NewHardcore}" GroupName="NewMode" FontWeight="Bold" />
                    <TextBlock Text="{Binding S[modes.hardcore_hint]}" FontSize="11" Margin="30,2,0,10" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                    <RadioButton Content="{Binding S[signin.form_noob]}" IsChecked="{Binding NewNoob}" GroupName="NewMode" FontWeight="Bold" />
                    <TextBlock Text="{Binding S[modes.noob_hint]}" FontSize="11" Margin="30,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                  </StackPanel>
                  <TextBlock Text="{Binding S[modes.free_noob]}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}"
                             Visibility="{Binding CanChooseHardcore, Converter={StaticResource Hidden}}" />
                </StackPanel>
              </Border>
              <!-- OD-52: Hardcore → Noob, what is deleted for good, then the confirmation. -->
              <Border Margin="0,16,0,0" Padding="18,16" CornerRadius="12" Background="{StaticResource InfinityDangerSurface}"
                      BorderBrush="{StaticResource InfinityDangerBorder}" BorderThickness="1"
                      Visibility="{Binding ShowConvert, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="{Binding ConvertTitle}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding S[modes.convert_body]}" Margin="0,6,0,6" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ConvertDeletes}" Margin="8,0,0,6" TextWrapping="Wrap" Foreground="{StaticResource InfinityRose}" />
                  <TextBlock Text="{Binding S[modes.convert_keeps]}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{Binding S[modes.convert_confirm]}" Click="OnConfirmConvert" IsEnabled="{Binding Idle}"
                            BorderBrush="{StaticResource InfinityDangerBorder}" />
                    <Button Content="{Binding S[modes.convert_cancel]}" Margin="10,0,0,0" Click="OnCancelConvert"
                            Style="{StaticResource AccentButtonStyle}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- PLAY: admission happens here; the game starts only with a verified active ticket. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowHome, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,8,0,8">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Padding="8,2" CornerRadius="4" Background="{StaticResource InfinityWarnSurface}">
                  <TextBlock Text="BETA" Foreground="{StaticResource InfinityGold}" FontWeight="Bold" FontSize="10" />
                </Border>
              </StackPanel>
              <Image Source="{StaticResource BrandLogo}" Width="340" Margin="0,0,0,20" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"
                     Visibility="{Binding ShowPlayBrand, Converter={StaticResource Visible}}" />
              <StackPanel Visibility="{Binding ShowPlayAction, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding PlayGuidance}" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{StaticResource InfinityMuted}" />
                <!-- §1.1: mods never block Play silently; the reason and the way to Mods are shown here. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding ShowModPlayNotice, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding ModPlayNotice}" TextWrapping="Wrap" MaxWidth="420" Foreground="{StaticResource InfinityGold}" VerticalAlignment="Center" />
                  <Button Content="{Binding S[mods.open]}" Click="OnNavMods" IsEnabled="{Binding CanOpenMods}" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <!-- OD-115: the required mod's own action (install from the signed catalog, adopt, enable, or retry the catalog). -->
                  <Button Content="{Binding RequiredModAction}" Click="OnRequiredMod" IsEnabled="{Binding CanActOnRequiredMod}" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding ShowRequiredModAction, Converter={StaticResource Visible}}" />
                </StackPanel>
                <Button Content="{Binding S[crash.review]}" Click="OnReviewCrash" HorizontalAlignment="Left" Margin="0,0,0,14"
                        Visibility="{Binding HasCrashReport, Converter={StaticResource Visible}}" />
                <WrapPanel>
                  <Button Content="{Binding S[profiles.play]}" HorizontalAlignment="Left" Click="OnPlay" IsEnabled="{Binding CanPlay}"
                          Style="{StaticResource PlayButton}" Margin="0,0,12,8" />
                </WrapPanel>
                <TextBlock Text="{Binding PlayStatus}" Margin="0,14,0,0" TextWrapping="Wrap" FontWeight="Bold"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <Border Style="{StaticResource Card}" Background="#EE170B22" BorderBrush="#775A184D" Margin="0,2,0,0"
                      Visibility="{Binding WaitingForAdmission, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="{Binding AdmissionTitle}" FontWeight="Bold" FontSize="22" TextWrapping="Wrap"
                             AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding AdmissionDetail}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource InfinityMuted}" />
                  <Grid Margin="0,18,0,12" Visibility="{Binding Queued, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,26,0">
                      <TextBlock Text="{Binding S[queue.your_position]}" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                      <TextBlock Text="{Binding QueueNumber}" FontSize="48" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                                 AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding QueueEstimate}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding QueueAhead}" Foreground="{StaticResource InfinityMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                  <ProgressBar Height="3" IsIndeterminate="True" Margin="0,16,0,16" Foreground="{StaticResource InfinityAccent}"
                               AutomationProperties.Name="{Binding AdmissionTitle}" />
                  <TextBlock Text="{Binding S[queue.keep_open]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding S[queue.priority_hint]}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                             Foreground="{StaticResource InfinityMuted}" Visibility="{Binding ShowPriorityHint, Converter={StaticResource Visible}}" />
                  <Button Content="{Binding LeaveQueueLabel}" Click="OnLeaveQueue" HorizontalAlignment="Left" Margin="0,18,0,0"
                          IsEnabled="{Binding CanLeaveQueue}" />
                </StackPanel>
              </Border>
              <WrapPanel Margin="0,14,0,0" Visibility="{Binding ShowPlayAction, Converter={StaticResource Visible}}">
                <Button Content="{Binding S[supervisor.quit_button]}" Margin="0,0,14,0" Click="OnQuitGame"
                        Visibility="{Binding GameStarted, Converter={StaticResource Visible}}" />
                <Button Content="{Binding S[saves.use_pc_save]}" Style="{StaticResource LinkButton}" Margin="0"
                        Click="OnOpenSavePicker" IsEnabled="{Binding CanPickSave}" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowCrashReport, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="{Binding S[crash.title]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding S[crash.intro]}" Style="{StaticResource PageSubtitle}" Margin="0,8,0,20" />
              <TextBlock Text="{Binding S[community.contribution]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,20" />
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{Binding CrashCode}" FontWeight="Bold" FontSize="20" />
                  <TextBlock Text="{Binding CrashLocation}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,16" />
                  <TextBlock Text="{Binding S[crash.participants]}" FontWeight="Bold" />
                  <TextBlock Text="{Binding CrashParticipants}" TextWrapping="Wrap" Margin="0,6,0,8" />
                  <TextBlock Text="{Binding CrashContextNote}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding S[crash.blame_unknown]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" Margin="0,0,0,16" />
                  <TextBlock Text="{Binding S[crash.metadata_privacy]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding CrashMigrationNote}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" Margin="0,8,0,0" />
                  <CheckBox IsChecked="{Binding CrashConsent}" IsEnabled="{Binding CanConsentCrash}" Margin="0,12,0,8">
                    <TextBlock Text="{Binding S[crash.metadata_consent]}" TextWrapping="Wrap" MaxWidth="520" />
                  </CheckBox>
                  <TextBlock Text="{Binding S[crash.dumps_disabled]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" FontSize="12" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding CrashStatus}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" AutomationProperties.LiveSetting="Polite" />
                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="{Binding S[crash.send]}" Click="OnSendCrash" IsEnabled="{Binding CanSendCrash}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[crash.copy]}" Click="OnCopyCrash" IsEnabled="{Binding CanExportCrash}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[crash.save_report]}" Click="OnSaveCrashReport" IsEnabled="{Binding CanExportCrash}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[crash.later]}" Click="OnLaterCrash" IsEnabled="{Binding CrashIdle}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[crash.discard]}" Click="OnDiscardCrash" IsEnabled="{Binding CrashIdle}" Margin="0,0,0,8" />
                  </WrapPanel>
                  <TextBlock Text="{Binding S[crash.manual_support]}" TextWrapping="Wrap" FontWeight="Bold" Margin="0,16,0,6" />
                  <TextBlock Text="{Binding CrashSupportNote}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,0,0,8" />
                  <Button Content="{Binding S[crash.private_support]}" Click="OnPrivateCrashSupport" IsEnabled="{Binding CanOpenCrashSupport}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding CrashDumpNote}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" FontSize="12" Margin="0,0,0,8" />
                  <CheckBox IsChecked="{Binding CrashManualDumpConsent}" IsEnabled="{Binding CanChooseManualCrashDump}" Margin="0,0,0,8">
                    <TextBlock Text="{Binding S[crash.manual_dump_consent]}" TextWrapping="Wrap" MaxWidth="520" />
                  </CheckBox>
                  <Button Content="{Binding S[crash.save_dump]}" Click="OnSaveCrashDump" IsEnabled="{Binding CanSaveCrashDump}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowBugReport, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="740" HorizontalAlignment="Left">
              <TextBlock Text="{Binding S[bugs.eyebrow]}" Style="{StaticResource SectionTag}" />
              <TextBlock Text="{Binding S[bugs.title]}" Style="{StaticResource PageTitle}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding S[bugs.intro]}" Style="{StaticResource PageSubtitle}" Margin="0,8,0,24" />
              <TextBlock Text="{Binding S[community.contribution]}" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{StaticResource InfinityMuted}" />
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{Binding S[bugs.step1]}" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="{Binding S[bugs.step1_body]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,20" />
                  <TextBlock Text="{Binding S[bugs.step2]}" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="{Binding S[bugs.step2_body]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,20" />
                  <TextBlock Text="{Binding S[bugs.step3]}" FontWeight="Bold" FontSize="16" />
                  <TextBlock Text="{Binding S[bugs.step3_body]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" Margin="0,6,0,20" />
                  <TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="{StaticResource InfinityGold}" />
                  <Button Content="{Binding S[bugs.open]}" Click="OnGitHubIssues" Style="{StaticResource AccentButtonStyle}"
                          HorizontalAlignment="Left" Margin="0,18,0,0" />
                  <TextBlock Text="github.com/anarqz/InfinityHorizon" FontSize="12" Foreground="{StaticResource InfinityMuted}" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Configure: independent Azimuth and game integrity checks. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSetup, Converter={StaticResource Visible}}">
            <StackPanel>
              <TextBlock Text="{Binding S[setup.title]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding S[configure.intro]}" Margin="0,6,0,18" Style="{StaticResource PageSubtitle}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

              <Border Grid.Column="0" VerticalAlignment="Top">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers>
                  <DataTrigger Binding="{Binding AzimuthCardReady}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource InfinityGood}" /></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <StackPanel>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="AZIMUTH" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite">
                      <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InfinityGood}" Margin="0,0,6,0" Visibility="{Binding AzimuthCardReady, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding AzimuthCardStatus}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding SetupSummary}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12" />
                  <TextBlock Text="{Binding HookLine}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                  <DockPanel Margin="0,4">
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="✓" FontWeight="Bold" Foreground="{StaticResource InfinityGood}" Visibility="{Binding AzimuthFound, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding AzimuthFound, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding SetupFoundLine}" TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="✓" FontWeight="Bold" Foreground="{StaticResource InfinityGood}" Visibility="{Binding AzimuthVersionOk, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding AzimuthVersionOk, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding SetupVersionLine}" TextWrapping="Wrap" />
                  </DockPanel>
                  <DockPanel Margin="0,4">
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="✓" FontWeight="Bold" Foreground="{StaticResource InfinityGood}" Visibility="{Binding HookOk, Converter={StaticResource Visible}}" />
                    <TextBlock DockPanel.Dock="Left" Width="24" Text="•" FontWeight="Bold" Foreground="{StaticResource InfinityGold}"
                               Visibility="{Binding HookOk, Converter={StaticResource Hidden}}" />
                    <TextBlock Text="{Binding SetupHookLine}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding HookPackageProblem}" Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding HasHookPackageProblem, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding EoAzimuthText}" Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}"
                             Visibility="{Binding EoAzimuthMismatch, Converter={StaticResource Visible}}" />
                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="{Binding HookInstallLabel}" Margin="0,0,10,0" Click="OnInstallHook"
                            Style="{StaticResource AccentButtonStyle}" Visibility="{Binding CanInstallHook, Converter={StaticResource Visible}}" />
                    <Button Content="{Binding S[setup.choose]}" Click="OnChooseAzimuth" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[setup.recheck]}" Click="OnRecheckAzimuth" IsEnabled="{Binding ModsIdle}" Margin="0,0,0,8" />
                  </WrapPanel>
                  <Button Content="{Binding S[setup.grab]}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-6,8,0,0" Click="OnOpenAzimuthPage" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" VerticalAlignment="Top">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers>
                  <DataTrigger Binding="{Binding IntegrityReady}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource InfinityGood}" /></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <StackPanel>
                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding S[integrity.title]}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite">
                      <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InfinityGood}" Margin="0,0,6,0" Visibility="{Binding IntegrityReady, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding IntegrityCardStatus}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding IntegrityStatus}" TextWrapping="Wrap" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding IntegrityFindings}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  <TextBlock Text="{Binding IntegrityLocationLabel}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8" Foreground="{StaticResource InfinityMuted}" />
                  <WrapPanel>
                    <Button Content="{Binding S[integrity.choose]}" Click="OnChooseContent" IsEnabled="{Binding CanChooseContent}" Margin="0,0,8,8" />
                    <Button Content="{Binding S[setup.recheck]}" Click="OnCheckIntegrity" IsEnabled="{Binding CanCheckIntegrity}" Margin="0,0,8,8"
                            Visibility="{Binding ShowIntegrityCheck, Converter={StaticResource Visible}}" />
                    <Button Content="{Binding S[integrity.cancel]}" Click="OnCancelIntegrity" Visibility="{Binding IntegrityChecking, Converter={StaticResource Visible}}" Margin="0,0,8,8" />
                  </WrapPanel>
                  <StackPanel Visibility="{Binding ShowIntegritySupport, Converter={StaticResource Visible}}">
                    <WrapPanel Margin="-6,8,0,8">
                      <Button Content="{Binding S[integrity.copy]}" Style="{StaticResource LinkButton}" Click="OnCopyIntegrity" />
                      <Button Content="{Binding S[crash.private_support]}" Style="{StaticResource LinkButton}" Click="OnPrivateCrashSupport" IsEnabled="{Binding CanOpenCrashSupport}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding S[integrity.help]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- Compact manifest catalog; selection and information share the right sidebar. -->
          <Grid Visibility="{Binding ShowMods, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,18,0">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding S[mods.title]}" Style="{StaticResource PageTitle}" />
                <Grid Margin="0,14,0,12" Visibility="{Binding HasModCards, Converter={StaticResource Visible}}">
                  <TextBox Text="{Binding ModSearch, UpdateSourceTrigger=PropertyChanged}" Padding="14,11,38,11"
                           AutomationProperties.Name="{Binding S[mods.search]}" />
                  <TextBlock Text="{Binding S[mods.search]}" Margin="15,0,38,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource InfinityMuted}" IsHitTestVisible="False"
                             Visibility="{Binding ModSearchEmpty, Converter={StaticResource Visible}}" />
                  <Button Content="×" Width="28" Height="28" Padding="0" Margin="0,0,7,0" HorizontalAlignment="Right"
                          Click="OnClearModSearch" ToolTip="{Binding S[mods.search_clear]}" AutomationProperties.Name="{Binding S[mods.search_clear]}"
                          Visibility="{Binding ModSearchEmpty, Converter={StaticResource Hidden}}" />
                </Grid>
                <StackPanel>
                  <WrapPanel>
                    <!-- Development tools only: the DEV catalog override and the native offline session. -->
                    <WrapPanel Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}">
                      <Button Content="{Binding S[welcome.back]}" Click="OnNavHome" Padding="10,6" Margin="0,0,8,8" />
                      <Button Content="{Binding S[integrity.choose]}" Click="OnChooseContent" IsEnabled="{Binding CanChooseContent}" ToolTip="{Binding IntegrityLocationLabel}" Padding="10,6" Margin="0,0,8,8" />
                      <Button Content="{Binding HookInstallLabel}" Click="OnInstallHook" IsEnabled="{Binding CanInstallHook}" Padding="10,6" Margin="0,0,8,8" />
                      <Button Content="{Binding S[mods.offline_play]}" Click="OnModdedOffline" IsEnabled="{Binding CanPlayModdedOffline}" Padding="10,6" Margin="0,0,8,8" />
                    </WrapPanel>
                    <Button Content="↻" Click="OnLoadModCatalog" Padding="10,3" FontSize="20" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8"
                            ToolTip="{Binding S[mods.refresh_catalog]}" AutomationProperties.Name="{Binding S[mods.refresh_catalog]}" />
                    <Button Content="{Binding S[mods.folder_short]}" Click="OnChooseAzimuth" Padding="10,6" IsEnabled="{Binding ModsIdle}" Margin="0,0,8,8"
                            ToolTip="{Binding ModFolder}" AutomationProperties.Name="{Binding S[mods.choose_folder]}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding ModCatalogSummary}" ToolTip="{Binding ModCatalogStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                  <!-- OD-114: custom mods are read from this folder, one subfolder per mod. -->
                  <TextBox Text="{Binding CustomModsFolderText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                           FontSize="11" Foreground="{StaticResource InfinityMuted}" Padding="0" Margin="0,2,0,0" />
                  <!-- H4/§1.4: production recovery, always with a resolution. -->
                  <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0" Visibility="{Binding ShowModRecovery, Converter={StaticResource Visible}}">
                    <StackPanel>
                      <TextBlock Text="{Binding S[mods.recovery_title]}" FontWeight="Bold" />
                      <TextBlock Text="{Binding ModRecoveryText}" TextWrapping="Wrap" Margin="0,6,0,8" />
                      <WrapPanel>
                        <Button Content="{Binding S[mods.recover]}" Click="OnRecoverMods" IsEnabled="{Binding CanRecoverMods}" Padding="10,6" Margin="0,0,8,6" />
                        <Button Content="{Binding S[mods.resolve]}" Click="OnResolveMods" IsEnabled="{Binding CanResolveMods}" Padding="10,6" Margin="0,0,8,6"
                                ToolTip="{Binding S[mods.resolve_hint]}" />
                        <Button Content="{Binding S[mods.relink]}" Click="OnRelinkMods" IsEnabled="{Binding ModsIdle}" Padding="10,6" Margin="0,0,8,6"
                                Visibility="{Binding HasModRelink, Converter={StaticResource Visible}}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding S[mods.resolve_hint]}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InfinityMuted}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="{Binding S[mods.search_none]}" TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{StaticResource InfinityMuted}"
                           Visibility="{Binding NoMatchingMods, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding FilteredModCards}" Visibility="{Binding HasModCards, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Width="230" Height="144" Padding="0" Margin="0,0,12,12">
                        <Grid>
                          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                          <Button Click="OnSelectMod" Style="{StaticResource ModCardButton}" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,24,0" ToolTip="{Binding Name}" />
                              <TextBlock Text="{Binding Manifest.Version, StringFormat=v{0}}" FontSize="11" Foreground="{StaticResource InfinityMuted}" Margin="0,5,0,0" />
                              <TextBlock Text="{Binding CustomBadge}" Foreground="{StaticResource InfinityPink}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                                         Visibility="{Binding Custom, Converter={StaticResource Visible}}" />
                              <TextBlock Text="{Binding Badge}" Foreground="{StaticResource InfinityGold}" FontSize="12" Margin="0,12,0,0"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                            </StackPanel>
                          </Button>
                          <Button Content="i" Click="OnModInformation" Width="24" Height="24" Padding="0" Margin="0,9,9,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="Bold" FontStyle="Italic"
                                  ToolTip="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}"
                                  AutomationProperties.Name="{Binding DataContext.S[mods.information], RelativeSource={RelativeSource AncestorType=Window}}" />
                          <Button Grid.Row="1" Content="{Binding Action}" Click="OnActOnMod" IsEnabled="{Binding CanAct}"
                                  Padding="10,7" Margin="14,0,14,14" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ModCatalogStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource InfinityMuted}" />
              </StackPanel>
              </ScrollViewer>
            </DockPanel>

            <!-- The options sidebar: the INI as a form; Save and Undo stay at the bottom. -->
            <Border Grid.Column="1" Width="360" Margin="0,-28,-40,-16" Padding="22,22,8,16" Background="{StaticResource InfinitySurface}"
                    BorderBrush="#3365184D" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowModOptions, Converter={StaticResource Visible}}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,12,0">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}"
                          Click="OnCloseModPanel" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding S[mods.options_title]}" FontSize="20" FontWeight="Bold" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedMod.Name}" Style="{StaticResource PageSubtitle}" Margin="0,2,12,0" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="{Binding S[mods.save_options]}" Click="OnSaveIni" IsEnabled="{Binding IniDirty}"
                          Style="{StaticResource AccentButtonStyle}" />
                  <Button Content="{Binding S[mods.revert_options]}" Margin="10,0,0,0" Click="OnRevertIni" IsEnabled="{Binding IniDirty}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding S[mods.options_hint]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                    <ItemsControl ItemsSource="{Binding ModOptions}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,8,0,10" IsEnabled="{Binding Editable}">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" FontSize="11" Margin="0,4,0,6" />
                          <TextBlock Text="{Binding LockReason}" TextWrapping="Wrap" Foreground="{StaticResource InfinityGold}" FontSize="11" Margin="0,0,0,6"
                                     Visibility="{Binding HasLockReason, Converter={StaticResource Visible}}" />
                          <CheckBox IsChecked="{Binding Checked}" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" />
                          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsNumber, Converter={StaticResource Visible}}" />
                          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text}" Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" />
                        </StackPanel>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Width="360" Margin="0,-28,-40,-16" Padding="22,22,16,16" Background="{StaticResource InfinitySurface}"
                    BorderBrush="#3365184D" BorderThickness="1,0,0,0" Visibility="{Binding ShowModInfo, Converter={StaticResource Visible}}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                  <Button DockPanel.Dock="Right" Content="{Binding S[mods.options_close]}" Style="{StaticResource LinkButton}" Click="OnCloseModPanel" />
                  <TextBlock Text="{Binding S[mods.information]}" FontSize="20" FontWeight="Bold" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding SelectedMod.Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedMod.Credits}" FontSize="11" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedMod.CustomBadge}" Foreground="{StaticResource InfinityPink}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"
                               Visibility="{Binding SelectedMod.Custom, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding SelectedMod.Description}" TextWrapping="Wrap" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding SelectedMod.Status}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource InfinityGold}" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding SelectedMod.Requirements}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
                    <!-- OD-114: an unreviewed custom mod is confirmed for its exact digest before its first install or enable. -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0" Visibility="{Binding SelectedModNeedsConfirmation, Converter={StaticResource Visible}}">
                      <StackPanel>
                        <TextBlock Text="{Binding S[mods.custom_confirm_title]}" FontWeight="Bold" Foreground="{StaticResource InfinityGold}" />
                        <TextBlock Text="{Binding SelectedModConfirmation}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                        <Button Content="{Binding S[mods.custom_confirm]}" Click="OnConfirmCustomMod" IsEnabled="{Binding CanConfirmCustomMod}"
                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                      </StackPanel>
                    </Border>
                    <!-- M5 reviewed update: the change first, then the confirmation. -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding SelectedModUpdate, Converter={StaticResource Visible}}">
                      <TextBlock Text="{Binding SelectedMod.UpdateSummary}" TextWrapping="Wrap" FontSize="12" />
                      <Button Content="{Binding S[mods.confirm_update]}" Click="OnConfirmModUpdate" IsEnabled="{Binding CanConfirmModUpdate}"
                              Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                    <!-- H3: changed files are a warning with two choices; M6: settings repair. -->
                    <WrapPanel Margin="0,14,0,0">
                      <Button Content="{Binding S[mods.accept_files]}" Click="OnAcceptModFiles" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModDrift, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.disable_keep]}" Click="OnDisableModKeeping" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModCanDisableKeeping, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.repair_settings]}" Click="OnRepairModSettings" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModSettingsIssues, Converter={StaticResource Visible}}" />
                      <Button Content="{Binding S[mods.uninstall]}" Click="OnUninstallMod" Padding="10,6" Margin="0,0,8,8"
                              Visibility="{Binding SelectedModCanUninstall, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <Button Content="{Binding S[mods.options]}" Click="OnSelectedModOptions" Margin="0,18,0,0"
                            Visibility="{Binding SelectedMod.HasOptions, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding SelectedModFiles}" TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0" Foreground="{StaticResource InfinityMuted}" />
                    <Expander Header="{Binding S[mods.files]}" Margin="0,12,0,0">
                      <ItemsControl ItemsSource="{Binding SelectedMod.Manifest.Files}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding Root}" Foreground="{StaticResource InfinityPink}" FontSize="10" />
                            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" FontSize="11" />
                          </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <!-- OD-41: start the profile from one of Azimuth's own saves on this PC (backed up, then cloned). -->
          <DockPanel MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding ShowPickSave, Converter={StaticResource Visible}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="{Binding S[saves.pick_title]}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding PickSaveText}" Margin="0,8,0,16" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button Margin="0,5" Padding="20,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Click="OnSkipSave" IsEnabled="{Binding Idle}">
                <StackPanel>
                  <TextBlock Text="{Binding S[saves.new_career]}" FontWeight="Bold" />
                  <TextBlock Text="{Binding S[saves.new_career_detail]}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding S[saves.backup_note]}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource InfinityFaint}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
              <ItemsControl ItemsSource="{Binding SaveChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="0,5" Padding="20,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnPickSave" IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Grid>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource InfinityWarnSurface}" Padding="22,10"
            Visibility="{Binding ShowLauncherUpdateBanner, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding LauncherUpdateBannerAction}" Click="OnOpenLauncherUpdate" IsEnabled="{Binding CanRetryLauncherUpdate}" Margin="16,0,0,0" />
        <TextBlock Text="{Binding LauncherUpdateStatus}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="{StaticResource InfinityWarnSurface}" Padding="22,10"
            Visibility="{Binding ShowOnlineStatusBanner, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding S[online.retry]}" Click="OnCheckOnlineStatus" IsEnabled="{Binding CanCheckOnlineStatus}" Margin="16,0,0,0" />
        <StackPanel>
          <TextBlock Text="{Binding OnlineServiceMessage}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding OnlineRetryHint}" FontSize="12" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="{StaticResource InfinityBackground}"
            Visibility="{Binding ShowLauncherUpdate, Converter={StaticResource Visible}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="40,36" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{StaticResource BrandLogo}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,30" />
          <TextBlock Text="{Binding S[updater.title]}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LauncherUpdateStatus}" Margin="0,16,0,12" FontSize="17" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding LauncherUpdateVersion}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LauncherUpdateProgress}" Foreground="{StaticResource InfinityMuted}" Margin="0,10,0,0" />
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,18,0,14" Visibility="{Binding LauncherUpdateBusy, Converter={StaticResource Visible}}" />
          <WrapPanel Margin="0,20,0,12">
            <Button Content="{Binding S[updater.apply]}" Click="OnApplyLauncherUpdate" IsEnabled="{Binding CanApplyLauncherUpdate}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.cancel]}" Click="OnCancelLauncherUpdate" Visibility="{Binding CanCancelLauncherUpdate, Converter={StaticResource Visible}}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.retry]}" Click="OnCheckLauncherUpdates" IsEnabled="{Binding CanRetryLauncherUpdate}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.support]}" Click="OnUpdateSupport" IsEnabled="{Binding CanRetryLauncherUpdate}" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.exit]}" Click="OnExitLauncherUpdate" Margin="0,0,10,10" />
          </WrapPanel>
          <TextBlock Text="{Binding S[updater.help]}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="{StaticResource InfinityBackground}"
            Visibility="{Binding ShowOnlineStatusPage, Converter={StaticResource Visible}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="40,36" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="{StaticResource BrandLogo}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,30" />
          <TextBlock Text="{Binding OnlineServiceTitle}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OnlineServiceMessage}" Margin="0,16,0,12" FontSize="17" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding OnlineRetryHint}" Foreground="{StaticResource InfinityGold}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding S[online.resume]}" Foreground="{StaticResource InfinityMuted}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="{Binding OnlineServicePaused, Converter={StaticResource Visible}}" />
          <WrapPanel Margin="0,20,0,12">
            <Button Content="{Binding S[online.retry]}" Click="OnCheckOnlineStatus" IsEnabled="{Binding CanCheckOnlineStatus}" Margin="0,0,10,10" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="{Binding S[online.continue]}" Click="OnCloseOnlineStatus" Visibility="{Binding OnlineServiceAllowsPlay, Converter={StaticResource Visible}}" Margin="0,0,10,10" />
            <Button Content="{Binding S[online.support]}" Click="OnOnlineSupport" Margin="0,0,10,10" />
            <Button Content="{Binding S[online.updates]}" Click="OnOpenLauncherUpdate" Margin="0,0,10,10" />
            <Button Content="{Binding S[updater.exit]}" Click="OnExitLauncherUpdate" Margin="0,0,10,10" />
          </WrapPanel>
          <TextBlock Text="{Binding OnlineServiceHelp}" TextWrapping="Wrap" Foreground="{StaticResource InfinityMuted}" />
          <Button Content="{Binding S[mods.dev_open]}" Click="OnNavMods" HorizontalAlignment="Left" Margin="0,16,0,0"
                  Visibility="{Binding DevelopmentMods, Converter={StaticResource Visible}}" IsEnabled="{Binding ModsIdle}" />
          <Button Content="{Binding S[nav.discord]}" Click="OnDiscord" HorizontalAlignment="Left" Margin="0,16,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource InfinityWarnSurface}"
            BorderBrush="{StaticResource InfinityGold}" BorderThickness="0,1,0,0" Padding="20,10"
            Visibility="{Binding ShowBuildOriginWarning, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding S[build_origin.releases]}" Click="OnOfficialReleases"
                VerticalAlignment="Center" Margin="18,0,0,0" Padding="12,6" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding S[build_origin.title]}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InfinityGold}" />
          <TextBlock Text="{Binding S[build_origin.warning]}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{Binding S[legal.about]}" Click="OnAbout" Margin="16,0,0,0" Padding="10,4" />
        <Button DockPanel.Dock="Right" Content="{Binding S[online.view]}" Click="OnOpenOnlineStatus" Margin="16,0,0,0" Padding="10,4" />
        <Border DockPanel.Dock="Left" Padding="9,4" Margin="0,0,16,0" VerticalAlignment="Center" CornerRadius="4"
                Background="{StaticResource InfinityWarnSurface}">
          <TextBlock Text="BETA" Foreground="{StaticResource InfinityGold}" FontWeight="Bold" FontSize="10" />
        </Border>
        <TextBlock Text="{Binding S[beta.notice]}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{StaticResource InfinityMuted}" />
      </DockPanel>
    </Border>
  </Grid>
    <Border x:Name="ModProgressOverlay" Background="#B20E0B16" Panel.ZIndex="100"
            Visibility="{Binding ModOperationBusy, Converter={StaticResource Visible}}"
            Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1"
              CornerRadius="18" Padding="40,32" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Grid Width="48" Height="48" Margin="0,0,0,22">
            <Ellipse Stroke="{StaticResource InfinityBorder}" StrokeThickness="4" />
            <Path Data="M 24,2 A 22,22 0 0 1 46,24" Stroke="{StaticResource InfinityPink}" StrokeThickness="4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
              <Path.Style>
                <Style TargetType="Path">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ModOperationBusy}" Value="True">
                      <DataTrigger.EnterActions><BeginStoryboard x:Name="ModSpinner"><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                      </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ModSpinner" /></DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Grid>
          <TextBlock Text="{Binding S[mods.progress.title]}" FontSize="22" FontWeight="Bold" TextAlignment="Center" />
          <TextBlock Text="{Binding ModProgress}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding S[mods.progress.hint]}" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{StaticResource InfinityMuted}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
