                                <Path DockPanel.Dock="Left" Data="{StaticResource IconCheck}" Style="{StaticResource InlineIcon}" Width="14" Height="14" StrokeThickness="2.4" Margin="0,0,8,0" Stroke="{StaticResource InfinityGood}"
                                           Visibility="{Binding ShowCheckMark, Converter={StaticResource Visible}}" />
                                <Path DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Style="{StaticResource InlineIcon}" Width="14" Height="14" StrokeThickness="2" Margin="0,0,8,0" Stroke="{StaticResource InfinityGold}"
                                           Visibility="{Binding ShowWarningMark, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                              </DockPanel>
                              <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,8,0,0"
                                           Visibility="{Binding Checking, Converter={StaticResource Visible}}" />
                              <Expander Header="{Binding DataContext.S[external.details], RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,8,0,0"
                                        Visibility="{Binding HasDetails, Converter={StaticResource Visible}}">
                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" BorderThickness="0" Background="Transparent" />
                              </Expander>
                              <WrapPanel Margin="0,10,0,0">
                                <Button Content="{Binding DataContext.S[external.choose_folder], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Click="OnBrowseExternal" Padding="10,6" Margin="0,0,8,6" Visibility="{Binding PicksFolder, Converter={StaticResource Visible}}" />
                                <Button Content="{Binding DataContext.S[external.choose_file], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Click="OnBrowseExternal" Padding="10,6" Margin="0,0,8,6" Visibility="{Binding PicksFile, Converter={StaticResource Visible}}" />
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </DockPanel>
    </Grid>
    <!-- OD-118 (T1b): offline, a newer launcher on GitHub (checked from this PC to GitHub only): advice, never a block. -->
