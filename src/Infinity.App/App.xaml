<Application x:Class="Infinity.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ThemeMode="Dark"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Infinity Horizon (owner's palette, 2026-10-19). Every color the shell draws comes from here;
           the brand art and the font are WPF resources inside infinity.exe, so the launcher looks the
           same on Windows and under Wine/Proton (no Segoe fonts there, no Mica backdrop). -->
      <Color x:Key="NightBlack">#FF0E0616</Color>
      <Color x:Key="ElectricWine">#FF5A0626</Color>
      <Color x:Key="NeonMagenta">#FFF01864</Color>
      <Color x:Key="DeepCrimson">#FF9B0A27</Color>
      <Color x:Key="HorizonRed">#FFE41E28</Color>
      <Color x:Key="SunsetOrange">#FFFA6123</Color>
      <Color x:Key="PinkGlow">#FFF91790</Color>
      <Color x:Key="SolarGold">#FFFC9D1B</Color>
      <Color x:Key="IntenseRose">#FFF9555C</Color>
      <Color x:Key="DarkPurple">#FF65184D</Color>
      <Color x:Key="DarkFuchsia">#FFA10652</Color>
      <Color x:Key="SoftNeonWhite">#FFF9EAEE</Color>

      <!-- Fluent's own accent (text box focus, radio buttons, scroll thumbs) follows the brand. -->
      <Color x:Key="SystemAccentColor">#FFF01864</Color>
      <Color x:Key="SystemAccentColorLight1">#FFF43C7E</Color>
      <Color x:Key="SystemAccentColorLight2">#FFF91790</Color>
      <Color x:Key="SystemAccentColorLight3">#FFFB6FB4</Color>
      <Color x:Key="SystemAccentColorDark1">#FFC8104F</Color>
      <Color x:Key="SystemAccentColorDark2">#FFA10652</Color>
      <Color x:Key="SystemAccentColorDark3">#FF5A0626</Color>

      <SolidColorBrush x:Key="InfinityBackground" Color="{StaticResource NightBlack}" />
      <SolidColorBrush x:Key="InfinitySurface" Color="#FF170B22" />
      <SolidColorBrush x:Key="InfinitySurfaceHigh" Color="#FF22102F" />
      <SolidColorBrush x:Key="InfinityBorder" Color="#29F9EAEE" />
      <SolidColorBrush x:Key="InfinityText" Color="{StaticResource SoftNeonWhite}" />
      <SolidColorBrush x:Key="InfinityMuted" Color="#A6F9EAEE" />
      <SolidColorBrush x:Key="InfinityFaint" Color="#66F9EAEE" />
      <SolidColorBrush x:Key="InfinityAccent" Color="{StaticResource NeonMagenta}" />
      <SolidColorBrush x:Key="InfinityPink" Color="{StaticResource PinkGlow}" />
      <SolidColorBrush x:Key="InfinityGold" Color="{StaticResource SolarGold}" />
      <SolidColorBrush x:Key="InfinityRose" Color="{StaticResource IntenseRose}" />
      <SolidColorBrush x:Key="InfinityGood" Color="#FF6FD68A" />
      <SolidColorBrush x:Key="InfinityWarnSurface" Color="#24FC9D1B" />
      <SolidColorBrush x:Key="InfinityGoodSurface" Color="#1F6FD68A" />
      <SolidColorBrush x:Key="InfinityDangerSurface" Color="#33E41E28" />
      <SolidColorBrush x:Key="InfinityDangerBorder" Color="#99E41E28" />

      <!-- The sunset gradient of the wordmark's HORIZON: the primary action and the highlights. -->
      <LinearGradientBrush x:Key="InfinitySunset" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource PinkGlow}" Offset="0" />
        <GradientStop Color="{StaticResource NeonMagenta}" Offset="0.35" />
        <GradientStop Color="{StaticResource SunsetOrange}" Offset="0.78" />
        <GradientStop Color="{StaticResource SolarGold}" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="InfinitySunsetVertical" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource PinkGlow}" Offset="0" />
        <GradientStop Color="{StaticResource SunsetOrange}" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="InfinitySidebar" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#FF13071D" Offset="0" />
        <GradientStop Color="#FF1A0820" Offset="0.6" />
        <GradientStop Color="#FF2A0A26" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="InfinityNavSelected" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#40F01864" Offset="0" />
        <GradientStop Color="#00F01864" Offset="1" />
      </LinearGradientBrush>

      <!-- OD-119: composite fonts (Assets/Fonts/*.CompositeFont): Selawik for text, the bundled Noto Emoji for emoji. -->
    <FontFamily x:Key="InfinityFont">pack://application:,,,/Assets/Fonts/#Infinity</FontFamily>
      <FontFamily x:Key="InfinityFontSemibold">pack://application:,,,/Assets/Fonts/#Infinity Semibold</FontFamily>

      <BitmapImage x:Key="BrandLogo" UriSource="pack://application:,,,/Assets/logo.png" />
      <!-- OD-118: the "Offline mode" icon, a disconnected plug drawn as our own vector (24x24 grid, stroked), never a system
           icon font, so Proton draws it the same. One resource: the overlay draws the same shape with ImGui lines. -->
      <Geometry x:Key="OfflineIcon">M2,9 H8 V15 H2 Z M8,10.5 H11 M8,13.5 H11 M16,9 H22 V15 H16 Z M13,10.5 H16 M13,13.5 H16 M4,20 L20,4</Geometry>
      <BitmapImage x:Key="BrandMark" UriSource="pack://application:,,,/Assets/mark.png" />
      <BitmapImage x:Key="BrandHero" UriSource="pack://application:,,,/Assets/hero.jpg" />
      <BitmapImage x:Key="BrandStreaks" UriSource="pack://application:,,,/Assets/streaks.png" />
      <BitmapImage x:Key="BrandLines" UriSource="pack://application:,,,/Assets/lines.png" />

      <DropShadowEffect x:Key="InfinityGlow" Color="{StaticResource NeonMagenta}" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />

      <!-- A card: the panels of setup, mods, sign-in. -->
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InfinitySurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfinityBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22,18" />
      </Style>

      <!-- The shell's standard (owner, 2026-10-19): a title is bold and upright; the text under it is
           italic and regular; buttons are never italic. -->
      <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
      </Style>
      <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource InfinityMuted}" />
      </Style>
      <Style x:Key="SectionTag" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource InfinityPink}" />
      </Style>

      <!-- Buttons: a dark surface that lights magenta on hover. -->
      <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="Background" Value="{StaticResource InfinitySurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfinityBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InfinityAccent}" />
                  <Setter TargetName="Box" Property="Background" Value="#33F01864" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InfinityPink}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="#55F01864" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The primary action (Play, Sign in, Install): the sunset gradient with a neon glow. Same key
           as Fluent's accent button, so every primary button of the shell takes it. -->
      <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource InfinitySunset}" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Glow" CornerRadius="8" Background="{TemplateBinding Background}" Effect="{StaticResource InfinityGlow}" Opacity="0.75" />
                <Border x:Name="Box" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0">
                  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <Border x:Name="Shine" CornerRadius="8" Background="#00FFFFFF" IsHitTestVisible="False" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Shine" Property="Background" Value="#1FFFFFFF" />
                  <Setter TargetName="Glow" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Shine" Property="Background" Value="#26000000" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Box" Property="Background" Value="#33F9EAEE" />
                  <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                  <Setter Property="Foreground" Value="{StaticResource InfinityFaint}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The big Play button of Home. -->
      <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="56,14" />
        <Setter Property="MinWidth" Value="260" />
      </Style>

      <!-- Sidebar navigation: Tag="True" marks the page shown (a magenta bar and a soft gradient). -->
      <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InfinityMuted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <!-- Background: the row's fill; BorderBrush: the bar at its left (both set by the style's triggers) -->
            <ControlTemplate TargetType="Button">
              <Grid Background="Transparent">
                <Border x:Name="Fill" CornerRadius="0,8,8,0" Background="{TemplateBinding Background}" />
                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" CornerRadius="2" />
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Fill" Property="Background" Value="#14F9EAEE" />
                  <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.35" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <!-- Tag="{Binding Show…}": the page shown. Tag is an object, so compare with a real Boolean. -->
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
            <DataTrigger.Value>
              <sys:Boolean>True</sys:Boolean>
            </DataTrigger.Value>
            <Setter Property="Background" Value="{StaticResource InfinityNavSelected}" />
            <Setter Property="BorderBrush" Value="{StaticResource InfinitySunsetVertical}" />
            <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A text link (change, exit, forgot password). -->
      <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource InfinityPink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Text" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource InfinityGold}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Text fields on the dark surface. -->
      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource InfinitySurfaceHigh}" />
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfinityBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource InfinityPink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource InfinityAccent}" />
        <Setter Property="Padding" Value="10,7" />
      </Style>
      <!-- OD-118: every icon ships with the launcher. Fluent's own PasswordBox, ComboBox, Expander and ScrollBar templates draw
           glyphs with Segoe Fluent Icons, which Wine/Proton does not have; these templates draw the same parts as geometry. -->
      <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="Background" Value="{StaticResource InfinitySurfaceHigh}" />
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfinityBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource InfinityPink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource InfinityAccent}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Geometry x:Key="ChevronDown">M 0,0 L 5,5 L 10,0</Geometry>
      <!-- OD-118 T1d: icons Selawik lacks (✓ ↻ ↗ ←) as bundled geometry on a 24-unit grid; Wine has no fallback font for them. -->
      <Geometry x:Key="IconCheck">M 5,12.5 L 10,17 L 19,7</Geometry>
      <Geometry x:Key="IconRefresh">M 19,12 A 7,7 0 1 1 16.95,7.05 M 17.5,2.5 L 17.2,7.3 L 12.4,7</Geometry>
      <Geometry x:Key="IconExternal">M 7,17 L 17,7 M 9,7 L 17,7 L 17,15</Geometry>
      <Geometry x:Key="IconBack">M 19,12 L 5,12 M 11,6 L 5,12 L 11,18</Geometry>
      <Geometry x:Key="IconWarning">M 12,3.5 L 21.5,20 L 2.5,20 Z M 12,9.5 L 12,14 M 12,17 L 12,17.2</Geometry>
      <Geometry x:Key="IconFolder">M 3,6.5 L 3,18.5 L 21,18.5 L 21,8.5 L 11.5,8.5 L 9.5,6 L 3,6 Z</Geometry>
      <Geometry x:Key="IconArchive">M 6,3 L 15,3 L 19,7 L 19,21 L 6,21 Z M 15,3 L 15,7 L 19,7 M 11,5 L 11,6.5 M 11,8 L 11,9.5 M 11,11 L 11,12.5 M 9.5,14 L 12.5,14 L 12.5,17 L 9.5,17 Z</Geometry>
      <Style x:Key="InlineIcon" TargetType="Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="Background" Value="{StaticResource InfinitySurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfinityBorder}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="Frame" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                              BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="6">
                        <Path Data="{StaticResource ChevronDown}" Stroke="{StaticResource InfinityMuted}" StrokeThickness="1.6" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,0,12,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Margin="10,7,36,7" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                       IsOpen="{TemplateBinding IsDropDownOpen}">
                  <Border Background="{StaticResource InfinitySurface}" BorderBrush="{StaticResource InfinityBorder}" BorderThickness="1" CornerRadius="6"
                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource InfinityPink}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource InfinitySurfaceHigh}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource InfinityPink}" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <DockPanel>
                <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Cursor="Hand" HorizontalAlignment="Left" Focusable="True">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Path x:Name="Chevron" Data="{StaticResource ChevronDown}" Stroke="{StaticResource InfinityMuted}" StrokeThickness="1.6" Width="10" Height="6"
                              Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                          <Path.RenderTransform><RotateTransform x:Name="Turn" Angle="-90" /></Path.RenderTransform>
                        </Path>
                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center" />
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource InfinityPink}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Body" Margin="18,6,0,0" Visibility="Collapsed" />
              </DockPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Scroll bars: a thin thumb on its track, no arrow buttons (Fluent draws those with an icon font). -->
      <Style x:Key="InfinityThumb" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Border x:Name="Bar" Background="#55F9EAEE" CornerRadius="3" />
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#99F9EAEE" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="{StaticResource InfinityPink}" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="InfinityPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InfinityPageButton}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource InfinityThumb}" Margin="1,0" /></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InfinityPageButton}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track" Margin="2,0">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InfinityPageButton}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource InfinityThumb}" Margin="0,1" /></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InfinityPageButton}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Fluent draws the check with Segoe Fluent Icons, which Wine/Proton does not have (and its
           licence does not let us ship it): a CheckBox whose box and check are geometry. -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0"
                        BorderBrush="#99F9EAEE" Background="Transparent">
                  <Path x:Name="Check" Data="M 4,10 L 8,14 L 16,5" Stroke="White" StrokeThickness="2.4"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{StaticResource InfinitySunset}" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InfinityAccent}" />
                  <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InfinityPink}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Radio buttons drawn the same way (no font glyphs). -->
      <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InfinityText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="20" VerticalAlignment="Center">
                  <Ellipse x:Name="Ring" Stroke="#99F9EAEE" StrokeThickness="1.5" />
                  <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource InfinitySunset}" Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource InfinityAccent}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource InfinityPink}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource InfinityPink}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
