<Project Sdk="Microsoft.NET.Sdk">

  <!-- No UI: pipe frames, ticket checks, supervisor, API, auth. The shell (Infinity.App) only
       renders what this library decides (HANDOFF_WINDOWS.md §1). Windows-only code is marked
       [SupportedOSPlatform("windows")]; the rest builds and tests anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Infinity.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <!-- Read-only SQLite (save imports, car names, parts); MIT, bundles the native e_sqlite3. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- U2: the update path (verify + install) lives in Infinity.Update, which the updater references alone. -->
  <ItemGroup>
    <ProjectReference Include="..\Infinity.Update\Infinity.Update.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Infinity.Core.Tests" />
  </ItemGroup>

  <!-- OD-125: ExtraOptions.Infinity's own settings file, written beside azimuth.exe when the player has none. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\native\extraoptions-infinity\FH2_ExtraOptions.ini" LogicalName="Infinity.Core.FH2_ExtraOptions.ini" />
    <EmbeddedResource Include="Process\ExtraOptionsInfinity.manifest.json" LogicalName="Infinity.Core.ExtraOptionsInfinity.manifest.json" />
    <EmbeddedResource Include="Process\ExtraOptionsInfinity.Fm5.manifest.json" LogicalName="Infinity.Core.ExtraOptionsInfinity.Fm5.manifest.json" />
  </ItemGroup>

</Project>
