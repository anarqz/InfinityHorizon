# Settings of your Infinity Horizon server: copy to .env and change what you need
# (`cp .env.example .env`; README.md "Configure"). Every value below is the default; an empty value
# means "unset" (the code's default). NO SECRETS here: `fi-platform keys init` generates the
# signing keys, the pepper and the database passwords into the `keys` volume on the first start. A
# secret set in .env (for example FI_TOKEN_SIGNING_KEYS) overrides the generated file; leave them
# out unless you are moving keys from another server. Never commit your .env.
#
# The server settings have the same names and defaults as the ENV lines of
# docker/platform.Dockerfile.

# --- Network (compose only) ----------------------------------------------------------------------
# Address the API and the world node are published on. 127.0.0.1 keeps them on this machine; set
# this machine's LAN address (for example 192.0.2.10 below stands for yours) to let the game PCs on
# your network reach them. Plain HTTP: put a TLS reverse proxy in front before exposing the API
# beyond a network you trust.
FI_BIND_ADDRESS=127.0.0.1
FI_HTTP_PORT=8080
# The origin players' launchers use to reach this server (http(s)://host[:port], no path). It is
# what /launcher/v1/info and the pools hand out, so with a LAN address above use
# http://<that address>:<FI_HTTP_PORT> here too (http://192.0.2.10:8080).
FI_PUBLIC_URL=http://127.0.0.1:8080
# Players admitted at once: Supporters (pool vip) and everyone else (pool matchmaking).
FI_SUPPORTER_CAPACITY=8
FI_FREE_CAPACITY=16
# The first three numbers of the compose's pinned network (<prefix>.0/24; the api is <prefix>.20,
# the tunnel container <prefix>.10). Change it only if Docker reports that the pool overlaps.
FI_PINNED_PREFIX=172.30.122
# The game data directory you built with tools/gamedata/build.py (README "Game data"), mounted
# read-only into the api and the jobs. Relative paths are relative to this folder.
FI_GAME_DATA_PATH=./gamedata
# Host UDP ports of the relay (profile `relay`: `docker compose --profile relay up -d`).
FI_RELAY_BINDING_PORT=3478
FI_RELAY_PORT=5101
# Cloudflare Tunnel (profile `tunnel`: `docker compose --profile tunnel up -d`): the token of the
# tunnel you created in the Cloudflare dashboard. A secret: no default, never commit it.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- World node (the `worlds` service) -----------------------------------------------------------
# Host UDP port players reach the world engine on (FI_BIND_ADDRESS:FI_WORLDS_PORT). The FI_WORLDS
# entry below names the same port.
FI_WORLDS_PORT=5102
# The node's id, [a-z0-9-]{1,32}: FI_WORLDS' vmId.
FI_WORLDS_VM_ID=home-1
# The most worlds the node keeps open (1-32): FI_WORLDS' maxWorlds.
FI_WORLDS_MAX_WORLDS=8
# Optional catalog (Road Trip worlds and the Hardcore parts rule): FI_WORLDS_CATALOG_DIR is your
# install's media/stripped folder and FI_WORLDS_CATALOG=/catalog/gamedbRC.slt. Empty: no catalog.
FI_WORLDS_CATALOG_DIR=./gamedata
FI_WORLDS_CATALOG=

# --- Runtime -------------------------------------------------------------------------------------
# `local` keeps the self-host defaults. `prod` refuses the self-host backends below (local
# sign-in, fs blobs): leave it.
FI_ENV=local
# Log filter (error, warn, info, debug) and format: json (one object per line) or pretty.
RUST_LOG=info
LOG_FORMAT=json
# The private listener inside the container, ip:port (always on): only the play dashboard's reads
# (/internal/dashboard/v1, DASHBOARD_API.md), refused unless the caller sends X-Fi-Dashboard-Key =
# FI_DASHBOARD_KEY (a secret: keys volume only, never here; unset = every request is 401). Never
# publish this port; the compose maps only FI_HTTP_PORT.
FI_INTERNAL_BIND=0.0.0.0:8081

# --- Database ------------------------------------------------------------------------------------
# Connections per process, how long a request waits for one (ms), and the statement cap in ms
# (empty: 5 s for the API, 15 min for jobs, none for migrations).
DB_POOL_MAX=8
DB_ACQUIRE_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=

# --- Identity ------------------------------------------------------------------------------------
# `local`: the server's own e-mail and password sign-in (with FI_MAIL_BACKEND=smtp below, new
# addresses are confirmed by mail and players reset forgotten passwords by mail; the operator can
# still reset one with `fi-platform accounts reset-password`). `firebase` needs a Firebase project
# (FI_IDP_PROJECT_ID, FI_IDP_API_KEY) and is not covered by this compose.
FI_AUTH_BACKEND=local
# Accepted sign-in providers (`password`: e-mail and password).
FI_IDP_PROVIDERS=password
# The server's stable name in every launcher's state (never `forzainfinity`, the official one).
# Change it only before the first player signs in.
FI_REALM=forzainfinity-selfhost
# `false` closes sign-up and account creation (existing players keep playing).
FI_REGISTRATION_ENABLED=true
# Multiplier of the sign-in and account-creation limits per client network (/24): sign-in is 30
# exchanges per 15 minutes per network. On a LAN every player is in the same /24, so with more
# than a few players set 10; also when many players share one public address.
FI_LOCAL_LIMIT_SCALE=1
# Per-account request limits of /launcher/v1 (ACCOUNTS.md §9); 1 in production.
FI_LAUNCHER_ACCOUNT_SCALE=1
# Where a player's address (its /24 is what the limits above count) comes from. `peer`: the
# connection's address, ignoring forwarding headers anyone could forge (right on a LAN, or behind a
# reverse proxy you do not trust). `trusted-proxy`: the address the Cloudflare Tunnel reports
# (`CF-Connecting-IP`), believed only from FI_TRUSTED_PROXIES; see README "Cloudflare Tunnel".
# (`forwarded` believes X-Forwarded-For from anyone: development only.)
FI_CLIENT_ADDRESS=peer
# Networks allowed to report the player's address under trusted-proxy (comma list, a.b.c.d/n).
# Empty: compose.yml uses the tunnel container's fixed address, <FI_PINNED_PREFIX>.10/32.
FI_TRUSTED_PROXIES=
# Publish this server's launch-ticket and relay-grant public keys in /launcher/v1/info (`trust`,
# which a launcher connected to a custom server pins). The image's default; compose.yml
# turns it on for the api, so this line has no effect there.
FI_PUBLISH_TRUST_KEYS=false

# --- Mail (local sign-in) ------------------------------------------------------------------------
# `log` until you have the SMTP key: nothing is mailed, sign-ups work without a confirmation (they
# confirm once mail is on) and a forgotten password is reset by the operator. A public server
# (FI_CLIENT_ADDRESS=trusted-proxy, or an FI_PUBLIC_URL that is https or names a DNS host or a
# public IP) refuses `log` while
# FI_REGISTRATION_ENABLED=true. To turn mail on (Resend):
#   1. add FI_SMTP_PASSWORD=<the Resend API key> below (a secret: never commit .env), or write it to
#      the keys volume as FI_SMTP_PASSWORD;
#   2. set FI_MAIL_FROM to a sender on your verified domain and FI_MAIL_BACKEND=smtp;
#   3. `docker compose up -d` (FI_PUBLIC_URL must be the address players open links at).
FI_MAIL_BACKEND=log
FI_SMTP_HOST=smtp.resend.com
# 465: TLS from the start; 587: STARTTLS.
FI_SMTP_PORT=465
FI_SMTP_USER=resend
# For example: My Game <no-reply@example.org>
FI_MAIL_FROM=
# The product name in mail copy (empty: the neutral default "Game Server").
FI_MAIL_PRODUCT=
# FI_SMTP_PASSWORD=

# --- Storage -------------------------------------------------------------------------------------
# `fs`: save blobs in the `blobs` volume. (`firebase`: a Cloud Storage bucket, not covered here.)
FI_BLOB_BACKEND=fs

# --- Play ----------------------------------------------------------------------------------------
# Games served.
FI_GAMES=fh2
# Which pool each tier is admitted to.
FI_POOL_ROUTING=vip=vip,free=matchmaking
# Save lease time-to-live in ms (the launcher heartbeats every fifth of it).
FI_LEASE_TTL_MS=300000
# Game requests' liveness cache in ms (0 disables).
FI_GAME_LIVENESS_CACHE_MS=60000
# `true` ends a session idle past the thresholds when someone waits for its seat; `false` only
# records idle time.
FI_IDLE_EVICT=false
# Hardcore guardrails: `false` scores and records (shadow); `true` also refuses a score of 60+.
FI_GUARD_ENFORCE=false
# How a new Hardcore line starts: `seed` (the imported clean snapshot, `fi-platform seed-import`),
# `fresh_start` (the launcher uploads Azimuth's own first save, checked by the server), or empty:
# `fresh_start` only while the game has no active seed.
FI_HARDCORE_START=
# A new Hardcore line may start from another profile of the account (for example the
# Noob career), checked on the spot; an unusual save is refused and the profile starts fresh.
FI_HARDCORE_FROM_PROFILE=false
# Liveries: distinct bytes per account; layered designs to other players (true since the
# in-game check passed; false serves others only layerless designs).
FI_LIVERY_ACCOUNT_BYTES=26214400
FI_LIVERY_LAYERED=true
# Relay fallback: trusted relays, a JSON array of {publicKey, endpoint: "host:binding/port", name}
# (empty: fallback off). Live relayed seats per world.
FI_RELAYS=
FI_RELAY_SEATS_PER_WORLD=4
# The beholder whose relay list says which trusted relays are down (empty: no check).
FI_RELAY_DIRECTORY_URL=
# The world nodes this server trusts: a JSON array of {vmId, publicKey, endpoint, name, maxWorlds}
# (empty: none, no worlds). endpoint is this machine's LAN address and FI_WORLDS_PORT, never
# 127.0.0.1 (README "World node"). Single quotes keep the JSON as it is, for example:
# FI_WORLDS='[{"vmId":"home-1","publicKey":"<agent.started publicKey>","endpoint":"192.0.2.10:5102","name":"Home","maxWorlds":8}]'
FI_WORLDS=
# Discord bot: SHA-256 hex digests of the bot's feed keys (comma list; the key itself goes only to
# the bot), and the bot's public origin for account links. Empty: off.
FI_FEED_KEYS=
FI_DISCORD_LINK_URL=
# The fresh-start check's ceilings: the most credits, race winnings, XP, level, garage cars and
# skill tokens Azimuth's first save may hold (0: "zero for everything"; raise one only if Azimuth's
# first save changes).
FI_FRESH_START_MAX_CREDITS=0
FI_FRESH_START_MAX_WINNINGS=0
FI_FRESH_START_MAX_XP=0
FI_FRESH_START_MAX_LEVEL=0
# Cars 1: a new FH2 career already holds its intro car.
FI_FRESH_START_MAX_CARS=1
FI_FRESH_START_MAX_TOKENS=0
# Numbers Azimuth's first save may lack: `winnings` (TotalWinnings), `tokens` (the skill tokens and
# skill points). Empty: both required (the line's conservation rules measure from them).
FI_FRESH_START_ALLOW_MISSING=
# Oldest launcher and hook versions allowed, and the latest ones announced (empty: none).
FI_MIN_LAUNCHER=
FI_MIN_HOOK=
FI_LATEST_LAUNCHER=
FI_LATEST_HOOK=

# --- Launcher notices ----------------------------------------------------------------------------
# Message of the day and the support links the launcher shows (empty: none).
FI_MOTD=
FI_SUPPORT_KOFI_URL=
FI_SUPPORT_HELP_URL=
FI_SUPPORT_REPORT_URL=

# --- Beholder (a public server list launchers read) ----------------------------------------
# Set to a directory's URL (https://beholder.example.org) to list this server: the api
# announces itself every 30 s, signed by its own key (FI_ANNOUNCE_SIGNING_KEY, generated into the
# keys volume by `keys init`, never in this file). Empty: not listed. A listing is a hint only:
# launchers still check /launcher/v1/info and pin the server's keys.
FI_BEHOLDER_URL=
# The name launchers show, 1-48 characters (empty: the endpoint's host).
FI_ANNOUNCE_NAME=
# The origin listed, http(s)://host[:port] (empty: FI_PUBLIC_URL).
FI_ANNOUNCE_ENDPOINT=
# Optional region tag, 0-16 of A-Z, a-z, 0-9 and - (for example sa-east).
FI_ANNOUNCE_REGION=
# Players admitted at once as listed, 1-1000 (empty: the online capacity, else
# FI_SUPPORTER_CAPACITY + FI_FREE_CAPACITY).
FI_ANNOUNCE_CAPACITY=

# --- Web -----------------------------------------------------------------------------------------
# The web app and MCP are not part of a self-hosted server yet.
FI_WEB_ENABLED=false
FI_MCP_ENABLED=false
