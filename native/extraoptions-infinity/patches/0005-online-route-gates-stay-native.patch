+    void *session;
+    unsigned flag;
+    return memory_read_pointer(image + 0x34d6348, (void **)&manager) && manager &&
+           memory_read_pointer(manager + 0xd0, &session) && session &&
+           memory_read(manager + 0xa8, &flag, sizeof(flag)) && flag == 0;
+}
